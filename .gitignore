# Bauartefakte gehoeren nicht ins Repo — sie entstehen aus dem
# Quelltext und wuerden bei jedem Bau neue Aenderungen melden.
#
# Diese Datei liegt im Wurzelverzeichnis, obwohl die Projekte je einen
# eigenen .gitignore haben: ein `npx astro build`, das versehentlich
# eine Ebene zu hoch laeuft, legt node_modules/ und .astro/ hier ab.
# Die Unterordner fangen das nicht ab.
node_modules/
dist/
.astro/
.wix/

# Umgebungsdateien. Ein Schluessel im Repo ist ein Schluessel in jeder
# Kopie des Repos — auch in denen, die man nicht mehr einsammeln kann.
.env
.env.*
!.env.example

# Ergebnis von `npm run eine-datei` — 4 MB, entsteht aus dist/.
website/pnkt-me.html

# Der nach WebAssembly uebersetzte Kern. Entsteht aus pnkt/ mit
# website/skripte/wasm-bauen.sh und waere sonst eine 3,4-MB-Binaerdatei
# im Verlauf, die sich bei jedem Bau aendert.
website/public/wasm/

.DS_Store
*.log

# Der Wix-Bau legt seinen Zwischenstand hier ab.
punkt/.wix/
