{
  "name": "youbooth-booth",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "youbooth — Fotobox-Software: Booth, Cockpit, Portal und Box-Server",
  "author": {
    "name": "youbooth",
    "email": "hallo@youbooth.me"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/server.js",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4400",
    "huelle": "npm run build && electron .",
    "paket": "npm run build && electron-builder",
    "paket:windows": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "express": "^4.22.2",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^8.2.1"
  },
  "main": "huelle/haupt.cjs",
  "build": {
    "appId": "me.youbooth.booth",
    "productName": "youbooth",
    "copyright": "youbooth",
    "directories": {
      "output": "paket",
      "buildResources": "huelle/mittel"
    },
    "files": [
      "huelle/**/*",
      "server/**/*",
      "dist/**/*",
      "formate.json",
      "vorlagen-katalog.json",
      "package.json"
    ],
    "extraMetadata": {
      "main": "huelle/haupt.cjs"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tim-rose-hnvr",
        "repo": "hnvr-me",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "icon": "huelle/mittel/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "youbooth"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.photography",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "huelle/mittel/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "artifactName": "${productName}-${version}.${ext}",
      "executableName": "youbooth",
      "icon": "huelle/mittel/icon.png"
    },
    "asar": false
  }
}
