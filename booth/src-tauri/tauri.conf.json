{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "youbooth",
  "version": "0.1.0",
  "identifier": "me.youbooth.booth",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4400",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "youbooth",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "youbooth",
    "shortDescription": "Fotobox-Software",
    "longDescription": "youbooth — Booth, Druck und Cockpit für Fotobox-Vermieter. Läuft offline."
  }
}
