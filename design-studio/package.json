{
  "name": "design-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "spike": "node --test apps/spike-pdf/spike.test.mjs",
    "spike:druck": "pnpm --filter @studio/spike-druck test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
