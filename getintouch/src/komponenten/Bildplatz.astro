---
/**
 * Ein Bildplatz aus dem Handoff.
 *
 * Im Prototyp ist das ein `<image-slot>`, in das die Designumgebung ein Bild
 * ziehen lässt. Im Produkt ist es entweder ein echtes Bild oder — solange
 * keines da ist — ein Rahmen, der sagt, was hingehört. Der Handoff hält
 * ausdrücklich fest: „Fotos sind Platzhalter. Echtes Bildmaterial fehlt und
 * muss vom Kunden kommen."
 *
 * Deshalb steht der Platz sichtbar da und tut nicht so, als wäre er ein Bild.
 */
import { lucide } from '../kern/lucide.ts';

interface Props {
  /** Was auf diesen Platz gehört. */
  text: string;
  /** Eckenradius in Pixeln, wie im Prototyp je Stelle angegeben. */
  radius?: number;
  /** Höhe in Pixeln. Ohne Angabe füllt der Platz seinen Behälter. */
  hoehe?: number;
  /** Liegt schon ein Bild vor, wird es statt des Rahmens gezeigt. */
  bild?: string;
}

const { text, radius = 18, hoehe, bild } = Astro.props;
const stil = [`border-radius:${radius}px`, hoehe ? `height:${hoehe}px` : null].filter(Boolean).join(';');
---

{
  bild ? (
    <img src={bild} alt={text} class="bildplatz" style={stil} />
  ) : (
    <span class="bildplatz" style={stil}>
      <Fragment set:html={lucide('image', 26)} />
      <span>{text}</span>
    </span>
  )
}
