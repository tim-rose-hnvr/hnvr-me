---
/**
 * Der Rahmen der sechs Handoff-Seiten.
 *
 * Kopfzeile und Fuß aus `doku/handoff/design/Website-*.dc.html`: Lockup mit
 * dem Markenplättchen, Navigation `Vorlagen · Karte & NFC · Für Teams ·
 * Preise`, rechts „Anmelden" als Textlink und der dunkle Pillenknopf
 * „Seite bauen".
 *
 * Das Zeichen wird gezeichnet, nicht geladen: es gibt keine öffentliche
 * Adresse, unter der sich Logo oder Symbole abholen ließen.
 *
 * Der Fuß hat zwei Fassungen. Die Startseite bekommt den vierspaltigen mit
 * Rubriken, alle übrigen die schmale Zeile mit den anderen fünf Seiten —
 * genau so verteilt es der Prototyp.
 */
import { MARKE, zeichenPlaettchen } from '../kern/marke.ts';
import { startbildschirmSymbol } from '../kern/zeichenbilder.ts';
import '../stile/handoff.css';

interface Props {
  titel: string;
  beschreibung: string;
  /** Pfad der aktuellen Seite, für die aktive Markierung in der Navigation. */
  hier?: string;
  /** Vierspaltiger Fuß mit Rubriken. Im Handoff nur auf der Startseite. */
  breiterFuss?: boolean;
}

const { titel, beschreibung, hier, breiterFuss } = Astro.props;

/* Das Symbol im Browsertab ist dasselbe gezeichnete Zeichen, nur als
   Datenadresse — auch dafür liegt keine Datei im Netz. */
const symbolAdresse = `data:image/svg+xml,${encodeURIComponent(zeichenPlaettchen())}`;
const startbild = startbildschirmSymbol();

const NAVI = [
  { name: 'Vorlagen', ziel: '/vorlagen' },
  { name: 'Karte & NFC', ziel: '/karte' },
  { name: 'Für Teams', ziel: '/teams' },
  { name: 'Preise', ziel: '/preise' },
];

/* Der schmale Fuß führt „Start" und alle Seiten außer der eigenen. */
const fussnavi = [{ name: 'Start', ziel: '/' }, ...NAVI].filter((n) => n.ziel !== hier);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <meta name="theme-color" content="#f3f2f2" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={symbolAdresse} type="image/svg+xml" />
    {startbild && <link rel="apple-touch-icon" href={startbild} />}
    <link rel="stylesheet" href="/schriften/schriften.css" />
    {/* Ohne Skript darf nichts unsichtbar bleiben — das Einblenden ist Zugabe. */}
    <noscript><style>[data-auf]{opacity:1;transform:none}</style></noscript>
  </head>

  <body>
    <div class="bahn">
      <header class="kopf">
        <a class="lockup" href="/">
          <Fragment set:html={zeichenPlaettchen()} />
          <span>{MARKE.name}</span>
        </a>
        <nav class="navi">
          {NAVI.map((n) => <a href={n.ziel} aria-current={n.ziel === hier ? 'page' : undefined}>{n.name}</a>)}
        </nav>
        <div class="schub"></div>
        <a class="anmelden" href="/eingang">Anmelden</a>
        <a class="kopfknopf" href="/werkstatt">Seite bauen</a>
      </header>

      <slot />

      {
        breiterFuss ? (
          <footer class="fuss fuss--breit">
            <div>
              <span class="lockup lockup--fuss">
                <Fragment set:html={zeichenPlaettchen()} />
                <span>{MARKE.name}</span>
              </span>
              <p class="fusssatz">{MARKE.anspruch}</p>
            </div>
            <div class="fussspalte">
              <div class="fusstitel">Produkt</div>
              <a href="/vorlagen">Vorlagen</a>
              <a href="/karte">Karte &amp; NFC</a>
              <a href="/preise">Preise</a>
              <a href="/teams">Whitelabel</a>
            </div>
            <div class="fussspalte">
              <div class="fusstitel">Firma</div>
              <a href="/teams">Für Teams</a>
              <a href={`mailto:${MARKE.postfach}`}>Kontakt</a>
            </div>
            <div class="fussspalte">
              <div class="fusstitel">Rechtliches</div>
              <a href="https://hnvr.me/datenschutz" target="_blank" rel="noopener noreferrer">
                Datenschutz
              </a>
              <a href="https://hnvr.me/impressum" target="_blank" rel="noopener noreferrer">
                Impressum
              </a>
              <span class="leise">© {new Date().getFullYear()} viel Liebe Media UG</span>
            </div>
          </footer>
        ) : (
          <footer class="fuss">
            <span class="lockup lockup--fuss">
              <Fragment set:html={zeichenPlaettchen()} />
              <span>{MARKE.name}</span>
            </span>
            <div class="schub" />
            {fussnavi.map((n) => (
              <a href={n.ziel}>{n.name}</a>
            ))}
            <a href="https://hnvr.me/impressum" target="_blank" rel="noopener noreferrer">
              Impressum
            </a>
          </footer>
        )
      }
    </div>

    {/* Die Belebung ist Zugabe: ohne sie steht jede Seite vollständig da. */}
    <script>
      import '../skripte/belebung.ts';
    </script>
  </body>
</html>
