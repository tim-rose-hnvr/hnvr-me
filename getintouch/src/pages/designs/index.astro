---
/**
 * Umleitung von `/designs` auf `/vorlagen`.
 *
 * Die Galerie hieß bis zum Nachbau des Handoffs „Designs". Der Handoff nennt
 * sie „Vorlagen", und die Navigation folgt ihm. Die alte Adresse steht in
 * gedruckten QR-Codes nicht, aber im Verzeichnis und in fremden Lesezeichen —
 * deshalb 301 statt 404.
 */
export const prerender = false;

export function GET() {
  return new Response(null, { status: 301, headers: { location: '/vorlagen' } });
}
