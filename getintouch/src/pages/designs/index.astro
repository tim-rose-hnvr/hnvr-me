---
/**
 * Die Vorlagen-Galerie.
 *
 * Aufbau aus dem Design-Handoff, Seite „Vorlagen": Kopf, Filterleiste nach
 * Fach, Gitter aus echten Miniaturen, zwei Erklärkarten, rotes Abschlussband.
 *
 * Jede Kachel ist kein Farbmuster, sondern ein verkleinertes echtes Blatt:
 * Kopfzeile, Statuszeile, Hauptaktion, Kachelgitter — mit den Variablen der
 * jeweiligen Vorlage. Wer eine Vorlage anhand von drei Farbpunkten aussucht,
 * wählt blind; erst die Schriftmischung und die Form der Schaltflächen machen
 * den Unterschied aus.
 *
 * Ein Klick führt auf `/designs/<kennung>`, wo dieselbe Vorlage an einem
 * vollständigen Profil läuft.
 */
import Marketingrahmen from '../../komponenten/Marketingrahmen.astro';
import {
  AUFBAUTEN,
  cssVariablen,
  schrift,
  vorlagenart,
  vorlagenfaecher,
  vorlagenName,
  VORLAGEN,
} from '../../kern/gestaltung.ts';
import { zeichen } from '../../kern/zeichen.ts';
import { MARKE } from '../../kern/marke.ts';
import '../../stile/marketing.css';
import '../../stile/galerie.css';

/**
 * Vom Server, nicht vorgebaut.
 *
 * Eine vorgebaute Unterseite landet als `designs/index.html` im Bündel, und die
 * Auslieferung von Wix beantwortet `/designs` dann mit 404 — nur die
 * Startseite bekommt diese Behandlung geschenkt. Der Aufbau kostet hier
 * nichts: die Galerie liest elf Vorlagen aus dem Kern, keine Datenbank.
 * Gegen die Last hilft der Zwischenspeicher weiter unten.
 */
export const prerender = false;

Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=3600, stale-while-revalidate=86400');

const aufbauName = (k: string) => AUFBAUTEN.find((a) => a.kennung === k)?.name ?? k;

const titel = `Elf Designs — ${MARKE.name}`;
const beschreibung =
  'Drei echte Anordnungen — Liste, Bento-Gitter, Titelbild — in elf Vorlagen, jede mit eigenem Schriftpaar ' +
  'und geprüftem Kontrast. Dazu freie Farben, Eckenradius, Stil der Schaltflächen und ein Hintergrundbild.';

const faecher = vorlagenfaecher();

const stellschrauben = [
  { titel: 'Farben', text: 'Grundfarbe, zweite Farbe für den Verlauf samt Winkel, Textfarbe, Akzent und die Schrift auf dem Akzent — alles frei.' },
  { titel: 'Schrift', text: 'Dreizehn Familien, je eine für Überschriften und eine für Fließtext. Selbst ausgeliefert, kein Google-Aufruf.' },
  { titel: 'Anordnung', text: 'Liste, Bento-Gitter oder Titelbild — dieselben Bausteine, drei verschiedene Seiten. Frei wählbar, unabhängig von Farbe und Schrift.' },
  { titel: 'Form', text: 'Eckenradius stufenlos von scharfkantig bis rund, Schaltflächen gefüllt, als Kontur oder als Glas, Profilbild rund oder als Karte.' },
  { titel: 'Hintergrundbild', text: 'Eigenes Foto mit einstellbarem Schleier. Unter der Hälfte meldet sich der Wächter: über einem hellen Himmel ist kein Text mehr lesbar.' },
];
---

<Marketingrahmen titel={titel} beschreibung={beschreibung} hier="/designs">
  <section class="kopf">
    <p class="marke">gestaltung</p>
    <h1>Elf Designs,<br />kein einziges geraten.</h1>
    <p class="fuehrung">
      Drei Anordnungen, nicht elf Anstriche derselben: eine ruhige Liste, ein Gitter aus Karten und ein Titelbild,
      auf dem der Name liegt. Dazu je ein eigenes Schriftpaar. Und jede ist gegen WCAG durchgerechnet — was nicht
      lesbar wäre, steht hier nicht zur Wahl.
    </p>
  </section>

  <section>
    {/*
      Die Filterleiste ist eine Zugabe und darf keine Voraussetzung sein: ohne
      Skript stehen alle elf Vorlagen da, und dann wären Knöpfe, die nichts
      tun, schlimmer als keine Knöpfe. Deshalb ist sie bis zum Skriptstart
      versteckt.
    */}
    <div class="filter" id="filter" hidden>
      <button class="filter__pille filter__pille--hier" type="button" data-fach="">Alle {VORLAGEN.length}</button>
      {faecher.map((f) => <button class="filter__pille" type="button" data-fach={f}>{f}</button>)}
    </div>

    <div class="galerie" id="galerie">
      {
        VORLAGEN.map((v) => {
          const stil = Object.entries(cssVariablen(v))
            .map(([name, wert]) => `${name}:${wert}`)
            .join(';');
          const art = vorlagenart(v.vorlage);
          return (
            <a class="probe" href={`/designs/${v.vorlage}`} data-fach={art.fach}>
              {/* Die Variablen gelten nur innerhalb des Blattes — der Fuß
                  der Kachel bleibt im Design der Galerie, sonst stünde
                  heller Text auf hellem Grund. */}
              <span class="probe__blatt" style={stil}>
                <span class="probe__bild" />
                <span class="probe__name">{vorlagenName(v.vorlage)}</span>
                <span class="probe__rolle">Digitalagentur · Hannover</span>
                <span class="probe__status">
                  <span class="probe__punkt" />
                  Jetzt erreichbar
                </span>
                <span class="probe__haupt">
                  <Fragment set:html={zeichen('telefon')} />
                  Jetzt anrufen
                </span>
                <span class="probe__gitter">
                  <span class="probe__kachel" />
                  <span class="probe__kachel" />
                  <span class="probe__kachel" />
                </span>
                <span class="probe__zeile" />
                <span class="probe__zeile" />
              </span>
              <span class="probe__fuss">
                <b>{vorlagenName(v.vorlage)}</b>
                <span class="probe__charakter">{art.charakter}</span>
                <span>{aufbauName(v.aufbau)} · {schrift(v.anzeige).name} + {schrift(v.schrift).name}</span>
              </span>
            </a>
          );
        })
      }
    </div>
    <p class="filter__leer" id="filterLeer" hidden>Für dieses Fach gibt es noch keine Vorlage.</p>
  </section>

  <section>
    <p class="marke">und dann frei</p>
    <h2>Vorlagen sind ein Anfang,<br />kein Gefängnis.</h2>
    <div class="merkmale">
      {
        stellschrauben.map((s) => (
          <div class="merkmal">
            <h3>{s.titel}</h3>
            <p>{s.text}</p>
          </div>
        ))
      }
    </div>
    <p class="quelle">
      Alles davon lässt sich in der <a href="/werkstatt">Werkstatt</a> einstellen — mit der echten Seite als
      Vorschau. Der Kontrastwächter rechnet dabei jede freie Farbwahl nach WCAG 2.1 nach und meldet in Worten, was
      nicht mehr trägt, nicht in Zahlen, die niemandem weiterhelfen. Das Fach neben jeder Vorlage ist ein Vorschlag,
      keine Schranke: eine Praxis darf Nachtschicht nehmen.
    </p>
  </section>

  <section class="banner">
    <p class="marke">bereit?</p>
    <h2>Welche soll es<br />sein?</h2>
    <div class="knopfreihe">
      <a class="knopf knopf--hell" href="/werkstatt">
        In der Werkstatt anpassen
        <Fragment set:html={zeichen('pfeil')} />
      </a>
      <a class="knopf knopf--kontur" href={`mailto:${MARKE.postfach}?subject=Get%20in%20Touch%20%E2%80%94%20Seite%20anlegen`}>
        Seite anfragen
      </a>
    </div>
  </section>
</Marketingrahmen>

<script>
  /*
   * Filtern ohne Nachladen. Elf Kacheln stehen ohnehin schon im Dokument —
   * ein Serveraufruf je Fach wäre reine Verschwendung.
   */
  const leiste = document.getElementById('filter');
  const galerie = document.getElementById('galerie');
  const leer = document.getElementById('filterLeer');

  if (leiste && galerie && leer) {
    leiste.hidden = false;
    const kacheln = Array.from(galerie.querySelectorAll<HTMLElement>('.probe'));

    leiste.addEventListener('click', (e) => {
      const knopf = (e.target as HTMLElement).closest<HTMLElement>('.filter__pille');
      if (!knopf) return;

      const fach = knopf.dataset.fach ?? '';
      for (const p of leiste.querySelectorAll('.filter__pille')) {
        p.classList.toggle('filter__pille--hier', p === knopf);
      }

      let sichtbar = 0;
      for (const k of kacheln) {
        const passt = fach === '' || k.dataset.fach === fach;
        k.hidden = !passt;
        if (passt) sichtbar++;
      }
      leer.hidden = sichtbar > 0;
    });
  }
</script>
