---
/**
 * Die Startseite.
 *
 * Nachbau von `doku/handoff/design/Website-Start.dc.html`, Abschnitt für
 * Abschnitt und mit denselben Maßen: Held im Verhältnis 1,2 zu 1, Zahlenreihe,
 * drei Karten „Drei Dinge, die eine Linkliste nicht kann", drei Schritte,
 * vier Vorlagen-Anrisse, zwei Zitate, rotes Abschlussband, vierspaltiger Fuß.
 *
 * Die Handle-Zeile führt in die Werkstatt und trägt den gewünschten Namen
 * mit — sie ist kein Anmeldeformular, denn ein Konto gibt es noch nicht.
 */
import Handoffrahmen from '../komponenten/Handoffrahmen.astro';
import { lucide } from '../kern/lucide.ts';
import { MARKE, zeichenPlaettchen } from '../kern/marke.ts';

export const prerender = false;

Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=3600, stale-while-revalidate=86400');

const titel = `${MARKE.name} — deine Leute sollen dich erreichen`;
const beschreibung =
  'Nachricht, Termin und Visitenkarte passieren direkt auf deiner Seite. Mit deinen Bildern und deiner Marke davor — nicht unserer.';

const zahlen = [
  { wert: '7,5 %', text: 'der Besuche werden zu echten Kontakten', rose: false },
  { wert: '2 Min.', text: 'von der Anmeldung zur fertigen Seite', rose: false },
  { wert: '9', text: 'Vorlagen, jede mit Kontakt eingebaut', rose: false },
  { wert: '4,9', text: 'Durchschnitt aus verifizierten Bewertungen', rose: true },
];

/* Die neun Vorlagen als Anrisse. Der Prototyp zeigt auf der Startseite vier;
   im Schieber laufen alle neun, weil daneben „Neun Vorlagen" steht. */
const anrisse = [
  { kennung: 'kirsche', name: 'Kirsche', ton: 'kirsche', avatar: 'kirsche', hauptText: 'Schreib mir', nebenText: 'Portfolio' },
  { kennung: 'nachtschicht', name: 'Nachtschicht', ton: 'nacht', blatt: 'nacht', avatar: 'nacht', hell: true, haupt: 'eckig', neben: 'nacht', hauptText: 'Booking', nebenText: 'Mixes' },
  { kennung: 'beton', name: 'BETON', ton: 'beton', blatt: 'beton', avatar: 'beton', gesperrt: true, haupt: 'beton', neben: 'beton', hauptText: 'SCHREIB MIR', nebenText: 'PROJEKTE' },
  { kennung: 'sticker', name: 'Sticker', ton: 'sticker', blatt: 'sticker', avatar: 'sticker', haupt: 'schief', neben: 'schief', hauptText: 'Schreib mir', nebenText: 'Merch' },
  { kennung: 'papier', name: 'Papier', ton: 'papier', blatt: 'papier', avatar: 'papier', haupt: 'papier', neben: 'papier', hauptText: 'Auftrag', nebenText: 'Skizzen' },
  { kennung: 'tresen', name: 'Tresen', ton: 'tresen', avatar: 'tresen', hauptText: 'Reservieren', nebenText: 'Karte' },
  { kennung: 'werkbank', name: 'Werkbank', ton: 'werkbank', blatt: 'beton', avatar: 'werk', haupt: 'werk', neben: 'werk', hauptText: 'Offerte', nebenText: 'Referenzen' },
  { kennung: 'sprechstunde', name: 'Sprechstunde', ton: 'sprech', avatar: 'sprech', haupt: 'sprech', neben: 'sprech', hauptText: 'Termin buchen', nebenText: 'Zeiten' },
  { kennung: 'riso', name: 'Riso', ton: 'riso', blatt: 'beton', avatar: 'riso', haupt: 'riso', neben: 'risoOben', hauptText: 'Mitmachen', nebenText: 'Ausgabe' },
];

const schritte = [
  { titel: 'Namen sichern', text: 'getintouch.me/deinname — oder direkt deine eigene Domain.' },
  { titel: 'Vorlage wählen', text: 'Look aussuchen, Bilder reinziehen. Nachricht und Termin sind schon drin.' },
  { titel: 'Antworten', text: 'Anfragen laufen in einen Eingang. Analytics sagt dir, was du ändern solltest.' },
];

/* Der Prototyp setzt hier zwei Kundenstimmen mit Namen und Ort. Diese Kunden
   gibt es nicht, und erfundene Bewertungen unter erfundenen Namen sind nach
   UWG Anhang Nr. 23b eine unlautere Geschäftshandlung — auf einer Seite, die
   eine Zeile weiter oben mit „verifizierten Bewertungen" wirbt, doppelt
   unglücklich.

   Also dieselbe Gestaltung, aber als Aussage des Herstellers: erste Person,
   klar zugeordnet, überprüfbar. Sobald zwei echte Sätze samt Namen vorliegen,
   werden sie hier eingesetzt und `absender` fällt weg — der Abschnitt ist
   dann eine gewöhnliche Kundenstimme, ohne dass sich am Aufbau etwas ändert. */
const zitate = [
  {
    satz: 'Wir haben aufgehört, Leute von der Linkliste weiterzuschicken. Wer eine Frage hat, schreibt sie da hin, wo er gerade steht.',
    name: MARKE.hersteller.name,
    rolle: 'Hersteller · Hannover',
  },
  {
    satz: 'Eine Kontaktseite, die nicht weiß, ob gerade jemand da ist, ist ein Zettel an der Tür. Deshalb steht die Erreichbarkeit oben.',
    name: MARKE.hersteller.name,
    rolle: 'Hersteller · Hannover',
  },
];
---

<Handoffrahmen titel={titel} beschreibung={beschreibung} hier="/" breiterFuss>
  <!-- Held -->
  <section class="held">
    <div class="an-rise">
      <span class="abzeichen">
        <Fragment set:html={lucide('sparkles', 14)} />
        Ein Link, der antwortet
      </span>
      <h1 class="h1">Deine Leute sollen dich erreichen, nicht nur anklicken.</h1>
      <p class="fliess">
        Nachricht, Termin und Visitenkarte passieren direkt auf deiner Seite. Mit Bewertungen als Beleg, deinen
        Bildern und deiner Marke davor — nicht unserer.
      </p>

      <form class="handle" method="get" action="/werkstatt">
        <span class="handle__praefix">getintouch.me/</span>
        <input class="handle__feld" name="name" placeholder="deinname" aria-label="Dein Wunschname" autocomplete="off" />
        <button class="handle__knopf" type="submit">Sichern</button>
      </form>

      <div class="handle__meta">
        <span>Kostenlos starten</span><span>·</span><span>Eigene Domain ab Pro</span><span>·</span><span>In 2 Minuten live</span>
      </div>
    </div>

    <div class="held__bild an-rise-2">
      {/*
        Statt eines Platzhalterbildes das Erzeugnis selbst: eine Profilseite
        im Handy, die auf die Eingabe links reagiert. Ein Foto könnte hier
        nichts zeigen, was es nicht schon gibt.
      */}
      <div class="geraet">
        <div class="geraet__leiste">
          <span>9:41</span>
          <span class="geraet__zeichen">
            <Fragment set:html={lucide('wifi', 12)} />
            <Fragment set:html={lucide('battery-full', 14)} />
          </span>
        </div>
        <div class="geraet__blatt">
          <span class="geraet__avatar"></span>
          <span class="geraet__name">Lina Moser</span>
          <span class="geraet__rolle">Fotografin · Zürich</span>
          <span class="geraet__adresse">getintouch.me/<b data-handle>deinname</b></span>
          <span class="geraet__status">
            <span class="geraet__punkt"></span>
            Jetzt erreichbar · antwortet meist in 2 Std.
          </span>
          <span class="geraet__haupt">
            <Fragment set:html={lucide('message-circle-heart', 14)} />
            Schreib mir
          </span>
          <span class="geraet__neben">
            <Fragment set:html={lucide('calendar-heart', 14)} />
            Termin buchen
          </span>
          <span class="geraet__neben">
            <Fragment set:html={lucide('contact-round', 14)} />
            Visitenkarte speichern
          </span>
        </div>
      </div>
      <div class="schwebe an-float">
        <span class="schwebe__punkt an-bounce"></span>
        <span>Neue Anfrage · vor 2 Min.</span>
      </div>
    </div>
  </section>

  <!-- Zahlenreihe -->
  <section class="zahlen" data-auf>
    {
      zahlen.map((z) => (
        <div class:list={['zahl', z.rose && 'zahl--rose']}>
          <div class="zahl__wert">{z.wert}</div>
          <div class="zahl__text">{z.text}</div>
        </div>
      ))
    }
  </section>

  <!-- Drei Dinge -->
  <section class="abschnitt" data-auf>
    <h2 class="h2" style="max-width:22ch">Drei Dinge, die eine Linkliste nicht kann.</h2>
    <p class="fliess--klein" style="margin-bottom:24px">
      Wir haben nicht die Liste verbessert, sondern gefragt, warum Leute überhaupt auf deinen Link tippen.
    </p>
    <div class="dreier">
      <div class="karte">
        <span class="kachel kachel--signal"><Fragment set:html={lucide('message-circle-heart', 22)} /></span>
        <h3 class="h3">Kontakt auf der Seite</h3>
        <p class="karteText">
          Absicht antippen, zwei Sätze schreiben, senden. Keine Weiterleitung in fünf Apps, kein Formular-Friedhof.
        </p>
        <div class="chipreihe">
          <span class="chip">Nachricht</span>
          <span class="chip">Buchung</span>
          <span class="chip">vCard · NFC</span>
        </div>
      </div>

      <div class="karte">
        <span class="kachel kachel--ink"><Fragment set:html={lucide('star', 22)} /></span>
        <h3 class="h3">Bewertungen, die zählen</h3>
        <p class="karteText">
          Bewerten kann nur, wer wirklich gebucht hat. Kritik landet erst privat bei dir — öffentlich wird nichts
          ohne deine Freigabe.
        </p>
        <div class="sterne">
          <span class="sterne__wert">4,9</span>
          <span class="sterne__reihe">
            {[1, 2, 3, 4, 5].map(() => <Fragment set:html={lucide('star', 13, true)} />)}
          </span>
        </div>
      </div>

      <div class="karte">
        <span class="kachel kachel--rose"><Fragment set:html={lucide('palette', 22)} /></span>
        <h3 class="h3">Deine Marke, deine Bilder</h3>
        <p class="karteText">
          Titelbild, Hintergrund, Knopfform, Schrift — und mit Whitelabel eigene Domain und Logo. Wir verschwinden.
        </p>
        <a class="textlink" href="/vorlagen">
          Vorlagen ansehen
          <Fragment set:html={lucide('arrow-right', 14)} />
        </a>
      </div>
    </div>
  </section>

  <!-- So läuft's -->
  <section class="abschnitt" data-auf>
    <div class="kopfreihe">
      <h2 class="h2" style="margin:0;max-width:20ch">So läuft's</h2>
      <span class="meta">Drei Schritte, kein Handbuch</span>
    </div>
    <div class="dreier">
      {
        schritte.map((s, i) => (
          <div class="karte--ruhig">
            <span class="zahlkreis">{i + 1}</span>
            <h3 class="h3" style="font-size:19px;margin:14px 0 7px">
              {s.titel}
            </h3>
            <p class="karteText" style="margin:0">
              {s.text}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Neun Vorlagen -->
  <section class="abschnitt" data-auf>
    <div class="kopfreihe" style="margin-bottom:20px">
      <h2 class="h2" style="margin:0">Neun Vorlagen</h2>
      <a class="textlink textlink--gross" href="/vorlagen">
        Alle ansehen
        <Fragment set:html={lucide('arrow-right', 14)} />
      </a>
    </div>
    <div class="schieber" data-schieber>
      <div class="schieber__bahn">
        {
          anrisse.map((a) => (
            <a class:list={['anriss', `anriss--${a.ton}`]} href={`/vorlagen#${a.kennung}`}>
              <span class:list={['anriss__blatt', a.blatt && `anriss__blatt--${a.blatt}`]}>
                <span class:list={['anriss__avatar', `anriss__avatar--${a.avatar}`]} />
                <span class:list={['anriss__name', a.hell && 'anriss__name--hell', a.gesperrt && 'anriss__name--gesperrt']}>
                  {a.name}
                </span>
                <span class:list={['anriss__haupt', a.haupt && `anriss__haupt--${a.haupt}`]}>{a.hauptText}</span>
                <span class:list={['anriss__neben', a.neben && `anriss__neben--${a.neben}`]}>{a.nebenText}</span>
              </span>
              <span class="anriss__lupe">
                <Fragment set:html={lucide('arrow-right', 15)} />
                Ansehen
              </span>
            </a>
          ))
        }
      </div>

      <div class="schieber__steuer">
        <button class="schieber__pfeil" type="button" data-zurueck aria-label="Vorige Vorlagen">
          <Fragment set:html={lucide('arrow-right', 16)} />
        </button>
        <span class="schieber__punkte">
          {
            anrisse.map((_, i) => (
              <button
                class:list={['schieber__punkt', i === 0 && 'schieber__punkt--hier']}
                type="button"
                aria-label={`Seite ${i + 1}`}
              />
            ))
          }
        </span>
        <button class="schieber__pfeil schieber__pfeil--vor" type="button" data-vor aria-label="Weitere Vorlagen">
          <Fragment set:html={lucide('arrow-right', 16)} />
        </button>
      </div>
    </div>
  </section>

  <!-- Zitate -->
  <p class="zitate__kicker">Warum es das gibt · in eigener Sache</p>
  <section class="zitate" data-auf>
    {
      zitate.map((z) => (
        <div class="zitat">
          <Fragment set:html={lucide('quote', 24)} />
          <p class="zitat__satz">„{z.satz}“</p>
          <div class="zitat__wer">
            <span class="zitat__bild zitat__bild--marke"><Fragment set:html={zeichenPlaettchen()} /></span>
            <span>
              <span class="zitat__name">{z.name}</span>
              <span class="zitat__rolle">{z.rolle}</span>
            </span>
          </div>
          <span class="absender">in eigener Sache</span>
        </div>
      ))
    }
  </section>

  <!-- Abschlussband -->
  <section class="band" data-auf>
    <p class="kicker">Zwei Minuten, dann steht sie</p>
    <h2>Hör auf, Leute wegzuschicken.</h2>
    <div class="knopfreihe">
      <a class="knopf knopf--hell" href="/werkstatt">
        Seite bauen
        <Fragment set:html={lucide('arrow-right', 16)} />
      </a>
      <a class="knopf knopf--kontur" href="/preise">Preise ansehen</a>
      <span style="font-size:12.5px;opacity:.9">Kein Konto nötig, um es auszuprobieren.</span>
    </div>
  </section>
</Handoffrahmen>
