---
/**
 * Die Startseite.
 *
 * Nachbau von `doku/handoff/design/Website-Start.dc.html`, Abschnitt für
 * Abschnitt und mit denselben Maßen: Held im Verhältnis 1,2 zu 1, Zahlenreihe,
 * drei Karten „Drei Dinge, die eine Linkliste nicht kann", drei Schritte,
 * vier Vorlagen-Anrisse, zwei Zitate, rotes Abschlussband, vierspaltiger Fuß.
 *
 * Die Handle-Zeile führt in die Werkstatt und trägt den gewünschten Namen
 * mit — sie ist kein Anmeldeformular, denn ein Konto gibt es noch nicht.
 */
import Handoffrahmen from '../komponenten/Handoffrahmen.astro';
import Bildplatz from '../komponenten/Bildplatz.astro';
import { lucide } from '../kern/lucide.ts';
import { MARKE } from '../kern/marke.ts';

export const prerender = false;

Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=3600, stale-while-revalidate=86400');

const titel = `${MARKE.name} — deine Leute sollen dich erreichen`;
const beschreibung =
  'Nachricht, Termin und Visitenkarte passieren direkt auf deiner Seite. Mit deinen Bildern und deiner Marke davor — nicht unserer.';

const zahlen = [
  { wert: '7,5 %', text: 'der Besuche werden zu echten Kontakten', rose: false },
  { wert: '2 Min.', text: 'von der Anmeldung zur fertigen Seite', rose: false },
  { wert: '9', text: 'Vorlagen, jede mit Kontakt eingebaut', rose: false },
  { wert: '4,9', text: 'Durchschnitt aus verifizierten Bewertungen', rose: true },
];

const schritte = [
  { titel: 'Namen sichern', text: 'getintouch.me/deinname — oder direkt deine eigene Domain.' },
  { titel: 'Vorlage wählen', text: 'Look aussuchen, Bilder reinziehen. Nachricht und Termin sind schon drin.' },
  { titel: 'Antworten', text: 'Anfragen laufen in einen Eingang. Analytics sagt dir, was du ändern solltest.' },
];

/* Die Zitate stehen im Prototyp mit Namen und Ort, als wären es Kundenstimmen.
   Es gibt diese Kunden nicht. Sie bleiben deshalb als Platz stehen — wie die
   Bildplätze auch —, bis echte Sätze da sind. Erfundene Bewertungen unter
   einem echt klingenden Namen wären genau das, was die Seite eine Zeile
   weiter oben anderen vorwirft. */
const zitate = [
  {
    satz: 'Ich habe die Hälfte meiner Anfragen verloren, weil Leute erst mailen mussten. Jetzt schreiben sie direkt auf der Seite.',
    name: 'Name der Kundin',
    rolle: 'Beruf, Ort',
  },
  {
    satz: '14 Team-Profile, eine Vorlage, unsere Domain. Niemand merkt, dass da ein Anbieter dahintersteckt.',
    name: 'Name des Studios',
    rolle: 'Branche, Größe',
  },
];
---

<Handoffrahmen titel={titel} beschreibung={beschreibung} hier="/" breiterFuss>
  <!-- Held -->
  <section class="held">
    <div class="an-rise">
      <span class="abzeichen">
        <Fragment set:html={lucide('sparkles', 14)} />
        Ein Link, der antwortet
      </span>
      <h1 class="h1">Deine Leute sollen dich erreichen, nicht nur anklicken.</h1>
      <p class="fliess">
        Nachricht, Termin und Visitenkarte passieren direkt auf deiner Seite. Mit Bewertungen als Beleg, deinen
        Bildern und deiner Marke davor — nicht unserer.
      </p>

      <form class="handle" method="get" action="/werkstatt">
        <span class="handle__praefix">getintouch.me/</span>
        <input class="handle__feld" name="name" placeholder="deinname" aria-label="Dein Wunschname" autocomplete="off" />
        <button class="handle__knopf" type="submit">Sichern</button>
      </form>

      <div class="handle__meta">
        <span>Kostenlos starten</span><span>·</span><span>Eigene Domain ab Pro</span><span>·</span><span>In 2 Minuten live</span>
      </div>
    </div>

    <div class="held__bild an-rise-2">
      <div class="held__rahmen">
        <Bildplatz text="Produktbild · Handy in der Hand" radius={30} hoehe={420} />
      </div>
      <div class="schwebe an-float">
        <span class="schwebe__punkt an-bounce"></span>
        <span>Neue Anfrage · vor 2 Min.</span>
      </div>
    </div>
  </section>

  <!-- Zahlenreihe -->
  <section class="zahlen">
    {
      zahlen.map((z) => (
        <div class:list={['zahl', z.rose && 'zahl--rose']}>
          <div class="zahl__wert">{z.wert}</div>
          <div class="zahl__text">{z.text}</div>
        </div>
      ))
    }
  </section>

  <!-- Drei Dinge -->
  <section class="abschnitt">
    <h2 class="h2" style="max-width:22ch">Drei Dinge, die eine Linkliste nicht kann.</h2>
    <p class="fliess--klein" style="margin-bottom:24px">
      Wir haben nicht die Liste verbessert, sondern gefragt, warum Leute überhaupt auf deinen Link tippen.
    </p>
    <div class="dreier">
      <div class="karte">
        <span class="kachel kachel--signal"><Fragment set:html={lucide('message-circle-heart', 22)} /></span>
        <h3 class="h3">Kontakt auf der Seite</h3>
        <p class="karteText">
          Absicht antippen, zwei Sätze schreiben, senden. Keine Weiterleitung in fünf Apps, kein Formular-Friedhof.
        </p>
        <div class="chipreihe">
          <span class="chip">Nachricht</span>
          <span class="chip">Buchung</span>
          <span class="chip">vCard · NFC</span>
        </div>
      </div>

      <div class="karte">
        <span class="kachel kachel--ink"><Fragment set:html={lucide('star', 22)} /></span>
        <h3 class="h3">Bewertungen, die zählen</h3>
        <p class="karteText">
          Bewerten kann nur, wer wirklich gebucht hat. Kritik landet erst privat bei dir — öffentlich wird nichts
          ohne deine Freigabe.
        </p>
        <div class="sterne">
          <span class="sterne__wert">4,9</span>
          <span class="sterne__reihe">
            {[1, 2, 3, 4, 5].map(() => <Fragment set:html={lucide('star', 13, true)} />)}
          </span>
        </div>
      </div>

      <div class="karte">
        <span class="kachel kachel--rose"><Fragment set:html={lucide('palette', 22)} /></span>
        <h3 class="h3">Deine Marke, deine Bilder</h3>
        <p class="karteText">
          Titelbild, Hintergrund, Knopfform, Schrift — und mit Whitelabel eigene Domain und Logo. Wir verschwinden.
        </p>
        <a class="textlink" href="/vorlagen">
          Vorlagen ansehen
          <Fragment set:html={lucide('arrow-right', 14)} />
        </a>
      </div>
    </div>
  </section>

  <!-- So läuft's -->
  <section class="abschnitt">
    <div class="kopfreihe">
      <h2 class="h2" style="margin:0;max-width:20ch">So läuft's</h2>
      <span class="meta">Drei Schritte, kein Handbuch</span>
    </div>
    <div class="dreier">
      {
        schritte.map((s, i) => (
          <div class="karte--ruhig">
            <span class="zahlkreis">{i + 1}</span>
            <h3 class="h3" style="font-size:19px;margin:14px 0 7px">
              {s.titel}
            </h3>
            <p class="karteText" style="margin:0">
              {s.text}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Neun Vorlagen -->
  <section class="abschnitt">
    <div class="kopfreihe" style="margin-bottom:20px">
      <h2 class="h2" style="margin:0">Neun Vorlagen</h2>
      <a class="textlink textlink--gross" href="/vorlagen">
        Alle ansehen
        <Fragment set:html={lucide('arrow-right', 14)} />
      </a>
    </div>
    <div class="anrisse">
      <a class="anriss anriss--kirsche" href="/vorlagen#kirsche">
        <span class="anriss__blatt">
          <span class="anriss__avatar anriss__avatar--kirsche"></span>
          <span class="anriss__name">Kirsche</span>
          <span class="anriss__haupt">Schreib mir</span>
          <span class="anriss__neben">Portfolio</span>
        </span>
      </a>

      <a class="anriss anriss--nacht" href="/vorlagen#nachtschicht">
        <span class="anriss__blatt anriss__blatt--nacht">
          <span class="anriss__avatar anriss__avatar--nacht"></span>
          <span class="anriss__name anriss__name--hell">Nachtschicht</span>
          <span class="anriss__haupt anriss__haupt--eckig">Booking</span>
          <span class="anriss__neben anriss__neben--nacht">Mixes</span>
        </span>
      </a>

      <a class="anriss anriss--beton" href="/vorlagen#beton">
        <span class="anriss__blatt anriss__blatt--beton">
          <span class="anriss__avatar anriss__avatar--beton"></span>
          <span class="anriss__name anriss__name--gesperrt">BETON</span>
          <span class="anriss__haupt anriss__haupt--beton">SCHREIB MIR</span>
          <span class="anriss__neben anriss__neben--beton">PROJEKTE</span>
        </span>
      </a>

      <a class="anriss anriss--sticker" href="/vorlagen#sticker">
        <span class="anriss__blatt anriss__blatt--sticker">
          <span class="anriss__avatar anriss__avatar--sticker"></span>
          <span class="anriss__name">Sticker</span>
          <span class="anriss__haupt anriss__haupt--schief">Schreib mir</span>
          <span class="anriss__neben anriss__neben--schief">Merch</span>
        </span>
      </a>
    </div>
  </section>

  <!-- Zitate -->
  <section class="zitate">
    {
      zitate.map((z) => (
        <div class="zitat">
          <Fragment set:html={lucide('quote', 24)} />
          <p class="zitat__satz">„{z.satz}“</p>
          <div class="zitat__wer">
            <span class="zitat__bild" />
            <span>
              <span class="zitat__name">{z.name}</span>
              <span class="zitat__rolle">{z.rolle}</span>
            </span>
          </div>
          <span class="platzhaltermarke">Platzhalter — echte Stimme fehlt</span>
        </div>
      ))
    }
  </section>

  <!-- Abschlussband -->
  <section class="band">
    <p class="kicker">Zwei Minuten, dann steht sie</p>
    <h2>Hör auf, Leute wegzuschicken.</h2>
    <div class="knopfreihe">
      <a class="knopf knopf--hell" href="/werkstatt">
        Seite bauen
        <Fragment set:html={lucide('arrow-right', 16)} />
      </a>
      <a class="knopf knopf--kontur" href="/preise">Preise ansehen</a>
      <span style="font-size:12.5px;opacity:.9">Kein Konto nötig, um es auszuprobieren.</span>
    </div>
  </section>
</Handoffrahmen>
