---
/**
 * Die Startseite, nach dem Aufbau des Design-Handoffs.
 *
 * Übernommen ist die Anordnung: Heldenbereich zweispaltig mit Abzeichen,
 * großer Überschrift und dem Adressfeld links, einer schwebenden Karte rechts;
 * darunter eine Reihe Kennzahlen, drei Karten „was eine Linkliste nicht kann",
 * drei Schritte, ein Vorlagen-Anriss und ein rotes Abschlussbanner.
 *
 * Nicht übernommen ist erfundener Inhalt. Der Handoff setzt in die
 * Kennzahlenreihe 7,5 % Kontaktrate und 4,9 Bewertungsschnitt und darunter zwei
 * Kundenzitate. Beides gibt es nicht: es hat noch kein Kunde diese Seite
 * benutzt, und Bewertungen sind nicht einmal gebaut. Eine Startseite, die mit
 * ausgedachten Zahlen und ausgedachten Menschen wirbt, wäre genau das, was
 * dieses Produkt der Konkurrenz vorwirft. An ihrer Stelle stehen Zahlen, die am
 * ausgelieferten HTML gemessen sind, und der Abschnitt „was heute fehlt".
 *
 * Auch kein Produktfoto: der Handoff hält selbst fest, dass Bildmaterial fehlt
 * und vom Kunden kommen muss. Statt eines grauen Platzhalters steht rechts die
 * Sache selbst — dieselbe Seite zu zwei Uhrzeiten.
 */
import { cssVariablen, vorlage, vorlagenName } from '../kern/gestaltung.ts';
import { zeichen } from '../kern/zeichen.ts';
import { MARKE, SIGNET } from '../kern/marke.ts';
import '../stile/marketing.css';

export const prerender = true;

const gestaltung = vorlage('signal');
const stil = Object.entries(cssVariablen(gestaltung))
  .map(([name, wert]) => `${name}:${wert}`)
  .join(';');

const titel = 'Get in Touch — die Kontaktseite, die weiß, wann du da bist';
const beschreibung =
  'Alle Kontaktwege, die digitale Visitenkarte und ein QR-Code auf einer Seite. ' +
  'Sie stellt nach vorn, was gerade wirklich trägt — im Betrieb den Anruf, danach den schriftlichen Weg.';

/** Gemessen, nicht behauptet. Woher die Zahl kommt, steht jeweils daneben. */
const kennzahlen = [
  { zahl: '25 KB', was: 'HTML einer Profilseite', neben: 'Linktree: 190 KB' },
  { zahl: '11', was: 'Vorlagen, drei Anordnungen', neben: 'jede WCAG-geprüft' },
  { zahl: '0', was: 'eigenes Tracking', neben: 'kein Cookie von uns' },
  { zahl: '2 Min.', was: 'bis die Seite steht', neben: 'ohne Konto', rose: true },
];

const koennen = [
  {
    zeichen: 'uhr',
    ton: 'signal',
    titel: 'Sie kennt deine Öffnungszeiten',
    text: 'Im Betrieb steht der Anruf oben. Danach der schriftliche Weg, mit ehrlicher Ansage, wann geantwortet wird — gerechnet in deiner Zeitzone, nicht in der des Besuchers.',
    chips: ['Jetzt erreichbar · bis 18:00', 'Gerade geschlossen'],
  },
  {
    zeichen: 'mail',
    ton: 'ink',
    titel: 'Geschrieben wird auf der Seite',
    text: 'Absicht wählen, Anliegen tippen, fertig — statt den Besucher nach WhatsApp zu schicken und zu hoffen, dass er dort weiß, was er sagen soll. Bei dir kommt eine sortierte Anfrage an.',
    chips: ['Anfrage für einen Auftrag', 'Termin', 'Etwas anderes'],
  },
  {
    zeichen: 'visitenkarte',
    ton: 'rose',
    titel: 'Sie landet im Adressbuch',
    text: 'Ein Tipp, und du stehst mit Foto drin. Dazu ein QR-Code, der auf die Seite zeigt statt auf die Daten: Nummer ändern, ohne neu zu drucken.',
    chips: ['vCard 3.0', 'QR als SVG'],
  },
];

const schritte = [
  { titel: 'Adresse aussuchen', text: 'Kurz und merkbar. Sie steht später auf dem Fahrzeug — lieber einmal länger überlegen.' },
  { titel: 'In der Werkstatt bauen', text: 'Kontaktwege, Öffnungszeiten, Design. Rechts läuft die echte Seite mit, kein Abbild davon.' },
  { titel: 'Abgeben, wir schalten frei', text: 'Ein Klick öffnet die Mail mit deinem Entwurf darin. Zurück kommt die fertige Adresse.' },
];

const anrisse = ['signal', 'nachtschicht', 'papier', 'werkbank'];

const offen = [
  {
    marke: 'in Arbeit',
    titel: 'Konto',
    text: 'Bauen kannst du deine Seite selbst. Veröffentlichen geht noch über uns: du schickst den Entwurf, wir schalten ihn frei.',
  },
  { marke: 'in Arbeit', titel: 'Termine und Bewertungen', text: 'Entworfen und eingeplant, aber nicht gebaut. Steht auch so auf der Preisseite.' },
  {
    marke: 'auf Anfrage',
    titel: 'Eigene Domain',
    text: 'Heute läuft jede Seite unter der Adresse des Dienstes. Weil im QR-Code die Adresse steckt, gehört das vor den ersten Druck geklärt.',
  },
];

const fragen = [
  {
    frage: 'Was kostet das?',
    antwort:
      'Zurzeit nichts — das System ist jung. Was später Geld kosten soll, steht trotzdem schon auf der Preisseite, damit dich in einem Jahr nichts überrascht.',
  },
  {
    frage: 'Funktioniert „Kontakt speichern" auf jedem Handy?',
    antwort:
      'Ja. Die Datei ist eine vCard 3.0 — bewusst nicht die neuere Fassung 4.0, denn die wird auf genau den Geräten unzuverlässig gelesen, auf denen die Karte am häufigsten landet.',
  },
  {
    frage: 'Woher weiß die Seite, ob ich erreichbar bin?',
    antwort:
      'Aus den Öffnungszeiten im Profil, samt Feiertagen und Sonderzeiten. Sind keine gepflegt, steht auch keine Statuszeile da. Eine erfundene Verfügbarkeit wäre schlimmer als gar keine Angabe.',
  },
  {
    frage: 'Wo liegen die Daten?',
    antwort:
      'Auf der Wix-Infrastruktur, die hnvr.me auch für seine übrigen Projekte nutzt. Die Seite selbst lädt nichts von Dritten nach und meldet niemandem, wer sie geöffnet hat. Wix legt allerdings vier eigene Skripte in jede ausgelieferte Seite — Cookie-Richtlinie, Telemetrie und Besucherzählung. Die kommen nicht aus diesem Programm.',
  },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <meta name="theme-color" content={gestaltung.grund} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="/schriften/schriften.css" />
  </head>

  <body style={stil}>
    <div class="seite">
      <div class="bahn">
        <header class="kopfzeile">
          <a class="wortmarke" href="/">
            <Fragment set:html={SIGNET} />
            <span>{MARKE.name}</span>
          </a>
          <nav class="kopfnavi">
            <a href="/designs">Designs</a>
            <a href="/karte">Karte &amp; NFC</a>
            <a href="/teams">Für Teams</a>
            <a href="/preise">Preise</a>
            <a href="/marke">Marke</a>
          </nav>
        </header>

        <section class="held">
          <div class="held__text">
            <p class="abzeichen">
              <Fragment set:html={zeichen('uhr')} />
              Ein Link, der antwortet
            </p>
            <h1>Deine Leute sollen dich erreichen, nicht nur anklicken.</h1>
            <p class="fuehrung">
              Alle Kontaktwege, die digitale Visitenkarte und ein QR-Code unter einer kurzen Adresse. Nach vorn stellt
              sie, was gerade wirklich trägt: im Betrieb den Anruf, danach den schriftlichen Weg.
            </p>

            <form class="adressfeld" action="/werkstatt" method="get">
              <span class="adressfeld__praefix">/t/</span>
              <input type="text" name="name" placeholder="deinname" spellcheck="false" autocomplete="off" />
              <button type="submit" class="knopf knopf--voll">Sichern</button>
            </form>
            <p class="leise">Kostenlos starten · ohne Konto · in zwei Minuten live</p>
          </div>

          {/* Kein Produktfoto: der Handoff hält fest, dass Bildmaterial fehlt.
              Statt eines Platzhalters steht hier die Sache selbst. */}
          <div class="held__probe">
            <div class="lagen">
              <div class="lage">
                <p class="lage__zeit">Mittwoch, 14:00</p>
                <p class="lage__status lage__status--offen">
                  <span class="lage__punkt"></span>
                  Jetzt erreichbar · bis 18:00
                </p>
                <p class="lage__knopf">
                  <Fragment set:html={zeichen('telefon')} />
                  Jetzt anrufen
                </p>
                <p class="lage__nach">Der Anruf steht oben, weil jemand da ist.</p>
              </div>
              <div class="lage">
                <p class="lage__zeit">Samstag, 23:00</p>
                <p class="lage__status">
                  <Fragment set:html={zeichen('uhr')} />
                  Gerade geschlossen · Montag ab 9:00
                </p>
                <p class="lage__knopf">
                  <Fragment set:html={zeichen('whatsapp')} />
                  WhatsApp schreiben
                </p>
                <p class="lage__nach">Nachts führt der schriftliche Weg — mit ehrlicher Ansage.</p>
              </div>
            </div>
            <p class="schwebe">
              <span class="schwebe__punkt"></span>
              Dieselbe Seite, zwei Zeitpunkte
            </p>
          </div>
        </section>

        <section>
          <div class="zahlen">
            {
              kennzahlen.map((k) => (
                <div class:list={['zahl', k.rose && 'zahl--rose']}>
                  <b>{k.zahl}</b>
                  <span>{k.was}</span>
                  <em>{k.neben}</em>
                </div>
              ))
            }
          </div>
          <p class="quelle">
            Größe und Skriptzahl im August 2026 am ausgelieferten HTML gemessen — an beiden Seiten, nicht an
            Werbeaussagen. Vier weitere Skripte kommen auf unserer Seite von der Auslieferung durch Wix dazu; sie
            stammen nicht aus diesem Programm und lassen sich aus ihm nicht entfernen.
          </p>
        </section>

        <section>
          <p class="marke">der unterschied</p>
          <h2>Drei Dinge, die eine<br />Linkliste nicht kann.</h2>
          <div class="koennen">
            {
              koennen.map((k) => (
                <div class="kann">
                  <span class={`kann__zeichen kann__zeichen--${k.ton}`}>
                    <Fragment set:html={zeichen(k.zeichen)} />
                  </span>
                  <h3>{k.titel}</h3>
                  <p>{k.text}</p>
                  <div class="kann__chips">
                    {k.chips.map((c) => (
                      <span class="chip">{c}</span>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <section>
          <p class="marke">so läuft's</p>
          <h2>Von der Idee zur Adresse.</h2>
          <div class="schritte">
            {
              schritte.map((s, i) => (
                <div class="schritt">
                  <span class="schritt__zahl">{i + 1}</span>
                  <h3>{s.titel}</h3>
                  <p>{s.text}</p>
                </div>
              ))
            }
          </div>
        </section>

        <section>
          <p class="marke">ein look pro charakter</p>
          <h2>Elf Vorlagen,<br />drei Anordnungen.</h2>
          <div class="anrisse">
            {
              anrisse.map((k) => {
                const v = vorlage(k);
                const s = Object.entries(cssVariablen(v))
                  .map(([n, w]) => `${n}:${w}`)
                  .join(';');
                return (
                  <a class="anriss" href={`/designs/${k}`}>
                    <span class="anriss__blatt" style={s}>
                      <span class="anriss__bild" />
                      <span class="anriss__name">{vorlagenName(k)}</span>
                      <span class="anriss__knopf" />
                      <span class="anriss__zeile" />
                      <span class="anriss__zeile" />
                    </span>
                    <span class="anriss__fuss">{vorlagenName(k)}</span>
                  </a>
                );
              })
            }
          </div>
          <p class="quelle">
            Alle elf stehen in der <a href="/designs">Galerie</a> — jede mit eigenem Schriftpaar und eigener
            Anordnung, jede gegen WCAG durchgerechnet.
          </p>
        </section>

        <section>
          <p class="marke">was heute fehlt</p>
          <h2>Damit du es nicht selbst<br />herausfinden musst.</h2>
          <ul class="offen">
            {
              offen.map((o) => (
                <li>
                  <span class="offen__marke">{o.marke}</span>
                  <b>{o.titel}</b>
                  <span>{o.text}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <p class="marke">fragen</p>
          <div class="fragen">
            {
              fragen.map((f) => (
                <div class="frage">
                  <h3>{f.frage}</h3>
                  <p>{f.antwort}</p>
                </div>
              ))
            }
          </div>
        </section>

        <section class="banner">
          <p class="marke">bereit?</p>
          <h2>Hör auf, Leute wegzuschicken.</h2>
          <div class="knopfreihe">
            <a class="knopf knopf--hell" href="/werkstatt">
              Seite bauen
              <Fragment set:html={zeichen('pfeil')} />
            </a>
            <a class="knopf knopf--kontur" href="/t/hnvr">Echte Seite ansehen</a>
          </div>
        </section>

        <footer class="fuss">
          <span>© {new Date().getFullYear()} hnvr.me · viel Liebe Media UG</span>
          <span>
            <a href="https://hnvr.me/impressum" target="_blank" rel="noopener noreferrer">Impressum</a>
            ·
            <a href="https://hnvr.me/datenschutz" target="_blank" rel="noopener noreferrer">Datenschutz</a>
          </span>
        </footer>
      </div>
    </div>
  </body>
</html>
