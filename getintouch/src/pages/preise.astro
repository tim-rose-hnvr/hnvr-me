---
/**
 * Preise.
 *
 * Nachbau von `doku/handoff/design/Website-Preise.dc.html`: drei Pläne mit
 * hervorgehobenem Pro, Vergleichstabelle, vier FAQ-Karten, rotes Band.
 *
 * Zwei Abweichungen vom Prototyp, beide sachlich:
 * - **Euro statt Franken.** Die Zahlen bleiben, die Währung nicht.
 * - **Ein Band über den Plänen.** Heute kostet nichts etwas — das System ist
 *   jung, und es gibt weder Abrechnung noch Konto. Die Preistafel steht
 *   trotzdem, weil in einem Jahr niemand überrascht sein soll. Ohne diesen
 *   einen Satz wäre die Seite eine Preisliste für etwas, das man nicht kaufen
 *   kann.
 */
import Handoffrahmen from '../komponenten/Handoffrahmen.astro';
import { lucide } from '../kern/lucide.ts';
import { MARKE } from '../kern/marke.ts';
import '../stile/preise.css';

export const prerender = false;

Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=3600, stale-while-revalidate=86400');

const titel = `Preise — ${MARKE.name}`;
const beschreibung =
  'Kostenlos anfangen. Zahlen, wenn es dir Arbeit spart. Keine Klick-Limits, keine Werbung auf deiner Seite, kein Vertrag.';

const vergleich = [
  { name: 'Links & Besuche', frei: 'unbegrenzt', pro: 'unbegrenzt', studio: 'unbegrenzt' },
  { name: 'Nachrichten-Absichten', frei: '2', pro: 'unbegrenzt', studio: 'unbegrenzt' },
  { name: 'Terminbuchung', frei: '—', pro: true, studio: true },
  { name: 'Bewertungen & privates Feedback', frei: '—', pro: true, studio: true },
  { name: 'Vorlagen', frei: '3', pro: '9', studio: '9 + eigene' },
  { name: 'Eigene Domain', frei: '—', pro: '1', studio: 'unbegrenzt' },
  { name: 'Whitelabel (Logo, kein Fremdbrand)', frei: '—', pro: '—', studio: true },
  { name: 'Team-Profile', frei: '—', pro: '1', studio: 'bis 20' },
];

const fragen = [
  {
    frage: 'Was passiert nach den 14 Tagen?',
    text: 'Nichts Dramatisches: die Seite bleibt online, Pro-Bausteine gehen in den Ruhezustand. Nichts wird gelöscht.',
  },
  {
    frage: 'Gibt es Werbung auf meiner Seite?',
    text: 'Nie. Im Frei-Plan steht unten eine kleine Zeile „gebaut mit getintouch" — ab Pro ist auch die weg.',
  },
  {
    frage: 'Wem gehören meine Kontakte?',
    text: 'Dir. Export als CSV jederzeit, auch im Frei-Plan. Wir verkaufen keine Daten und tracken Besucher nicht personenbezogen.',
  },
  {
    frage: 'Kann ich meine alte Linkliste mitnehmen?',
    text: 'Ja — Adresse eingeben, wir übernehmen Links, Foto und Bio. Danach ergänzt du nur noch Nachricht und Termin.',
  },
];

const haken = lucide('check', 15);
---

<Handoffrahmen titel={titel} beschreibung={beschreibung} hier="/preise">
  <section class="pkopf an-rise">
    <h1 class="h1 h1--klein" style="margin:0 0 14px;max-width:none">
      Kostenlos anfangen. Zahlen, wenn's dir Arbeit spart.
    </h1>
    <p class="fliess" style="margin-bottom:18px;max-width:none">
      Keine Klick-Limits, keine Werbung auf deiner Seite, kein Vertrag. Monatlich kündbar, jährlich zwei Monate
      günstiger.
    </p>
    <div class="takt" data-takt role="group" aria-label="Abrechnungstakt">
      <button class="takt__hier" type="button" data-wahl="monat">Monatlich</button>
      <button class="takt__aus" type="button" data-wahl="jahr">Jährlich · 2 Monate gratis</button>
    </div>
  </section>

  <p class="hinweisband">
    <Fragment set:html={lucide('sparkles', 16)} />
    <span>
      <b>Heute kostet alles nichts.</b> Es gibt weder Konto noch Abrechnung — wer eine Seite will, schickt den
      Entwurf aus der Werkstatt, und wir schalten sie frei. Die Tafel darunter zeigt, wohin es gehen soll, damit in
      einem Jahr niemand überrascht ist.
    </span>
  </p>

  <section class="plaene" data-auf>
    <div class="plan">
      <p class="plan__name">Frei</p>
      <p class="plan__preis"><span data-monat="0">0</span><span class="plan__takt">€ / Monat</span></p>
      <p class="plan__satz">Für alle, die einfach erreichbar sein wollen.</p>
      <a class="plan__knopf plan__knopf--rand" href="/werkstatt">
        Kostenlos starten<span class="schub"></span>
        <Fragment set:html={lucide('arrow-right', 15)} />
      </a>
      <div class="plan__liste">
        <span class="plan__zeile"><Fragment set:html={haken} /><span>Unbegrenzte Links &amp; Besuche</span></span>
        <span class="plan__zeile"><Fragment set:html={haken} /><span>Nachrichten-Baustein mit 2 Absichten</span></span>
        <span class="plan__zeile"><Fragment set:html={haken} /><span>3 Vorlagen, Profil- und Titelbild</span></span>
        <span class="plan__zeile"><Fragment set:html={haken} /><span>vCard &amp; QR-Code</span></span>
      </div>
    </div>

    <div class="plan plan--hervor">
      <span class="plan__abzeichen">EMPFOHLEN</span>
      <p class="plan__name plan__name--signal">Pro</p>
      <p class="plan__preis"><span data-monat="9">9</span><span class="plan__takt">€ / Monat</span></p>
      <p class="plan__satz">Für Freelancer und kleine Betriebe, die Anfragen und Termine wollen.</p>
      <a class="plan__knopf plan__knopf--signal" href="/werkstatt">
        14 Tage testen<span class="schub"></span>
        <Fragment set:html={lucide('arrow-right', 15)} />
      </a>
      <div class="plan__liste">
        <span class="plan__zeile"><Fragment set:html={haken} /><span><b>Alles aus Frei</b>, plus:</span></span>
        <span class="plan__zeile"><Fragment set:html={haken} /><span>Terminbuchung mit Kalender-Verbindung</span></span>
        <span class="plan__zeile"><Fragment set:html={haken} /><span>Bewertungen mit privatem Feedback-Kanal</span></span>
        <span class="plan__zeile"><Fragment set:html={haken} /><span>Eigene Domain, alle 9 Vorlagen</span></span>
        <span class="plan__zeile"><Fragment set:html={haken} /><span>Analytics mit Empfehlungen, Kontextregeln</span></span>
      </div>
    </div>

    <div class="plan plan--ink">
      <p class="plan__name">Studio · Whitelabel</p>
      <p class="plan__preis"><span data-monat="39">39</span><span class="plan__takt">€ / Monat</span></p>
      <p class="plan__satz">Für Teams, Agenturen und Betriebe mit mehreren Personen.</p>
      <a class="plan__knopf plan__knopf--hell" href="/teams">
        Whitelabel ansehen<span class="schub"></span>
        <Fragment set:html={lucide('arrow-right', 15)} />
      </a>
      <div class="plan__liste">
        <span class="plan__zeile"><Fragment set:html={haken} /><span><b>Alles aus Pro</b>, plus:</span></span>
        <span class="plan__zeile"><Fragment set:html={haken} /><span>Bis 20 Team-Profile aus einer Vorlage</span></span>
        <span class="plan__zeile"><Fragment set:html={haken} /><span>Eigenes Logo, gesperrte Markenwerte</span></span>
        <span class="plan__zeile"><Fragment set:html={haken} /><span>Gemeinsamer Anfragen-Eingang, Rollen</span></span>
        <span class="plan__zeile"><Fragment set:html={haken} /><span>CSV-Import, Rechnung statt Karte</span></span>
      </div>
    </div>
  </section>

  <section class="abschnitt" style="padding-bottom:44px" data-auf>
    <h2 class="h2" style="font-size:30px;margin-bottom:18px">Im Detail</h2>
    <div class="tafel">
      <div class="zeile zeile--kopf">
        <span>Funktion</span><span>Frei</span><span>Pro</span><span>Studio</span>
      </div>
      {
        vergleich.map((v, i) => (
          <div class:list={['zeile', i === vergleich.length - 1 && 'zeile--letzte']}>
            <span>{v.name}</span>
            {[v.frei, v.pro, v.studio].map((w) =>
              w === true ? (
                <span class="ja">
                  <Fragment set:html={haken} />
                </span>
              ) : (
                <span class:list={[w === '—' && 'leer']}>{w}</span>
              ),
            )}
          </div>
        ))
      }
    </div>
  </section>

  <section class="fragen" data-auf>
    {
      fragen.map((f) => (
        <div class="frage">
          <h3>{f.frage}</h3>
          <p>{f.text}</p>
        </div>
      ))
    }
  </section>

  <section class="band band--quer" data-auf>
    <h2 style="max-width:24ch">Fang frei an. Upgrade, wenn Anfragen kommen.</h2>
    <a class="knopf knopf--hell" href="/werkstatt">
      Seite bauen
      <Fragment set:html={lucide('arrow-right', 16)} />
    </a>
  </section>
</Handoffrahmen>
