---
/**
 * Für Teams.
 *
 * Nachbau von `doku/handoff/design/Website-Teams.dc.html`: Held mit
 * Besuchervorschau, sechs Nutzenkarten (drei mit Standfuß, drei ruhig),
 * Zitatblock mit Teamfoto, vier Segmente, dunkles Abschlussband.
 *
 * Der Preis steht im Prototyp in Franken; hier in Euro wie im ganzen Produkt.
 * Das Zitat trägt im Prototyp den Namen einer Studioleitung — die gibt es
 * nicht. Statt einer erfundenen Kundenstimme steht hier die Aussage des
 * Herstellers, klar zugeordnet. Das Teamfoto bleibt ein Platz, weil es
 * wirklich fehlt.
 */
import Handoffrahmen from '../komponenten/Handoffrahmen.astro';
import { lucide } from '../kern/lucide.ts';
import { MARKE, zeichenPlaettchen } from '../kern/marke.ts';
import '../stile/teams.css';

export const prerender = false;

Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=3600, stale-while-revalidate=86400');

const titel = `Für Teams — ${MARKE.name}`;
const beschreibung =
  'Eigene Domain, eigenes Logo, eine Vorlage für alle Profile. Anfragen aus allen Profilen laufen in einen gemeinsamen Eingang.';

const gross = [
  {
    zeichen: 'globe' as const,
    ton: 'signal',
    titel: 'Eigene Domain',
    text: 'kontakt.eurefirma.de — DNS verifiziert, SSL automatisch. Unser Name steht nirgends.',
  },
  {
    zeichen: 'lock' as const,
    ton: 'ink',
    titel: 'Marke gesperrt',
    text: 'Logo und Farben legt die Leitung fest. Das Team ändert Texte, Bilder und Reihenfolge — nicht die Marke.',
  },
  {
    zeichen: 'inbox' as const,
    ton: 'rose',
    titel: 'Ein Eingang',
    text: 'Anfragen aller Profile in einer Liste, mit Zuweisung und Antwortzeit. Urlaub? Weiterleiten an Kolleg:innen.',
  },
];

const klein = [
  {
    zeichen: 'file-spreadsheet' as const,
    titel: 'CSV-Onboarding',
    text: 'Liste hochladen, 20 Profile stehen mit Einladung — jede Person füllt nur Foto und Text.',
  },
  {
    zeichen: 'shield-check' as const,
    titel: 'Rollen & Rechte',
    text: 'Leitung, Redaktion, Person. Wer Bewertungen beantworten darf, entscheidet ihr.',
  },
  {
    zeichen: 'bar-chart-3' as const,
    titel: 'Zahlen pro Person',
    text: 'Wer bekommt Anfragen, wo bleiben sie liegen — mit Empfehlung statt Diagramm-Salat.',
  },
];

const passt = [
  { zeichen: 'camera' as const, titel: 'Studios & Agenturen', text: 'Profile pro Person, ein Look' },
  { zeichen: 'stethoscope' as const, titel: 'Praxen', text: 'Termin zuerst, Notfall sichtbar' },
  { zeichen: 'hammer' as const, titel: 'Handwerk', text: 'Offerte anfragen, Referenzen' },
  { zeichen: 'building-2' as const, titel: 'Vertrieb', text: 'NFC-Karten, vCard, Messe' },
];

const demo = `mailto:${MARKE.postfach}?subject=getintouch%20f%C3%BCr%20Teams%20%E2%80%94%20Demo`;
---

<Handoffrahmen titel={titel} beschreibung={beschreibung} hier="/teams">
  <!-- Held -->
  <section class="theld">
    <div class="an-rise">
      <span class="abzeichen">
        <Fragment set:html={lucide('users-round', 14)} />
        Whitelabel für Teams
      </span>
      <h1 class="h1" style="font-size:56px;line-height:.96;max-width:18ch">Eure Marke vorne. Wir bleiben unsichtbar.</h1>
      <p class="fliess" style="margin-bottom:22px">
        Eigene Domain, eigenes Logo, eine Vorlage für alle Profile. Jede Person im Team hat ihre Seite — Anfragen
        laufen in einen gemeinsamen Eingang.
      </p>
      <div class="knopfreihe" style="gap:11px">
        <a class="knopf knopf--signal" href={demo} style="padding:15px 20px;border-radius:24px;font-size:13.5px;box-shadow:0 5px 0 0 var(--color-accent-700)">
          Demo anfragen
          <Fragment set:html={lucide('arrow-right', 15)} />
        </a>
        <a class="knopf knopf--rand" href="/preise" style="padding:15px 20px;border-radius:24px;font-size:13.5px">
          Preise ansehen
        </a>
      </div>
      <div class="handle__meta" style="gap:14px;margin-top:16px">
        <span>Ab 39 € / Monat</span><span>·</span><span>bis 20 Profile</span><span>·</span><span>Rechnung möglich</span>
      </div>
    </div>

    <div class="vorschaukasten">
      <p class="kicker" style="font-size:10px;margin-bottom:12px">So sieht's für Besucher aus</p>
      <div class="vorschau">
        <div class="vorschau__kopf">
          <span class="vorschau__logo"></span>
          <span class="vorschau__firma">STUDIO HARDTURM</span>
          <span class="schub"></span>
          <span class="vorschau__domain">kontakt.studiohardturm.de</span>
        </div>
        <div class="vorschau__paar">
          {
            [
              { name: 'Lina Moser', pfad: '/lina' },
              { name: 'Tim Vogt', pfad: '/tim' },
            ].map((p) => (
              <div class="vorschau__person">
                <span class="vorschau__avatar" />
                <span class="vorschau__name">{p.name}</span>
                <span class="vorschau__pfad">{p.pfad}</span>
                <span class="vorschau__knopf">Schreib mir</span>
              </div>
            ))
          }
        </div>
        <div class="vorschau__mehr">12 weitere Profile · alle mit derselben Vorlage</div>
      </div>
    </div>
  </section>

  <!-- Nutzen -->
  <section class="abschnitt" style="padding-bottom:50px" data-auf>
    <h2 class="h2" style="margin-bottom:22px;max-width:24ch">Was Teams davon haben</h2>
    <div class="dreier">
      {
        gross.map((n) => (
          <div class="karte">
            <span class:list={['kachel', 'kachel--klein', `kachel--${n.ton}`]}>
              <Fragment set:html={lucide(n.zeichen, 21)} />
            </span>
            <h3 class="h3" style="font-size:19px;margin:15px 0 7px">
              {n.titel}
            </h3>
            <p class="karteText" style="margin:0">
              {n.text}
            </p>
          </div>
        ))
      }
      {
        klein.map((n) => (
          <div class="karte--ruhig" style="padding:26px">
            <span class="zeichenSignal">
              <Fragment set:html={lucide(n.zeichen, 20)} />
            </span>
            <h3 class="h3" style="font-size:17px;margin:13px 0 7px">
              {n.titel}
            </h3>
            <p class="karteText" style="margin:0;font-size:12.5px">
              {n.text}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Zitat -->
  <section class="zitatblock" data-auf>
    <div>
      <span class="zeichenSignal"><Fragment set:html={lucide('quote', 24)} /></span>
      <p class="zitatblock__satz">
        „Zwanzig Leute mit zwanzig Linklisten sind zwanzig Auftritte. Der Team-Bereich soll daraus einen machen,
        ohne dass jemand seine eigene Seite verliert."
      </p>
      <div class="zitat__wer">
        <span class="zitat__bild zitat__bild--marke"><Fragment set:html={zeichenPlaettchen()} /></span>
        <span>
          <span class="zitat__name" style="font-size:13px">{MARKE.hersteller.name}</span>
          <span class="zitat__rolle" style="font-size:11.5px">Hersteller · in eigener Sache</span>
        </span>
      </div>
    </div>
    <div class="zitatblock__zahlen">
      <div class="tzahl"><b>20</b><span>Profile aus einer Vorlage</span></div>
      <div class="tzahl"><b>1</b><span>Domain, eure</span></div>
      <div class="tzahl"><b>0</b><span>Stellen, an denen unser Name steht</span></div>
    </div>
  </section>

  <!-- Passt für -->
  <section class="abschnitt" style="padding-bottom:50px" data-auf>
    <div class="kopfreihe" style="margin-bottom:18px">
      <h2 class="h2" style="font-size:30px;margin:0">Passt für</h2>
      <span class="meta">Vorlagen ab Seite 1 vorbereitet</span>
    </div>
    <div class="vierer">
      {
        passt.map((p) => (
          <div class="segment">
            <Fragment set:html={lucide(p.zeichen, 19)} />
            <span class="segment__titel">{p.titel}</span>
            <span class="segment__text">{p.text}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="band band--ink band--quer" data-auf>
    <div style="flex:1;min-width:300px">
      <h2 style="margin-bottom:10px;max-width:22ch">20 Minuten Demo, dann wisst ihr's.</h2>
      <p style="margin:0;font-size:13px;line-height:1.6;opacity:.8;max-width:44ch">
        Wir richten mit euch ein Profil ein, verbinden eure Domain und zeigen den gemeinsamen Eingang.
      </p>
    </div>
    <a class="knopf knopf--signal" href={demo} style="box-shadow:0 5px 0 0 var(--color-accent-700)">
      Demo anfragen
      <Fragment set:html={lucide('arrow-right', 16)} />
    </a>
  </section>
</Handoffrahmen>
