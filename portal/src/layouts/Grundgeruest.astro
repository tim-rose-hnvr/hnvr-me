---
/* Grundgerüst jeder Seite: Kopf, Fuß, Stile.
   Die Anmeldung zeigt auf /api/auth/login — diesen Weg stellt Wix'
   Astro-Integration bereit, sobald das Projekt angehängt ist. */
const { titel, beschreibung = 'PDF-Arbeit, die auf Ihrem Gerät bleibt. Kein Konto, kein Upload, kein Abo.', anmeldenZeigen = true } = Astro.props;
import '../styles/werkbank.css';
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titel}</title>
  <meta name="description" content={beschreibung} />
  <meta property="og:title" content={titel} />
  <meta property="og:description" content={beschreibung} />
  <meta property="og:type" content="website" />
</head>
<body>
  <header class="kopf">
    <div class="spur kopfzeile">
      <a class="markenzug" href="/">
        <span class="markenzug-zeichen" aria-hidden="true"></span>
        <span>
          <span class="markenzug-wort">Werkbank</span>
          <span class="markenzug-unterzeile">hnvr.me digital</span>
        </span>
      </a>
      <nav class="kopf-wege">
        <a class="klein" href="/#abgleich">Abgleich</a>
        <a class="klein" href="/#pruefstand">Prüfstand</a>
        <a class="klein" href="/portal">Kundenbereich</a>
        {anmeldenZeigen && <a class="knopf-voll" href="/api/auth/login">Anmelden</a>}
      </nav>
    </div>
  </header>

  <slot />

  <footer class="invers">
    <div class="spur fusszeile">
      <div>
        <span class="markenzug-wort">Werkbank</span>
        <p class="klein leise" style="max-width:26rem">PDF-Arbeit auf Ihrem Gerät. Kein Konto, kein Upload, kein Abo.</p>
      </div>
      <div class="klein leise mono">PDF · OCR · PAdES-B-B · KEIN CLOUD-ZWANG</div>
      <div class="klein leise">hnvr.me digital</div>
    </div>
  </footer>
</body>
</html>
