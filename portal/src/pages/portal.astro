---
/* Kundenbereich — angemeldet mit dem hnvr.me-Konto.

   `prerender = false` heißt: die Seite wird bei jedem Aufruf gerechnet. Nur so
   kennt sie den angemeldeten Menschen; als vorgebackene Datei wäre sie für
   alle dieselbe.

   Konten und Kennwörter liegen bei hnvr.me, nicht hier: angemeldet wird über
   /api/hnvr/anmelden, und wer bei hnvr.me schon angemeldet ist, kommt ohne
   Formular durch. Das Konto selbst — Name, Adresse, Kennwort — verwaltet
   die Konsole auf www.hnvr.me. */
export const prerender = false;

import Grundgeruest from '../layouts/Grundgeruest.astro';
import { hnvrMitglied } from '../hnvr.js';

const { mitglied, name, kekse, unerreichbar } = await hnvrMitglied(Astro.request);
for (const k of kekse) Astro.response.headers.append('Set-Cookie', k);

const hinweis = Astro.url.searchParams.get('anmeldung');
const KONSOLE = 'https://www.hnvr.me/konsole';
---
<Grundgeruest titel="Kundenbereich — PDF Studio" anmeldenZeigen={false}>
  <main>
    <section class="spur">
      <span class="marke">Kundenbereich</span>

      {mitglied ? (
        <>
          <h2 class="lauf">Angemeldet{name ? ` als ${name}` : ''}</h2>
          <div class="portal-karte">
            <h2>Das Studio steht bereit</h2>
            <p class="leise">
              Sie sind mit Ihrem hnvr.me-Konto angemeldet. Kostenlos, ohne
              Stufen, ohne Zahlungsdaten — und Ihre Dateien bleiben dabei auf
              Ihrem Gerät.
            </p>
            <div class="knopf-reihe" style="margin-top:1rem">
              <a class="knopf-voll" href="/studio/index.html">PDF Studio öffnen</a>
              <a class="knopf-rand" href={KONSOLE}>Konto bei hnvr.me</a>
              <form method="post" action="/api/hnvr/abmelden?returnToUrl=%2F" style="display:inline">
                <button class="knopf-rand" type="submit">Abmelden</button>
              </form>
            </div>
            <p class="klein leise" style="margin-top:1rem">
              Abmelden meldet Sie auch bei hnvr.me ab — es ist dieselbe Anmeldung.
            </p>
          </div>

          <h2 class="lauf" style="margin-top:3rem">Was Ihre Anmeldung bedeutet</h2>
          <div class="raster raster-zwei">
            <div class="eintrag">
              <h3>Ein Konto für alles bei hnvr.me</h3>
              <p>Dasselbe Konto wie in der Konsole auf www.hnvr.me. Name,
              Adresse und Kennwort ändern Sie dort.</p>
            </div>
            <div class="eintrag">
              <h3>Ihre Dateien bleiben, wo sie sind</h3>
              <p>Auch angemeldet lädt das Studio nichts hoch. Texterkennung,
              Verschlüsselung und Unterschrift laufen in Ihrem Browser.</p>
            </div>
          </div>
        </>
      ) : (
        <>
          <h2 class="lauf">Anmelden</h2>
          <div class="portal-karte">
            <h2>Mit Ihrem hnvr.me-Konto</h2>
            <p class="leise">
              Das Studio kostet nichts. Angemeldet wird mit dem Konto, das Sie
              bei hnvr.me haben — wer dort schon angemeldet ist, kommt ohne
              Formular durch. Noch kein Konto? Auf der Anmeldeseite lässt sich
              eins anlegen. Ihre Dateien werden auch danach nicht hochgeladen.
            </p>
            <a class="knopf-voll" href="/api/hnvr/anmelden?returnToUrl=%2Fportal">Mit hnvr.me anmelden</a>
            {hinweis === 'abgebrochen' && (
              <p class="klein leise" style="margin-top:1rem">
                Die Anmeldung wurde nicht abgeschlossen. Ein zweiter Versuch
                beginnt wieder bei hnvr.me.
              </p>
            )}
            {(hinweis === 'unerreichbar' || unerreichbar) && (
              <p class="klein leise" style="margin-top:1rem">
                hnvr.me antwortet gerade nicht. Das Studio selbst läuft davon
                unabhängig; wer sich in den letzten 30 Tagen angemeldet hat,
                arbeitet darin weiter.
              </p>
            )}
          </div>
        </>
      )}
    </section>
  </main>
</Grundgeruest>
