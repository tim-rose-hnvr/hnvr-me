---
/* Kundenbereich — jetzt mit echter Anmeldung.

   `prerender = false` heißt: die Seite wird bei jedem Aufruf gerechnet. Nur so
   kennt sie den angemeldeten Menschen; als vorgebackene Datei wäre sie für
   alle dieselbe. Die Anmeldung selbst übernimmt die Wix-Astro-Integration mit
   /api/auth/login und /api/auth/logout — Konten und Kennwörter liegen dort,
   nicht in einer selbstgebauten Benutzerverwaltung. */
export const prerender = false;

import Grundgeruest from '../layouts/Grundgeruest.astro';
import { members } from '@wix/members';

let mitglied = null;
let fehler = null;
try {
  const ergebnis = await members.getCurrentMember();
  mitglied = ergebnis?.member ?? null;
} catch (e) {
  /* Noch nicht eingerichtet oder keine Sitzung — beides heißt: abgemeldet. */
  fehler = e?.message ?? String(e);
}

const name = mitglied?.profile?.nickname
  || [mitglied?.contact?.firstName, mitglied?.contact?.lastName].filter(Boolean).join(' ')
  || mitglied?.loginEmail
  || null;
---
<Grundgeruest titel="Kundenbereich — PDF Studio" anmeldenZeigen={false}>
  <main>
    <section class="spur">
      <span class="marke">Kundenbereich</span>

      {mitglied ? (
        <>
          <h2 class="lauf">Angemeldet{name ? ` als ${name}` : ''}</h2>
          <div class="portal-karte">
            <h2>Das Studio steht bereit</h2>
            <p class="leise">
              Kostenlos, ohne Stufen, ohne Zahlungsdaten. Alles, was es kann,
              ist jetzt offen — und Ihre Dateien bleiben dabei auf Ihrem Gerät.
            </p>
            <div class="knopf-reihe" style="margin-top:1rem">
              <a class="knopf-voll" href="/studio/index.html">PDF Studio öffnen</a>
              <form method="post" action="/api/auth/logout?returnToUrl=%2F" style="display:inline">
                <button class="knopf-rand" type="submit">Abmelden</button>
              </form>
            </div>
          </div>

          <h2 class="lauf" style="margin-top:3rem">Was Ihre Anmeldung bedeutet</h2>
          <div class="raster raster-zwei">
            <div class="eintrag">
              <h3>Sie kostet nichts</h3>
              <p>Kein Abo, keine Stufen, keine Zahlungsdaten. Es gibt keine
              Funktion, die hinter einer Bezahlschranke liegt.</p>
            </div>
            <div class="eintrag">
              <h3>Ihre Dateien bleiben, wo sie sind</h3>
              <p>Auch angemeldet lädt das Studio nichts hoch. Texterkennung,
              Verschlüsselung und Unterschrift laufen in Ihrem Browser.</p>
            </div>
          </div>
        </>
      ) : (
        <>
          <h2 class="lauf">Anmelden</h2>
          <div class="portal-karte">
            <h2>Kostenlos — mit Anmeldung</h2>
            <p class="leise">
              Das Studio kostet nichts. Wir möchten nur wissen, wer sie
              benutzt: ein Konto, keine Zahlungsdaten. Ihre Dateien werden auch
              danach nicht hochgeladen.
            </p>
            <a class="knopf-voll" href="/api/auth/login?returnToUrl=%2Fportal">Anmelden oder Konto anlegen</a>
            {fehler && (
              <p class="klein leise" style="margin-top:1rem">
                Die Mitgliederverwaltung antwortet gerade nicht
                (<code>{fehler.slice(0, 90)}</code>). Das Studio selbst läuft
                davon unabhängig.
              </p>
            )}
          </div>
        </>
      )}
    </section>
  </main>
</Grundgeruest>
