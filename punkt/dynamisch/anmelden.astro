---
/**
 * Anmelden.
 *
 * Der Knopf, der monatelang auf eine Preistabelle zeigte und deshalb zu
 * Recht als kaputt galt. Jetzt tut er, was er verspricht.
 *
 * Abgeschickt wird über `/api/anmelden` als JSON, nicht als Formular.
 * Der Grund steht in `api.ts`: Wix' Rand weist jeden
 * `application/x-www-form-urlencoded`-POST mit 403 ab. Das ist
 * nachgemessen, nicht vermutet — und es heißt, dass diese Seite auf
 * diesem Hoster JavaScript braucht. Das steht auch für den Leser da,
 * statt ihn vor einem Knopf sitzen zu lassen, der nichts tut.
 */
import Seite from '../../website/src/layouts/Seite.astro';
import Icon from '../../website/src/components/Icon.astro';
import { sitzungAus } from './konto.ts';

export const prerender = false;

// Wer schon angemeldet ist, hat hier nichts zu suchen.
const schon = await sitzungAus(Astro.request.headers);
if (schon) return Astro.redirect('/zentrale', 302);
---

<Seite
  titel="Anmelden"
  beschreibung="Anmeldung zur Zentrale: Codes verwalten, Ziele umhängen, Zahlen ansehen."
  aktiv=""
>
  <section class="spur schmal">
    <span class="tag tag-accent">
      <Icon name="team" groesse={16} />
      Zentrale
    </span>
    <h1 class="titel-seite" style="margin:14px 0 12px">Anmelden</h1>
    <p class="fliess">
      Für die Zentrale: Codes verwalten, Ziele umhängen, Zahlen ansehen. Zum
      Bauen eines Codes brauchst du das nicht — die
      <a href="/studio">Werkstatt</a> läuft ohne Konto.
    </p>

    <div class="warnung" id="fehler" hidden></div>
    <noscript>
      <div class="warnung">
        Diese Seite braucht hier JavaScript. Der Hoster weist Formular-Absendungen
        grundsätzlich ab (403), deshalb geht die Anmeldung über einen kleinen
        Aufruf im Hintergrund. Auf einem eigenen Server entfällt das.
      </div>
    </noscript>

    <form id="formular" class="tafel">
      <div class="tafel-koerper">
        <label class="feld">E-Mail
          <input class="eingabe" type="email" name="mail" autocomplete="username" required />
        </label>
        <label class="feld">Passwort
          <input class="eingabe" type="password" name="passwort" autocomplete="current-password" required />
        </label>
        <button type="submit" class="btn btn-primary knopf-gross" id="knopf">
          <Icon name="weiter" />
          Anmelden
        </button>
        <p class="hinweis">
          Es gibt hier keine Selbstregistrierung. Konten legt bis auf Weiteres
          die Hausverwaltung an — solange die Einführungsphase läuft, ist das
          eine Nachricht wert und kein Formular.
        </p>
      </div>
    </form>
  </section>
</Seite>

<script>
  const formular = document.getElementById('formular');
  const fehler = document.getElementById('fehler');
  const knopf = document.getElementById('knopf');

  function melde(text) {
    fehler.textContent = text;
    fehler.hidden = !text;
  }

  formular.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    melde('');
    knopf.disabled = true;
    const alt = knopf.innerHTML;
    knopf.innerHTML = '<span class="laeuft"></span>Wird geprüft …';
    try {
      const daten = Object.fromEntries(new FormData(formular).entries());
      const antwort = await fetch('/api/anmelden', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(daten),
      });
      const d = await antwort.json();
      if (d.ok) { window.location.href = d.weiter || '/zentrale'; return; }
      melde(d.fehler || 'Das hat nicht geklappt.');
    } catch (e) {
      melde('Der Server antwortet nicht: ' + e.message);
    }
    knopf.disabled = false;
    knopf.innerHTML = alt;
  });
</script>

<style is:global>
  .schmal { max-width: 34rem; }
  .warnung {
    background: #f7e7e5; color: #a82e23;
    border-radius: 20px; padding: 14px 18px; margin: 18px 0 0;
    font-size: 15px; line-height: 1.55;
  }
  .tafel { background: var(--color-surface); border-radius: 32px; margin-top: 22px; }
  .tafel-koerper { padding: 24px; display: flex; flex-direction: column; gap: 16px; }
  .feld {
    display: flex; flex-direction: column; gap: 6px;
    font-size: 12.5px; font-weight: 600; color: rgba(32, 30, 29, 0.62);
  }
  .eingabe {
    font: inherit; font-size: 16px; font-weight: 400; color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid color-mix(in srgb, var(--color-text) 14%, transparent);
    border-radius: 14px; padding: 12px 14px; width: 100%;
  }
  .eingabe:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 1px; }
  .hinweis { font-size: 13px; line-height: 1.55; color: rgba(32, 30, 29, 0.6); margin: 0; }
</style>
