---
/**
 * Die Zentrale: was hinter den gedruckten Codes steht.
 *
 * Der eine Vorgang, für den es dieses ganze System gibt, ist eine Zeile
 * in einem Formular: das Ziel wechseln, während das gedruckte Muster
 * bleibt. Alles andere hier ist Beiwerk.
 *
 * Abgeschickt wird über `/api/ziel` als JSON. Der Grund steht in
 * `api.ts` und ist unangenehm: Wix' Rand weist jeden Formular-POST mit
 * 403 ab, gleich wie sauber er aussieht. Auf diesem Hoster braucht das
 * Umhängen deshalb JavaScript — auf einem eigenen Server nicht.
 */
import Seite from '../../website/src/layouts/Seite.astro';
import Icon from '../../website/src/components/Icon.astro';
import { sitzungAus } from './konto.ts';
import { codesVonKonto, statistikVonCode } from './ablage.ts';

export const prerender = false;

const sitzung = await sitzungAus(Astro.request.headers);
if (!sitzung) return Astro.redirect('/anmelden', 302);

const codes = await codesVonKonto(sitzung.kontoId, 500);
codes.sort((a, b) => (b.geaendert ?? '').localeCompare(a.geaendert ?? ''));

// Zahlen der letzten 30 Tage je Code. Bewusst eine Abfrage je Code und
// nicht eine große: es sind wenige, und eine Sammelabfrage über eine
// Fremdkennung ist bei Wix-Daten nicht zuverlässig gruppierbar.
const zahlen = new Map<string, number>();
for (const c of codes) {
  try {
    const tage = await statistikVonCode(c.id, 30);
    zahlen.set(c.id, tage.reduce((summe, t) => summe + t.gesamt, 0));
  } catch {
    zahlen.set(c.id, 0);
  }
}

const host = new URL(Astro.request.url).origin;
const gesamt = [...zahlen.values()].reduce((a, b) => a + b, 0);
---

<Seite titel="Zentrale" beschreibung="Codes verwalten, Ziele umhängen, Zahlen ansehen." aktiv="">
  <section class="spur kopfreihe">
    <div>
      <span class="tag tag-accent">
        <Icon name="team" groesse={16} />
        {sitzung.name || sitzung.mail}
      </span>
      <h1 class="titel-seite" style="margin:14px 0 12px">Zentrale</h1>
      <p class="fliess">
        {codes.length === 1 ? 'Ein Code' : `${codes.length} Codes`} · {gesamt}
        {gesamt === 1 ? ' Scan' : ' Scans'} in 30 Tagen. Das Ziel wechselst du hier;
        der gedruckte Code bleibt derselbe.
      </p>
    </div>
    <button type="button" class="btn btn-secondary" id="abmelden">Abmelden</button>
  </section>

  <section class="spur">
    <div class="meldung" id="meldung" hidden></div>
    <noscript>
      <div class="meldung schlecht">
        Das Umhängen braucht hier JavaScript: der Hoster weist Formular-Absendungen
        grundsätzlich ab (403). Auf einem eigenen Server entfällt das.
      </div>
    </noscript>
  </section>

  <section class="spur">
    {codes.length === 0 ? (
      <div class="tafel leer">
        <p>
          Noch kein Code auf diesem Konto. In der <a href="/studio">Werkstatt</a>
          entstehen statische Codes ohne Konto; dynamische — die man später
          umhängen kann — legt bis auf Weiteres die Hausverwaltung an.
        </p>
      </div>
    ) : (
      <div class="karten">
        {codes.map((c) => (
          <article class="karte">
            <div class="karte-kopf">
              <div>
                <h2 class="karte-titel">{c.name || 'Ohne Bezeichnung'}</h2>
                <a class="kurzweg" href={`${host}/r/${c.kuerzel}`} target="_blank" rel="noopener">
                  /r/{c.kuerzel}
                </a>
              </div>
              <div class="karte-zahlen">
                <span class="karte-scans">{zahlen.get(c.id) ?? 0}</span>
                <span class="karte-scanwort">Scans · 30 Tage</span>
              </div>
            </div>

            <form class="zielform" data-id={c.id}>
              <label class="feld">Zeigt auf
                <input class="eingabe" type="text" name="ziel" value={c.ziel} required />
              </label>
              <button type="submit" class="btn btn-primary">Umhängen</button>
            </form>

            <p class="karte-fuss">
              {c.dynamisch ? 'Dynamisch — Ziel jederzeit änderbar.' : 'Statisch angelegt — das Ziel steht im Muster.'}
              {c.geaendert ? ` Zuletzt geändert ${c.geaendert.slice(0, 10)}.` : ''}
            </p>
          </article>
        ))}
      </div>
    )}
  </section>
</Seite>

<script>
  const meldung = document.getElementById('meldung');

  function melde(text, art) {
    meldung.textContent = text;
    meldung.className = 'meldung ' + (art || 'gut');
    meldung.hidden = !text;
    if (text) meldung.scrollIntoView({ block: 'nearest' });
  }

  document.getElementById('abmelden').addEventListener('click', async () => {
    await fetch('/api/abmelden', { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{}' });
    window.location.href = '/anmelden';
  });

  document.querySelectorAll('.zielform').forEach((formular) => {
    formular.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const knopf = formular.querySelector('button');
      const alt = knopf.textContent;
      knopf.disabled = true;
      knopf.textContent = 'wird gespeichert …';
      try {
        const antwort = await fetch('/api/ziel', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id: formular.dataset.id, ziel: formular.querySelector('[name=ziel]').value }),
        });
        const d = await antwort.json();
        if (d.ok) melde('Umgehängt. Der gedruckte Code bleibt gültig — ab sofort führt er dorthin.', 'gut');
        else melde(d.fehler || 'Das hat nicht geklappt.', 'schlecht');
      } catch (e) {
        melde('Der Server antwortet nicht: ' + e.message, 'schlecht');
      }
      knopf.disabled = false;
      knopf.textContent = alt;
    });
  });
</script>

<style is:global>
  .kopfreihe { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; flex-wrap: wrap; }
  .meldung { border-radius: 20px; padding: 14px 18px; font-size: 15px; line-height: 1.55; }
  .meldung.gut { background: var(--color-accent-2-200); color: var(--color-accent-2-800); }
  .meldung.schlecht { background: #f7e7e5; color: #a82e23; }

  .karten { display: flex; flex-direction: column; gap: 16px; }
  .karte { background: var(--color-surface); border-radius: 32px; padding: 24px 26px; }
  .karte-kopf { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap; }
  .karte-titel { font-family: var(--font-heading); font-size: 22px; letter-spacing: -0.01em; margin: 0 0 4px; }
  .kurzweg { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13.5px; color: var(--color-accent-700); }
  .karte-zahlen { text-align: right; }
  .karte-scans { display: block; font-family: var(--font-heading); font-size: 28px; line-height: 1; font-variant-numeric: tabular-nums; }
  .karte-scanwort { font-size: 12px; color: rgba(32, 30, 29, 0.6); }

  .zielform { display: flex; gap: 12px; align-items: flex-end; margin-top: 18px; flex-wrap: wrap; }
  .zielform .feld { flex: 1 1 22rem; min-width: 0; display: flex; flex-direction: column; gap: 6px;
    font-size: 12.5px; font-weight: 600; color: rgba(32, 30, 29, 0.62); }
  .eingabe {
    font: inherit; font-size: 15px; font-weight: 400; color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid color-mix(in srgb, var(--color-text) 14%, transparent);
    border-radius: 14px; padding: 11px 14px; width: 100%;
  }
  .eingabe:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 1px; }
  .karte-fuss { font-size: 13px; color: rgba(32, 30, 29, 0.6); margin: 14px 0 0; }
  .tafel.leer { background: var(--color-surface); border-radius: 32px; padding: 30px; }
  .tafel.leer p { margin: 0; font-size: 15.5px; line-height: 1.6; }
</style>
