{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "target": "ES2023"
  },
  "include": [".astro/types.d.ts", "src/**/*", "test/**/*"],
  "exclude": ["dist"]
}
