---
/*
 * Der Icon-Satz aus dem Handoff. Vierzehn Zeichen, 24×24, nur Kreise,
 * gerundete Rechtecke, Linien und Polylinien.
 *
 * Zwei Regeln aus dem Handoff, die hier im Code stehen und nicht nur im
 * Dokument: keine gefüllte Fläche außer `punkt`, und nie zwei Glyphen
 * zusammengesetzt — ein Zeichen plus ein Wort.
 *
 * `stroke-width: 2.75` ist Teil des Systems, nicht Geschmack. Wer die
 * Größe ändert, ändert die Strichstärke nicht mit: bei 16 px wirkt der
 * Strich dann kräftiger, und genau das ist gewollt.
 */
import type { IconName } from './icons';

interface Props {
  name: IconName;
  groesse?: number;
  class?: string;
}

const { name, groesse = 18, class: klasse } = Astro.props;
---

<svg
  width={groesse}
  height={groesse}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={klasse}
>
  {name === 'punkt' && <circle cx="12" cy="12" r="4.2" fill="currentColor" stroke="none" />}

  {name === 'scannen' && (
    <>
      <polyline points="3,8 3,4.5 7,4.5" />
      <polyline points="17,4.5 21,4.5 21,8" />
      <polyline points="21,16 21,19.5 17,19.5" />
      <polyline points="7,19.5 3,19.5 3,16" />
    </>
  )}

  {name === 'code' && (
    <>
      <rect x="3.5" y="3.5" width="7" height="7" rx="2" />
      <rect x="13.5" y="3.5" width="7" height="7" rx="3.5" />
      <rect x="3.5" y="13.5" width="7" height="7" rx="3.5" />
      <circle cx="17" cy="17" r="2" />
    </>
  )}

  {name === 'strecke' && (
    <>
      <circle cx="6" cy="5.5" r="2.5" />
      <circle cx="18" cy="12" r="2.5" />
      <circle cx="7" cy="18.5" r="2.5" />
      <line x1="8.4" x2="15.6" y1="6.8" y2="10.7" />
      <line x1="15.7" x2="9.3" y1="13.4" y2="17.2" />
    </>
  )}

  {name === 'etikett' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="4" />
      <circle cx="8" cy="12" r="1.6" fill="currentColor" stroke="none" />
      <line x1="12.5" x2="17.5" y1="12" y2="12" />
    </>
  )}

  {name === 'bogen' && (
    <>
      <rect x="3" y="7" width="18" height="12" rx="4" />
      <line x1="7" x2="17" y1="4" y2="4" />
    </>
  )}

  {name === 'kamera' && (
    <>
      <rect x="3" y="7" width="18" height="13" rx="4" />
      <circle cx="12" cy="13.5" r="3.4" />
      <line x1="9" x2="15" y1="4" y2="4" />
    </>
  )}

  {name === 'zahlen' && (
    <>
      <line x1="5.5" x2="5.5" y1="20" y2="13" />
      <line x1="12" x2="12" y1="20" y2="8" />
      <line x1="18.5" x2="18.5" y1="20" y2="4.5" />
    </>
  )}

  {name === 'glocke' && (
    <>
      <circle cx="12" cy="10.5" r="6" />
      <line x1="5" x2="19" y1="18.5" y2="18.5" />
    </>
  )}

  {name === 'team' && (
    <>
      <circle cx="12" cy="8" r="3.6" />
      <path d="M5.5 19.5a6.5 6.5 0 0 1 13 0" />
    </>
  )}

  {name === 'geprueft' && <polyline points="4.5,12.5 9.5,17.5 19.5,6.5" />}

  {name === 'weiter' && (
    <>
      <line x1="4" x2="17" y1="12" y2="12" />
      <polyline points="12.5,7 17.5,12 12.5,17" />
    </>
  )}

  {name === 'zeitregel' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <polyline points="12,7 12,12 15.5,14" />
    </>
  )}

  {name === 'variante' && (
    <>
      <circle cx="6.5" cy="6.5" r="3" />
      <circle cx="17.5" cy="17.5" r="3" />
      <path d="M6.5 9.5v5a3 3 0 0 0 3 3h5" />
    </>
  )}
</svg>
