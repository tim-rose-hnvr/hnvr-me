---
import { weg } from '../lib/weg';
import Icon from './Icon.astro';

const spalten = [
  {
    titel: 'Produkt',
    verweise: [
      { name: 'Werkstatt', weg: '/werkstatt' },
      { name: 'Strecken & Tests', weg: '/strecken' },
      { name: 'Vorlagen', weg: '/vorlagen' },
      { name: 'Serien & Druck', weg: '/werkstatt#serie' },
    ],
  },
  {
    titel: 'Für',
    verweise: [
      { name: 'Gastro', weg: '/vorlagen#liste-gastro' },
      { name: 'Handel', weg: '/vorlagen#liste-alle' },
      { name: 'Events', weg: '/vorlagen#liste-events' },
      { name: 'Verpackung', weg: '/vorlagen#liste-verpackung' },
    ],
  },
  {
    titel: 'Haus',
    verweise: [
      { name: 'Preise', weg: '/preise' },
      { name: 'Datenschutz', weg: '/datenschutz' },
      { name: 'Impressum', weg: '/impressum' },
      { name: 'Kontakt', weg: '/impressum#kontakt' },
    ],
  },
];
---

<footer class="fuss">
  <div class="fuss-innen">
    <div class="fuss-raster">
      <div>
        <span class="marke">
          <span class="marke-zeichen"><span class="marke-punkt"></span></span>
          <span class="marke-wort">pnkt<span class="marke-trenner">.</span>me</span>
        </span>
        <p class="fuss-text">
          Codes, die aussehen wie deine Marke — und eine Strecke dahinter, die du
          messen kannst. Ein Programm, ein Verzeichnis, nichts von außen.
        </p>
        <div class="fuss-zeichen">
          <span class="fuss-kreis"><Icon name="punkt" /></span>
          <span class="fuss-kreis"><Icon name="etikett" /></span>
          <span class="fuss-kreis"><Icon name="team" /></span>
        </div>
      </div>

      {spalten.map((s) => (
        <div>
          <div class="fuss-titel">{s.titel}</div>
          <div class="fuss-liste">
            {s.verweise.map((v) => <a href={weg(v.weg)}>{v.name}</a>)}
          </div>
        </div>
      ))}
    </div>

    <div class="fuss-leiste">
      {/* Hier standen Rechtsform und Sitz als Fuellwerte aus dem
          Entwurf. Beides war nicht bekannt. Sobald es feststeht,
          gehoert es hierher UND ins Impressum, und zwar gleichlautend.

          Als Astro-Kommentar geschrieben und nicht als HTML-Kommentar:
          ein HTML-Kommentar wird mit ausgeliefert, und dann steht die
          erfundene Angabe weiter in der Seite — nur unsichtbar. */}
      <span>© 2026 pnkt.me · [Anbieter und Sitz eintragen]</span>
      <span class="fuss-zusage">
        <Icon name="geprueft" groesse={16} />
        {/* „EU-Hosting" ist eine Aussage ueber den Server, den es noch
            nicht gibt — sie steht erst da, wenn er steht. Der zweite
            Teil gilt schon heute und folgt aus dem Code. */}
        keine Cookies, kein Tracking
      </span>
    </div>
  </div>
</footer>

<style>
  .fuss {
    background: var(--color-text);
    color: var(--color-bg);
  }
  .fuss-innen {
    max-width: 1200px;
    margin: 0 auto;
    padding: 52px 32px 40px;
  }
  .fuss-raster {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 34px;
    align-items: start;
  }

  .marke {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }
  .marke-zeichen {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--color-accent);
    display: grid;
    place-items: center;
    flex: none;
  }
  /* Auf dunklem Grund ist der innere Punkt die Grundfarbe, nicht die
     Creme des Kopfes — sonst leuchtet er heraus. */
  .marke-punkt {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--color-text);
  }
  .marke-wort {
    font-family: var(--font-heading);
    font-size: 23px;
  }
  .marke-trenner { color: var(--color-accent-400); }

  .fuss-text {
    font-size: 13.5px;
    line-height: 1.6;
    color: rgba(245, 234, 216, 0.65);
    max-width: 280px;
    margin: 0 0 18px;
  }
  .fuss-zeichen { display: flex; gap: 10px; }
  .fuss-kreis {
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid rgba(245, 234, 216, 0.3);
    display: grid;
    place-items: center;
  }

  .fuss-titel {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-400);
    margin-bottom: 14px;
  }
  .fuss-liste {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .fuss-liste a {
    font-size: 13.5px;
    color: rgba(245, 234, 216, 0.75);
    text-decoration: none;
  }
  .fuss-liste a:hover {
    color: var(--color-bg);
    text-decoration: underline;
  }

  .fuss-leiste {
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid rgba(245, 234, 216, 0.16);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    font-size: 12.5px;
    color: rgba(245, 234, 216, 0.5);
  }
  .fuss-zusage {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  @media (max-width: 900px) {
    .fuss-raster { grid-template-columns: 1fr 1fr; gap: 28px; }
    .fuss-innen { padding: 40px 20px 32px; }
  }
  @media (max-width: 560px) {
    .fuss-raster { grid-template-columns: 1fr; }
    .fuss-leiste { flex-direction: column; align-items: flex-start; gap: 10px; }
  }
</style>
