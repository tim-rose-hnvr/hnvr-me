---
import { weg } from '../lib/weg';
import Icon from './Icon.astro';

interface Props {
  aktiv?: 'start' | 'studio' | 'werkstatt' | 'strecken' | 'vorlagen' | 'preise' | '';
}
const { aktiv = 'start' } = Astro.props;

// „Anmelden" gibt es nur dort, wo eine Laufzeit antwortet. Auf der
// statischen Fassung — GitHub Pages, Einzeldatei — führte der Knopf ins
// Leere, und genau das war die Beschwerde, mit der diese Runde anfing.
// PUBLIC_, damit Vite den Wert beim Bauen einsetzt: bei SSR würde die
// Zeile sonst erst beim Aufruf ausgewertet, auf dem fremden Server.
const dynamisch = import.meta.env.PUBLIC_DYNAMISCH === '1';

const wege = [
  // Das Studio steht vorn: es ist die einzige Seite, auf der man etwas
  // tun kann statt darüber zu lesen.
  { id: 'studio', weg: '/studio', name: 'Code bauen', icon: 'code' as const },
  { id: 'werkstatt', weg: '/werkstatt', name: 'Werkstatt', icon: 'geprueft' as const },
  { id: 'strecken', weg: '/strecken', name: 'Strecken', icon: 'strecke' as const },
  { id: 'vorlagen', weg: '/vorlagen', name: 'Vorlagen', icon: 'bogen' as const },
  { id: 'preise', weg: '/preise', name: 'Preise', icon: 'zahlen' as const },
];
---

<header class="kopf">
  <div class="kopf-innen">
    <a href={weg('/')} class="marke" aria-label="pnkt.me, zur Startseite">
      <span class="marke-zeichen"><span class="marke-punkt"></span></span>
      <span class="marke-wort">pnkt<span class="marke-trenner">.</span>me</span>
    </a>

    <nav class="wege" aria-label="Hauptnavigation">
      {wege.map((w) => (
        <a
          href={weg(w.weg)}
          class:list={['weg', { 'weg-aktiv': aktiv === w.id }]}
          aria-current={aktiv === w.id ? 'page' : undefined}
        >
          <Icon name={w.icon} />
          {w.name}
        </a>
      ))}
    </nav>

    {/* Hier stand einmal „Anmelden" und daneben „Kostenlos starten".
        Beide zeigten auf die Preisseite und versprachen etwas, das es
        nicht gab: kein Konto, keine Anmeldung. Wer klickte, landete auf
        einer Preistabelle — für den Leser sieht das aus, als sei der
        Knopf kaputt. Deshalb standen sie eine Zeit lang gar nicht da.

        Jetzt gibt es beides wirklich, aber nur, wo eine Laufzeit
        antwortet. Die statische Fassung — auf einem Stick, in einer
        Datei — zeigt weiter nur den ehrlichen Hinweis. */}
    <span class="kopf-rechts">
      {dynamisch ? (
        <>
          <a href={weg('/zentrale')} class="anmelden">Zentrale</a>
          <a href={weg('/anmelden')} class="anmelden">Anmelden</a>
          <a href={weg('/anmelden?neu=1')} class="btn btn-primary kopf-knopf">
            <Icon name="zahlen" />
            Kostenlos starten
          </a>
        </>
      ) : (
        <a href={weg('/preise')} class="btn btn-primary kopf-knopf">
          <Icon name="zahlen" />
          Zurzeit kostenlos
        </a>
      )}
    </span>
  </div>
</header>

<style>
  .kopf {
    background: var(--color-bg);
    border-bottom: 1px solid rgba(32, 30, 29, 0.1);
  }
  .kopf-innen {
    max-width: 1200px;
    margin: 0 auto;
    padding: 18px 32px;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .marke {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--color-text);
    margin-right: auto;
  }
  .marke-zeichen {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--color-accent);
    display: grid;
    place-items: center;
    flex: none;
  }
  .marke-punkt {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--color-bg);
  }
  .marke-wort {
    font-family: var(--font-heading);
    font-size: 23px;
    letter-spacing: -0.01em;
  }
  .marke-trenner { color: var(--color-accent); }

  .wege {
    display: flex;
    gap: 22px;
    align-items: center;
  }
  .weg {
    display: flex;
    align-items: center;
    gap: 7px;
    text-decoration: none;
    font-size: 14.5px;
    font-weight: 500;
    /* Der Körpertext im Akzent muss accent-700 sein: die Grundfarbe
       schafft nur 3:1 gegen den Grund. Steht so im Handoff. */
    color: rgba(32, 30, 29, 0.78);
  }
  .weg-aktiv {
    color: var(--color-accent-700);
    font-weight: 700;
  }
  .weg:hover { color: var(--color-text); }

  .kopf-rechts {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .anmelden {
    font-size: 14.5px;
    text-decoration: none;
    color: rgba(32, 30, 29, 0.7);
    white-space: nowrap;
  }
  .anmelden:hover { color: var(--color-text); }
  .kopf-knopf {
    padding: 11px 20px;
    text-decoration: none;
    gap: 8px;
  }

  /* Auf schmalen Geräten fällt die Wegeleiste unter die Marke, statt sie
     zu quetschen. Ein zusammengeschobenes Menü mit 11-px-Text liest
     niemand — und die Marketingseite wird zur Hälfte am Telefon gelesen. */
  @media (max-width: 900px) {
    .kopf-innen {
      flex-wrap: wrap;
      gap: 14px 20px;
      padding: 14px 20px;
    }
    .marke { margin-right: 0; }
    .kopf-rechts { margin-left: auto; }
    .wege {
      order: 3;
      width: 100%;
      gap: 18px;
      overflow-x: auto;
      padding-bottom: 2px;
      scrollbar-width: none;
    }
    .wege::-webkit-scrollbar { display: none; }
    .weg { flex: none; }
  }
  @media (max-width: 560px) {
    .kopf-knopf { padding: 10px 16px; font-size: 14px; }
  }
</style>
