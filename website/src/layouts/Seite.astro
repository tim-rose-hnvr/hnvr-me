---
import { weg } from '../lib/weg';
import '../styles/organic.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  titel: string;
  beschreibung: string;
  aktiv?: 'start' | 'werkstatt' | 'strecken' | 'vorlagen' | 'preise';
}
const { titel, beschreibung, aktiv = 'start' } = Astro.props;
const kanonisch = new URL(Astro.url.pathname, Astro.site ?? 'https://pnkt.me');

// Vorschau: solange Impressum und Datenschutzerklärung Lücken haben,
// darf die Seite nicht auftreten, als wäre sie ein fertiges Angebot.
// Sie bekommt dann einen Riegel oben und ein noindex — auffindbar soll
// sie erst sein, wenn die Pflichtangaben stehen.
//
// Gelesen aus process.env und nicht aus import.meta.env: Astro reicht
// dort nur PUBLIC_-Variablen durch, und der Riegel soll nicht im
// Browser landen, sondern beim Bauen entscheiden.
//
// Gesteuert über die Umgebung, nicht über eine Datei: der Zielstand
// unter pnkt.me setzt VORSCHAU einfach nicht.
const vorschau = process.env.VORSCHAU === '1';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{titel} · pnkt.me</title>
    <!-- Ohne Favicon holt jeder Browser /favicon.ico, bekommt 404 und
         schreibt es in die Konsole. Das ist harmlos, verdeckt aber
         echte Fehler — und ein leerer Tab sieht nach Baustelle aus. -->
    <link rel="icon" href={weg('/marke.svg')} type="image/svg+xml" />
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={kanonisch.href} />

    <!-- Die beiden Schnitte, die im ersten Bild stehen: Überschrift und
         Fließtext. Der Rest kommt nach, wenn er gebraucht wird. -->
    <link rel="preload" href={weg('/schrift/caprasimo-400-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={weg('/schrift/figtree-400-latin.woff2')} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${titel} · pnkt.me`} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:locale" content="de_DE" />
    <meta name="theme-color" content="#f5ead8" />
    {vorschau && <meta name="robots" content="noindex,nofollow" />}
  </head>

  <body>
    <a href="#inhalt" class="ueberspringen">Zum Inhalt</a>
    {vorschau && (
      <div class="vorschauriegel">
        <b>Vorschau.</b> Impressum und Datenschutzerklärung sind noch nicht
        vollständig — diese Seite ist noch kein Angebot.
      </div>
    )}
    <SiteNav aktiv={aktiv} />
    <main id="inhalt">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style is:global>
  /* ─── Gemeinsames für alle Marketingseiten ───────────────────────────
     Die Entwürfe tragen ihre Werte inline; hier stehen sie einmal.
     Grundregel des Handoffs: eine Bewegung je Handlung, und mit
     prefers-reduced-motion bleibt nur das Überblenden. */

  .ueberspringen {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--color-text);
    color: var(--color-bg);
    padding: 10px 18px;
    border-radius: 0 0 var(--radius-md) 0;
    z-index: 20;
  }
  .ueberspringen:focus { left: 0; }

  :where(a, button, input, [tabindex]):focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .spur {
    max-width: 1200px;
    margin: 0 auto;
    padding: 44px 32px 64px;
  }
  @media (max-width: 700px) {
    .spur { padding: 28px 20px 44px; }
  }

  /* Überschriften der Marketingseiten laufen größer als im System und
     ziehen die Laufweite an. */
  .titel-gross { font-size: 70px; line-height: 1.02; letter-spacing: -0.02em; text-wrap: balance; margin: 0; }
  .titel-seite { font-size: 56px; line-height: 1.04; letter-spacing: -0.02em; text-wrap: balance; margin: 0; }
  .titel-liste { font-size: 54px; line-height: 1.05; letter-spacing: -0.02em; text-wrap: balance; margin: 0; }
  .titel-block { font-size: 44px; letter-spacing: -0.02em; margin: 0 0 26px; }
  .titel-panel { font-size: 38px; letter-spacing: -0.02em; margin: 0 0 14px; }

  @media (max-width: 900px) {
    .titel-gross { font-size: 46px; }
    .titel-seite { font-size: 40px; }
    .titel-liste { font-size: 38px; }
    .titel-block { font-size: 32px; }
    .titel-panel { font-size: 28px; }
  }

  /* Der Basis-.tag ist fuer die Anwendung gemacht: 11 px, kein Abstand,
     12 px Radius. Auf den Marketingseiten gibt der Entwurf 12,5 px, ein
     16-px-Zeichen und eine volle Pille vor. */
  .tag {
    gap: 8px;
    font-size: 12.5px;
    padding: 7px 15px;
    border-radius: 999px;
  }

  .kicker {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-700);
    margin-bottom: 10px;
  }
  .kicker-hell { color: var(--color-accent-400); }

  .fliess {
    font-size: 18px;
    line-height: 1.6;
    color: rgba(32, 30, 29, 0.72);
    max-width: 500px;
  }
  .fliess-klein { font-size: 15.5px; line-height: 1.6; color: rgba(32, 30, 29, 0.72); }

  .knopfreihe { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }
  .knopf-gross { padding: 15px 26px; font-size: 16px; text-decoration: none; gap: 9px; }

  /* Karten heben beim Überfahren. Eine Bewegung, 280 ms, die Kurve des
     Systems. */
  .hebt { transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .hebt:hover { transform: translateY(-5px); }

  .panel {
    background: var(--color-surface);
    border-radius: 44px;
    padding: 36px 38px;
  }
  .panel-dunkel {
    background: var(--color-text);
    color: var(--color-bg);
    border-radius: 44px;
    padding: 40px;
  }
  @media (max-width: 700px) {
    .panel, .panel-dunkel { border-radius: 32px; padding: 24px 22px; }
  }

  /* ─── Bewegung ────────────────────────────────────────────────────── */
  @keyframes sweep {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(1100%); }
  }
  @keyframes bloom {
    0%, 100% { transform: scale(0.2); opacity: 0.35; }
    50% { transform: scale(1); opacity: 1; }
  }
  @keyframes flow {
    0% { left: 0; opacity: 0; }
    12% { opacity: 1; }
    88% { opacity: 1; }
    100% { left: calc(100% - 10px); opacity: 0; }
  }
  @keyframes spinslow { to { transform: rotate(360deg); } }
  @keyframes pushin {
    0% { transform: translateY(-130%) rotate(2deg); opacity: 0; }
    18%, 82% { transform: translateY(0) rotate(0deg); opacity: 1; }
    100% { transform: translateY(-130%) rotate(2deg); opacity: 0; }
  }
  @keyframes breathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.06); }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Alles, was sich fortbewegt, wird still. Überblenden bleibt. */
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
    .hebt:hover { transform: none; }
  }
</style>
