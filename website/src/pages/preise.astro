---
import { weg } from '../lib/weg';
import Seite from '../layouts/Seite.astro';
import Icon from '../components/Icon.astro';

// Diese Seite hat sich zweimal geändert, und beide Male aus demselben
// Grund: sie hat behauptet, was es nicht gibt.
//
// Im Entwurf standen vier Tarife mit Preisen (29 €, 89 €), ein
// Abrechnungsschalter „Monatlich / Jährlich −2 Monate" und Merkmale wie
// A/B-Tests und SSO. Es gibt weder eine Abrechnung noch eine Anmeldung,
// und A/B-Tests stehen auf der Streckenseite ausdrücklich als geplant.
// Vier Preise für einen Dienst, den man nicht buchen kann, sind keine
// Preisliste — das ist Kulisse.
//
// Was stimmt: in der Einführungsphase ist alles kostenlos. Genau das
// steht jetzt hier, samt der Einschränkung, dass es befristet ist. Was
// später kostet, steht nicht fest, und eine erfundene Zahl wäre nach
// § 5 UWG angreifbar — eine Preisangabe ist eine geschäftliche Aussage,
// auch wenn sie in die Zukunft zeigt.

// Was es heute wirklich gibt. Jede Zeile lässt sich im Programm
// wiederfinden — das ist die Bedingung dafür, dass sie hier steht.
const dabei = [
  { titel: 'Codes, so viele du brauchst',
    text: 'Keine Obergrenze in der Einführungsphase, auch nicht bei Serien aus einer Tabelle.' },
  { titel: 'Ziel jederzeit tauschen',
    text: 'Der gedruckte Code bleibt derselbe. Jede Änderung ist eine neue Fassung, alte lassen sich zurückholen.' },
  { titel: 'Prüfliste vor dem Druck',
    text: 'Kontrast, Ruhezone, Modulgröße, Fehlerkorrektur gegen Logo — mit Begründung, nicht nur mit Ampel.' },
  { titel: 'Export ohne Wasserzeichen',
    text: 'SVG, PDF und EPS als echter Vektor in Millimetermaß. Auch Bogen zum Schneiden.' },
  { titel: 'Landeseiten',
    text: 'Karte, Programm, Wegweiser, Produktpass — kommen aus dem Server und laden nichts nach.' },
  { titel: 'Zahlen, die stimmen',
    text: 'Gezählt wird der Scan und der Knopfdruck. Weiter reicht die Messung nicht, und weiter wird nichts behauptet.' },
];

// Der geplante Aufbau. Bewusst ohne Preise: was die Stufen später
// kosten, ist nicht entschieden.
const stufen = [
  { name: 'Klein', fuer: 'Ein Tisch, ein Schaufenster, eine Karte.',
    inhalt: 'Codes, Landeseite, Prüfliste, Zahlen.', stand: 'da' },
  { name: 'Laden', fuer: 'Ein Betrieb mit Karte, Aktionen und Aufstellern.',
    inhalt: 'Dazu alle Stile, alle Vorlagen, Serien und Druckdaten.', stand: 'da' },
  { name: 'Team', fuer: 'Mehrere Filialen, mehrere Hände.',
    inhalt: 'Dazu Mitarbeitende, eigener Host, Verlauf je Code.', stand: 'teils' },
  { name: 'Serie', fuer: 'Verpackung und Etikett in Auflage.',
    inhalt: 'Dazu Produktpass, GS1 Digital Link, Schnittstelle.', stand: 'da' },
];

const fragen = [
  {
    frage: 'Was heißt „begrenzt"?',
    antwort: 'Die Einführungsphase endet, wenn der Dienst öffentlich läuft. Ein Datum steht ' +
      'nicht fest, und ich schreibe keines hin, das ich nicht halten kann. Sie endet mit ' +
      'Ankündigung, nicht über Nacht.',
  },
  {
    frage: 'Kann ich mich anmelden?',
    antwort: 'Noch nicht. Es gibt kein Konto und keine Anmeldung, weil der Dienst noch auf ' +
      'keinem öffentlichen Server läuft. Deshalb steht in der Kopfzeile auch kein ' +
      'Anmeldeknopf mehr — er hätte nichts getan.',
  },
  {
    frage: 'Was kostet es später?',
    antwort: 'Das steht nicht fest. Eine Zahl hier hinzuschreiben wäre einfach und falsch.',
  },
  {
    frage: 'Was passiert mit Codes, die jetzt entstehen?',
    antwort: 'Ein gedruckter Code bleibt lesbar. Das ist der Kern des Systems: das Muster ' +
      'ändert sich nie, nur das Ziel dahinter.',
  },
  {
    frage: 'Zählt jeder Scan?',
    antwort: 'Gezählt wird der Aufruf des Kurzwegs. Eine Vorschau zählt nicht mit, und der ' +
      'Knopf auf einer Landeseite zählt getrennt — nicht als zweiter Scan.',
  },
];
---

<Seite
  titel="Preise"
  beschreibung="In der Einführungsphase ist alles kostenlos — ohne Obergrenze und ohne Wasserzeichen. Was es später kostet, steht noch nicht fest."
  aktiv="preise"
>
  <section class="spur">
    <span class="tag tag-accent">
      <Icon name="zahlen" groesse={16} />
      Einführungsphase
    </span>
    <h1 class="titel-liste" style="margin:14px 0 14px">Zurzeit kostet es nichts</h1>
    <p class="fliess" style="font-size:17px">
      Alles, was es gibt, ist gerade für alle offen — ohne Obergrenze, ohne
      Wasserzeichen, ohne Karte. Das ist ein <b>befristetes Angebot</b> und kein
      Dauerzustand: es läuft, solange der Dienst nicht öffentlich steht.
    </p>

    <div class="angebot">
      <div class="angebot-zahl">
        <span class="angebot-preis">0 €</span>
        <span class="angebot-dazu">für alles, was steht</span>
      </div>
      <div class="angebot-text">
        <p>
          <b>Was daran begrenzt ist:</b> die Zeit, nicht der Umfang. Die Phase endet,
          wenn der Dienst öffentlich läuft — mit Ankündigung, nicht über Nacht.
        </p>
        <p class="angebot-klein">
          Ein Enddatum steht hier bewusst nicht. Ich kenne es nicht, und ein
          erfundener Countdown wäre eine Werbeaussage, die niemand halten kann.
        </p>
      </div>
    </div>
  </section>

  <section class="spur">
    <div class="panel">
      <div class="kicker">Im Angebot enthalten</div>
      <h2 class="titel-panel">Alles, was heute läuft</h2>
      <div class="dabei-raster">
        {dabei.map((d) => (
          <div class="dabei">
            <span class="dabei-zeichen"><Icon name="geprueft" groesse={17} /></span>
            <div class="dabei-titel">{d.titel}</div>
            <p class="dabei-text">{d.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="spur">
    <div class="panel">
      <div class="kicker">Später</div>
      <h2 class="titel-panel">Wie es einmal aufgeteilt sein soll</h2>
      <p class="fliess-klein" style="margin:0 0 20px;max-width:44rem">
        Vier Stufen, von einem Tisch bis zur Auflage. Ohne Preise: was sie kosten,
        ist nicht entschieden. <b>Solange die Einführungsphase läuft, spielt diese
        Aufteilung keine Rolle</b> — offen ist alles.
      </p>
      <div class="stufen">
        {stufen.map((s) => (
          <article class="stufe">
            <div class="stufe-kopf">
              <span class="stufe-name">{s.name}</span>
              <span class:list={['stufe-stand', `stand-${s.stand}`]}>
                {s.stand === 'da' ? 'gebaut' : 'teils gebaut'}
              </span>
            </div>
            <p class="stufe-fuer">{s.fuer}</p>
            <p class="stufe-inhalt">{s.inhalt}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="spur schluss">
    <div>
      <h2 class="titel-block" style="font-size:34px;margin-bottom:18px">Häufige Fragen</h2>
      <div class="fragen">
        {fragen.map((f) => (
          <div class="frage">
            <h3 class="frage-titel">{f.frage}</h3>
            <p>{f.antwort}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="panel-dunkel abschluss">
      <span class="marke">
        <span class="marke-zeichen"><span class="marke-punkt"></span></span>
        <span class="marke-wort">pnkt<span class="marke-trenner">.</span>me</span>
      </span>
      <h2 style="font-size:32px;letter-spacing:-.02em;margin:18px 0 12px">
        Ansehen kostet auch nichts
      </h2>
      <p class="abschluss-text">
        Die Werkstatt zeigt, was ein Code hier kann — Stile, Prüfliste, Serien.
        Anmelden musst du dich dafür nicht; du kannst es auch nicht.
      </p>
      <a href={weg('/werkstatt')} class="btn btn-primary knopf-gross">
        <Icon name="code" />
        Werkstatt ansehen
      </a>
    </div>
  </section>
</Seite>

<style>
  .angebot {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 30px;
    align-items: center;
    background: var(--color-surface);
    border-radius: 36px;
    padding: 30px 34px;
    margin-top: 28px;
  }
  .angebot > * { min-width: 0; }
  .angebot-zahl { display: flex; flex-direction: column; gap: 2px; }
  .angebot-preis {
    font-family: var(--font-heading);
    font-size: 68px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-accent-700);
  }
  .angebot-dazu { font-size: 13.5px; color: rgba(32, 30, 29, 0.6); }
  .angebot-text p { font-size: 15.5px; line-height: 1.65; margin: 0 0 10px; }
  .angebot-klein { font-size: 14px; color: rgba(32, 30, 29, 0.6); margin: 0 !important; }

  .dabei-raster {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px 30px;
  }
  .dabei > * { min-width: 0; }
  .dabei-zeichen {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: var(--color-accent-2-200);
    color: var(--color-accent-2-800);
    margin-bottom: 10px;
  }
  .dabei-titel {
    font-family: var(--font-heading);
    font-size: 18px;
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }
  .dabei-text { font-size: 14.5px; line-height: 1.6; color: rgba(32, 30, 29, 0.7); margin: 0; }

  .stufen {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .stufe {
    min-width: 0;
    background: var(--color-bg);
    border-radius: 26px;
    padding: 22px 22px 24px;
  }
  .stufe-kopf {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
  }
  .stufe-name { font-family: var(--font-heading); font-size: 21px; letter-spacing: -0.01em; }
  .stufe-stand {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 4px 9px;
    white-space: nowrap;
  }
  .stand-da { background: var(--color-accent-2-200); color: var(--color-accent-2-800); }
  .stand-teils { background: var(--color-accent-200); color: var(--color-accent-800); }
  .stufe-fuer { font-size: 14.5px; line-height: 1.55; margin: 0 0 8px; }
  .stufe-inhalt { font-size: 14px; line-height: 1.55; color: rgba(32, 30, 29, 0.65); margin: 0; }

  .schluss {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 26px;
    align-items: start;
  }
  .schluss > * { min-width: 0; }
  .fragen { display: flex; flex-direction: column; gap: 18px; }
  .frage-titel { font-family: var(--font-heading); font-size: 19px; margin: 0 0 6px; }
  .frage p { font-size: 15px; line-height: 1.65; color: rgba(32, 30, 29, 0.72); margin: 0; }

  .abschluss { text-align: left; }
  .abschluss .marke { display: flex; align-items: center; gap: 10px; }
  .abschluss .marke-zeichen {
    width: 32px; height: 32px; border-radius: 999px;
    background: var(--color-accent); display: grid; place-items: center;
  }
  .abschluss .marke-punkt {
    width: 10px; height: 10px; border-radius: 999px; background: var(--color-text);
  }
  .abschluss .marke-wort { font-family: var(--font-heading); font-size: 23px; }
  .abschluss .marke-trenner { color: var(--color-accent-400); }
  .abschluss-text {
    font-size: 15px;
    line-height: 1.65;
    color: rgba(245, 234, 216, 0.78);
    margin: 0 0 20px;
    max-width: 30rem;
  }

  @media (max-width: 1000px) {
    .stufen { grid-template-columns: repeat(2, 1fr); }
    .dabei-raster { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .angebot { grid-template-columns: 1fr; gap: 18px; padding: 24px 22px; }
    .angebot-preis { font-size: 54px; }
    .stufen, .dabei-raster, .schluss { grid-template-columns: 1fr; }
  }
</style>
