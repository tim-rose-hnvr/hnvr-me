---
import { weg } from '../lib/weg';
import Seite from '../layouts/Seite.astro';
import Icon from '../components/Icon.astro';

// Die Werkstatt, in der wirklich ein Code entsteht.
//
// Bis hierher war jede Seite eine Seite ÜBER das Programm. Diese ist
// das Programm: derselbe Go-Kern, nach WebAssembly übersetzt, läuft im
// Browser des Lesers. Kodieren, formen, beurteilen, als SVG, PDF und
// EPS ausgeben — alles hier, ohne Server, ohne Konto, ohne Abruf.
//
// Was hier fehlt und auch nicht hingehört: dynamische Codes, Zentrale,
// Zählung. Ein Code, dessen Ziel man später tauschen kann, braucht eine
// Adresse, die jemand beantwortet — also einen Server. Der steht noch
// nicht. Statische Codes sind dafür vollständig: sie funktionieren
// ohne alles, für immer.
//
// Die Bedienung folgt der Werkstatt aus dem Go-Programm, weil die
// bereits eingerichtet ist und derselben Gestaltung folgt.

const modulformen = [
  { wert: 'quadrat', name: 'Quadrat' },
  { wert: 'rund', name: 'Rund' },
  { wert: 'weich', name: 'Weich' },
  { wert: 'punkt', name: 'Punkt' },
  { wert: 'mosaik', name: 'Mosaik' },
  { wert: 'fliessend', name: 'Fließend' },
  { wert: 'tropfen', name: 'Tropfen' },
  { wert: 'raute', name: 'Raute' },
];

const augenrahmen = [
  { wert: 'quadrat', name: 'Quadrat', rat: 'gemessen: 40 von 40 gelesen' },
  { wert: 'kissen', name: 'Kissen', rat: 'gemessen: 40 von 40 gelesen' },
  { wert: 'rund', name: 'Rund', rat: 'gemessen: 0 von 40 gelesen' },
  { wert: 'blatt', name: 'Blatt', rat: 'gemessen: 0 von 40 gelesen' },
];

const augenkerne = [
  { wert: 'quadrat', name: 'Quadrat' },
  { wert: 'rund', name: 'Rund' },
  { wert: 'punkt', name: 'Punkt' },
  { wert: 'weich', name: 'Weich' },
];

// Die Farben sind die des Hauses. Wer eine eigene Marke hat, trägt sie
// im Feld daneben ein — die Prüfung rechnet den Kontrast sofort nach.
const farben = [
  { wert: '#201e1d', name: 'Tinte' },
  { wert: '#8c491a', name: 'Terrakotta' },
  { wert: '#4a5638', name: 'Salbei' },
  { wert: '#1f3a5f', name: 'Tiefblau' },
  { wert: '#000000', name: 'Schwarz' },
];

const typen = [
  { wert: 'url', name: 'Adresse' },
  { wert: 'text', name: 'Text' },
  { wert: 'vcard', name: 'Visitenkarte' },
  { wert: 'wlan', name: 'WLAN' },
  { wert: 'giro', name: 'Überweisung' },
];
---

<Seite
  titel="Werkstatt"
  beschreibung="Einen QR-Code bauen, prüfen und als SVG, PDF oder EPS mitnehmen — im Browser, ohne Konto und ohne dass etwas den Rechner verlässt."
  aktiv="studio"
>
  <section class="spur kopf">
    <div>
      <span class="tag tag-accent">
        <Icon name="code" groesse={16} />
        Werkstatt
      </span>
      <h1 class="titel-seite" style="margin:14px 0 12px">Bau deinen Code</h1>
      <p class="fliess">
        Läuft im Browser. Kein Konto, keine Anmeldung, und nichts verlässt
        diesen Rechner — auch der fertige Code nicht, bis du ihn herunterlädst.
      </p>
    </div>
    <div class="stand" id="stand" role="status">
      <span class="stand-punkt"></span>
      <span id="standtext">Kern wird geladen …</span>
    </div>
  </section>

  <section class="spur werkbank">
    <!-- Vorschau -->
    <div class="tafel vorschautafel">
      <div class="tafel-kopf">
        <span>Vorschau</span>
        <span id="masse" class="zahl"></span>
      </div>
      <div class="vorschau" id="vorschau">
        <div class="suchlinie" id="suchlinie" hidden></div>
        <div id="bild" class="bild" aria-label="Vorschau des Codes"></div>
      </div>

      <div class="urteilzeile">
        <span id="urteil"></span>
        <div class="zahlen" id="zahlen"></div>
      </div>
      <div id="befunde" class="befunde"></div>

      <div class="holen">
        <button type="button" class="btn btn-primary" data-holen="svg">SVG</button>
        <button type="button" class="btn btn-primary" data-holen="pdf">PDF</button>
        <button type="button" class="btn btn-secondary" data-holen="eps">EPS</button>
        <button type="button" class="btn btn-secondary" data-holen="png">PNG 2048</button>
      </div>
      <p class="hinweis">
        SVG, PDF und EPS sind echter Vektor in Millimetermaß. PNG rechnet der
        Browser aus demselben SVG — für den Druck nimmt man es nicht.
      </p>

      {/* Varianten-Filmstreifen (3a). Nebeneinander sieht man
          Unterschiede in der Modulform sofort, die man einzeln
          übersieht. Bewusst OHNE Scanrate darunter: die stünde im
          Entwurf, wäre aber erfunden — dieselbe Nutzlast ergibt
          denselben Code, und was ein fremder Scanner damit macht,
          misst dieser Rechner nicht. */}
      <div class="streifen">
        <div class="streifen-kopf">
          <span>Varianten</span>
          <button type="button" class="streifen-neu" id="variante-neu">+ diese sichern</button>
        </div>
        <div class="streifen-band" id="streifen"></div>
        <p class="hinweis" id="streifen-leer">
          Noch keine. Sichere eine Gestaltung, ändere etwas, und leg beide
          nebeneinander — die Unterschiede sieht man erst im Vergleich.
        </p>
      </div>
    </div>

    <!-- Regler -->
    <div class="tafel reglertafel">
      {/* Werkzeuge als runde Chips in einer Leiste, eine Schublade
          offen — so steht es im Handoff unter 2b. Der Unterschied zum
          Reiter ist nicht die Form: eine Schublade lässt sich auch
          zuklappen, und dann ist die Vorschau allein da. Genau das
          will man, wenn man den Code ansieht statt ihn zu bauen. */}
      <div class="chips" role="tablist" aria-label="Werkzeuge">
        <button type="button" class="chip chip-aktiv" data-lade="inhalt" role="tab" aria-selected="true">
          <Icon name="etikett" groesse={15} />Inhalt
        </button>
        <button type="button" class="chip" data-lade="form" role="tab" aria-selected="false">
          <Icon name="code" groesse={15} />Punkte & Ecken
        </button>
        <button type="button" class="chip" data-lade="farbe" role="tab" aria-selected="false">
          <Icon name="punkt" groesse={15} />Farbe
        </button>
        <button type="button" class="chip" data-lade="druck" role="tab" aria-selected="false">
          <Icon name="bogen" groesse={15} />Druck
        </button>
      </div>

      <div class="tafel-koerper">
        <!-- Inhalt -->
        <div class="lade" data-lade="inhalt">
          <label class="feld">Was soll der Code enthalten?
            <select class="eingabe" id="typ">
              {typen.map((t) => <option value={t.wert}>{t.name}</option>)}
            </select>
          </label>

          <div data-typfeld="url text">
            <label class="feld">Inhalt
              <input class="eingabe" id="text" value="https://example.de/aktion" />
            </label>
          </div>

          <div data-typfeld="vcard" hidden>
            <div class="paar">
              <label class="feld">Vorname<input class="eingabe" data-vcard="vorname" /></label>
              <label class="feld">Nachname<input class="eingabe" data-vcard="nachname" /></label>
            </div>
            <div class="paar">
              <label class="feld">Firma<input class="eingabe" data-vcard="firma" /></label>
              <label class="feld">Stellung<input class="eingabe" data-vcard="stellung" /></label>
            </div>
            <div class="paar">
              <label class="feld">Telefon<input class="eingabe" data-vcard="telefon" /></label>
              <label class="feld">E-Mail<input class="eingabe" data-vcard="mail" /></label>
            </div>
          </div>

          <div data-typfeld="wlan" hidden>
            <label class="feld">Netzname (SSID)<input class="eingabe" data-wlan="ssid" /></label>
            <div class="paar">
              <label class="feld">Passwort<input class="eingabe" data-wlan="passwort" /></label>
              <label class="feld">Verschlüsselung
                <select class="eingabe" data-wlan="art">
                  <option value="WPA">WPA / WPA2</option>
                  <option value="WEP">WEP</option>
                  <option value="nopass">offen</option>
                </select>
              </label>
            </div>
          </div>

          <div data-typfeld="giro" hidden>
            <label class="feld">Empfänger<input class="eingabe" data-giro="empfaenger" /></label>
            <div class="paar">
              <label class="feld">IBAN<input class="eingabe" data-giro="iban" placeholder="DE…" /></label>
              <label class="feld">Betrag in Euro<input class="eingabe" data-giro="betrag" placeholder="12,50" /></label>
            </div>
            <label class="feld">Verwendungszweck<input class="eingabe" data-giro="zweck" /></label>
            <p class="hinweis">
              Die IBAN wird nach ISO 7064 geprüft, bevor ein Code entsteht — eine
              falsche Prüfsumme fällt hier auf und nicht erst beim Bezahlen.
            </p>
          </div>

          <p class="hinweis" id="laenge"></p>
        </div>

        <!-- Form -->
        <div class="lade" data-lade="form" hidden>
          <div class="feldname">Module</div>
          <div class="wahl" id="modulform">
            {modulformen.map((m, i) => (
              <button type="button" class:list={['wahlknopf', { 'wahl-aktiv': i === 0 }]} data-wert={m.wert}>{m.name}</button>
            ))}
          </div>

          <div class="feldname">Rahmen der Augen</div>
          <div class="wahl" id="augenrahmen">
            {augenrahmen.map((a, i) => (
              <button type="button" class:list={['wahlknopf', { 'wahl-aktiv': i === 0 }]} data-wert={a.wert} title={a.rat}>{a.name}</button>
            ))}
          </div>
          <p class="hinweis">
            Runde Augen wurden in unserer Messung von einem verbreiteten Decoder
            in keinem von 40 Fällen gelesen. Verboten ist es nicht — die Prüfung
            warnt, die Entscheidung bleibt bei dir.
          </p>

          <div class="feldname">Kern der Augen</div>
          <div class="wahl" id="augenkern">
            {augenkerne.map((a, i) => (
              <button type="button" class:list={['wahlknopf', { 'wahl-aktiv': i === 0 }]} data-wert={a.wert}>{a.name}</button>
            ))}
          </div>

          <label class="feld">Aussparung in der Mitte für ein Logo
            <input type="range" id="logo" min="0" max="0.3" step="0.01" value="0" />
            <span class="zahl" id="logo-wert">0 %</span>
          </label>
        </div>

        <!-- Farbe -->
        <div class="lade" data-lade="farbe" hidden>
          <div class="feldname">Code</div>
          <div class="wahl" id="vordergrund">
            {farben.map((f, i) => (
              <button type="button" class:list={['farbknopf', { 'wahl-aktiv': i === 0 }]} data-wert={f.wert} title={f.name}>
                <span class="farbfleck" style={`background:${f.wert}`}></span>
                {f.name}
              </button>
            ))}
          </div>
          <div class="paar">
            <label class="feld">Eigene Farbe
              <input class="eingabe" id="vordergrund-hex" value="#201e1d" />
            </label>
            <label class="feld">Hintergrund
              <input class="eingabe" id="hintergrund-hex" value="#ffffff" />
            </label>
          </div>
          <p class="hinweis">
            Der Kontrast wird nach WCAG 2.1 gerechnet. Unter 3:1 ist es ein
            Fehler, unter 4:1 eine Warnung — und ein heller Code auf dunklem
            Grund ist immer ein Fehler, den ältere Scanner nicht verzeihen.
          </p>
        </div>

        <!-- Druck -->
        <div class="lade" data-lade="druck" hidden>
          <div class="paar">
            <label class="feld">Breite in Millimetern
              <input class="eingabe" id="breite" type="number" min="8" max="1000" value="40" />
            </label>
            <label class="feld">Fehlerkorrektur
              <select class="eingabe" id="stufe">
                <option value="L">L — 7 %</option>
                <option value="M" selected>M — 15 %</option>
                <option value="Q">Q — 25 %</option>
                <option value="H">H — 30 %</option>
              </select>
            </label>
          </div>
          <label class="feld">Verfahren
            <select class="eingabe" id="verfahren"></select>
          </label>
          <label class="feld">Ruhezone in Modulen
            <input class="eingabe" id="ruhezone" type="number" min="0" max="10" value="4" />
          </label>
          <label class="ankreuz">
            <input type="checkbox" id="fuerkasse" />
            Soll an der Kasse gelesen werden (GS1-Maße)
          </label>
          <label class="feld">Leseabstand in Zentimetern
            <input type="range" id="abstand" min="10" max="500" step="10" value="30" />
          </label>
          <p class="hinweis" id="abstand-rat"></p>
        </div>
      </div>
    </div>
  </section>

  <section class="spur">
    <div class="panel-dunkel">
      <h2 class="titel-panel">Was hier noch nicht geht</h2>
      <p class="dunkel-text">
        Dieser Code ist <b>statisch</b>: sein Ziel steht fest im Muster. Das ist
        kein Mangel, sondern eine Eigenschaft — er funktioniert ohne jeden
        Server, für immer, auch wenn es pnkt.me einmal nicht mehr gibt.
      </p>
      <p class="dunkel-text">
        Ein <b>dynamischer</b> Code, dessen Ziel du später tauschen kannst,
        braucht eine Adresse, die jemand beantwortet — also einen Server. Der
        steht noch nicht. Sobald er steht, kommen Zentrale, Zahlen und
        Landeseiten dazu; gebaut sind sie.
      </p>
    </div>
  </section>
</Seite>

<!-- Das Laufzeitgerüst von Go. Es kommt unverändert aus der
     Go-Installation und definiert die Klasse `Go`, die das Modul unten
     braucht. `is:inline`, damit Astro es nicht anfasst. -->
<script is:inline src={weg('/wasm/wasm_exec.js')}></script>

<script>
  // Der Kern kommt aus Go. Diese Datei bedient ihn und rechnet selbst
  // nichts nach — sonst gäbe es zwei Wahrheiten über denselben Code.
  const e = (id) => document.getElementById(id);
  let bereit = false;
  let letzte = null;
  let letzteURL = null;

  const stil = {
    modulform: 'quadrat', augenrahmen: 'quadrat', augenkern: 'quadrat',
    vordergrund: '#201e1d', hintergrund: '#ffffff', ruhezone: 4, logo: 0,
  };

  function standSetzen(text, art) {
    e('standtext').textContent = text;
    e('stand').dataset.art = art || '';
  }

  // ── Kern laden ────────────────────────────────────────────────────
  // Der Pfad muss den Basispfad tragen: unter einem Unterverzeichnis
  // liegt die Datei nicht unter /wasm/. import.meta.env.BASE_URL setzt
  // Vite beim Bauen ein.
  const WASMWEG = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') + '/wasm/pnkt.wasm';

  // Aus der Zentrale kommt man mit ?ziel=… hierher: dort steht ein
  // umhängbarer Code, hier entsteht das Muster dazu. Gedruckt wird der
  // Kurzweg, nicht das Endziel — das ist der ganze Punkt, und deshalb
  // steht es auch unter dem Feld.
  function zielAusAdresse() {
    const ziel = new URLSearchParams(location.search).get('ziel');
    if (!ziel) return;
    e('typ').value = 'url';
    document.querySelectorAll('[data-typfeld]').forEach((f) => {
      f.hidden = !f.dataset.typfeld.split(' ').includes('url');
    });
    e('text').value = ziel;
    const zeile = document.createElement('p');
    zeile.className = 'hinweis';
    zeile.textContent =
      'Kommt aus der Zentrale. Im Muster steht der Kurzweg — wohin er führt, ' +
      'änderst du dort, ohne neu zu drucken.';
    e('text').closest('.feld').insertAdjacentElement('afterend', zeile);
  }

  async function kernLaden() {
    const go = new Go();
    try {
      const antwort = await fetch(WASMWEG);
      if (!antwort.ok) throw new Error('HTTP ' + antwort.status);
      const bytes = await antwort.arrayBuffer();
      const teil = await WebAssembly.instantiate(bytes, go.importObject);
      go.run(teil.instance);
      bereit = true;
      standSetzen('Kern geladen — läuft in diesem Browser', 'gut');
      verfahrenFuellen();
      zielAusAdresse();
      zeichnen();
    } catch (fehler) {
      standSetzen('Der Kern ließ sich nicht laden: ' + fehler.message, 'schlecht');
    }
  }

  function verfahrenFuellen() {
    const liste = JSON.parse(pnktVerfahren());
    e('verfahren').innerHTML = liste
      .map((v) => '<option value="' + v.schluessel + '"' +
        (v.schluessel === 'offset' ? ' selected' : '') + '>' +
        v.name + ' — ab ' + v.minModulMm.toFixed(2).replace('.', ',') + ' mm</option>')
      .join('');
  }

  // ── Inhalt ────────────────────────────────────────────────────────
  function felderSammeln(art) {
    const aus = {};
    document.querySelectorAll('[data-' + art + ']').forEach((f) => {
      aus[f.dataset[art]] = f.value;
    });
    return aus;
  }

  function inhaltText() {
    const typ = e('typ').value;
    if (typ === 'url' || typ === 'text') return { text: e('text').value };
    const felder = typ === 'vcard' ? felderSammeln('vcard')
      : typ === 'wlan' ? felderSammeln('wlan')
      : felderSammeln('giro');
    const antwort = JSON.parse(pnktInhalt(JSON.stringify({ typ, felder })));
    if (antwort.fehler) return { fehler: antwort.fehler };
    return { text: antwort.text };
  }

  // ── Rechnen ───────────────────────────────────────────────────────
  let linienUhr = null;
  function linieAn() {
    clearTimeout(linienUhr);
    linienUhr = setTimeout(() => { e('suchlinie').hidden = false; }, 180);
  }
  function linieAus() {
    clearTimeout(linienUhr);
    e('suchlinie').hidden = true;
  }

  let letztesUrteil = '';
  function zeichnen() {
    if (!bereit) return;
    linieAn();

    const inhalt = inhaltText();
    if (inhalt.fehler) {
      e('urteil').innerHTML = '<span class="urteil u-kritisch">nicht baubar</span>';
      e('befunde').innerHTML = '<div class="befund fehler"><b>' + inhalt.fehler + '</b></div>';
      e('bild').innerHTML = '';
      linieAus();
      return;
    }

    const wunsch = {
      text: inhalt.text,
      breiteMm: Number(e('breite').value) || 40,
      verfahren: e('verfahren').value,
      stufe: e('stufe').value,
      fuerKasse: e('fuerkasse').checked,
      stil: { ...stil, ruhezone: Number(e('ruhezone').value) || 4 },
    };

    const d = JSON.parse(pnktRendern(JSON.stringify(wunsch)));
    if (d.fehler) {
      e('urteil').innerHTML = '<span class="urteil u-kritisch">nicht baubar</span>';
      e('befunde').innerHTML = '<div class="befund fehler"><b>' + d.fehler + '</b></div>';
      e('bild').innerHTML = '';
      linieAus();
      return;
    }

    letzte = d;
    e('bild').innerHTML = d.svg;

    const wort = d.pruefung === 'gut' ? 'druckreif'
      : d.pruefung === 'achtung' ? 'achtung' : 'so nicht drucken';
    e('urteil').innerHTML = '<span class="urteil u-' + d.pruefung + '">' +
      wort + ' · Note ' + d.urteil.note + '</span>';
    if (d.pruefung !== letztesUrteil) {
      letztesUrteil = d.pruefung;
      const siegel = e('urteil').firstElementChild;
      if (siegel) { siegel.classList.remove('atmet'); void siegel.offsetWidth; siegel.classList.add('atmet'); }
    }

    e('zahlen').innerHTML =
      '<span>Version <b>' + d.version + '</b></span>' +
      '<span>Module <b>' + d.kante + '</b></span>' +
      '<span>Modul <b>' + d.urteil.modulMm.toFixed(3).replace('.', ',') + ' mm</b></span>' +
      '<span>Kontrast <b>' + d.urteil.kontrast + ':1</b></span>' +
      '<span>kleinste Breite <b>' + d.urteil.kleinsteMm + ' mm</b></span>';

    e('befunde').innerHTML = (d.urteil.befunde || [])
      .map((b) => '<div class="befund ' + b.schwere + '"><b>' + b.text + '</b>' +
        (b.rat ? '<span>' + b.rat + '</span>' : '') + '</div>')
      .join('') || '<div class="befund gut"><b>Keine Beanstandung.</b></div>';

    e('masse').textContent = wunsch.breiteMm + ' mm';
    e('laenge').textContent = inhalt.text.length + ' Zeichen. Je mehr im Code steht, ' +
      'desto größer muss er gedruckt werden.';
    linieAus();
  }

  // ── Herunterladen ─────────────────────────────────────────────────
  function ablegen(daten, art, name) {
    const tropf = new Blob([daten], { type: art });
    const weg = URL.createObjectURL(tropf);
    const anker = document.createElement('a');
    anker.href = weg;
    anker.download = name;
    anker.click();
    setTimeout(() => URL.revokeObjectURL(weg), 4000);
  }

  function ausBase64(b64) {
    const roh = atob(b64);
    const feld = new Uint8Array(roh.length);
    for (let i = 0; i < roh.length; i++) feld[i] = roh.charCodeAt(i);
    return feld;
  }

  document.querySelectorAll('[data-holen]').forEach((k) => {
    k.addEventListener('click', () => {
      if (!letzte) return;
      const art = k.dataset.holen;
      if (art === 'svg') return ablegen(letzte.svg, 'image/svg+xml', 'pnkt-code.svg');
      if (art === 'pdf') return ablegen(ausBase64(letzte.pdf), 'application/pdf', 'pnkt-code.pdf');
      if (art === 'eps') return ablegen(ausBase64(letzte.eps), 'application/postscript', 'pnkt-code.eps');
      // PNG rechnet der Browser aus demselben SVG. Fuer den Druck nimmt
      // man es nicht — es steht hier fuer Bildschirm und Vorschau.
      const bild = new Image();
      const tropf = new Blob([letzte.svg], { type: 'image/svg+xml' });
      const weg = URL.createObjectURL(tropf);
      bild.onload = () => {
        const tafel = document.createElement('canvas');
        tafel.width = 2048; tafel.height = 2048;
        const stift = tafel.getContext('2d');
        stift.fillStyle = stil.hintergrund || '#ffffff';
        stift.fillRect(0, 0, 2048, 2048);
        stift.drawImage(bild, 0, 0, 2048, 2048);
        tafel.toBlob((b) => {
          const w2 = URL.createObjectURL(b);
          const a = document.createElement('a');
          a.href = w2; a.download = 'pnkt-code.png'; a.click();
          setTimeout(() => URL.revokeObjectURL(w2), 4000);
        }, 'image/png');
        URL.revokeObjectURL(weg);
      };
      bild.src = weg;
    });
  });

  // ── Bedienung ─────────────────────────────────────────────────────
  // Chips und Schubladen. Ein zweiter Klick auf denselben Chip
  // schließt die Schublade — dann steht die Vorschau allein.
  document.querySelectorAll('.chip').forEach((k) => {
    k.addEventListener('click', () => {
      const offen = k.classList.contains('chip-aktiv');
      document.querySelectorAll('.chip').forEach((a) => {
        const wird = !offen && a === k;
        a.classList.toggle('chip-aktiv', wird);
        a.setAttribute('aria-selected', wird ? 'true' : 'false');
      });
      document.querySelectorAll('.lade').forEach((b) => {
        b.hidden = offen || b.dataset.lade !== k.dataset.lade;
      });
    });
  });

  for (const [id, feld] of [['modulform', 'modulform'], ['augenrahmen', 'augenrahmen'],
                            ['augenkern', 'augenkern'], ['vordergrund', 'vordergrund']]) {
    e(id).addEventListener('click', (ev) => {
      const k = ev.target.closest('[data-wert]');
      if (!k) return;
      e(id).querySelectorAll('[data-wert]').forEach((a) => a.classList.toggle('wahl-aktiv', a === k));
      stil[feld] = k.dataset.wert;
      if (feld === 'vordergrund') e('vordergrund-hex').value = k.dataset.wert;
      zeichnen();
    });
  }

  e('typ').addEventListener('change', () => {
    const typ = e('typ').value;
    document.querySelectorAll('[data-typfeld]').forEach((f) => {
      f.hidden = !f.dataset.typfeld.split(' ').includes(typ);
    });
    zeichnen();
  });

  e('logo').addEventListener('input', () => {
    stil.logo = Number(e('logo').value);
    e('logo-wert').textContent = Math.round(stil.logo * 100) + ' %';
    zeichnen();
  });

  e('vordergrund-hex').addEventListener('input', () => { stil.vordergrund = e('vordergrund-hex').value; zeichnen(); });
  e('hintergrund-hex').addEventListener('input', () => { stil.hintergrund = e('hintergrund-hex').value; zeichnen(); });

  e('abstand').addEventListener('input', () => {
    const cm = Number(e('abstand').value);
    e('abstand-rat').innerHTML = 'Faustregel: Kantenlänge ≈ Leseabstand ÷ 10. Für ' +
      cm + ' cm Abstand wären das <b>' + Math.round(cm) + ' mm</b>.';
  });

  let tippUhr = null;
  document.querySelectorAll('.eingabe, input[type=checkbox]').forEach((f) => {
    const art = f.tagName === 'SELECT' || f.type === 'checkbox' ? 'change' : 'input';
    f.addEventListener(art, () => {
      clearTimeout(tippUhr);
      tippUhr = setTimeout(zeichnen, 160);
    });
  });

  // ── Varianten ─────────────────────────────────────────────────────
  //
  // Sie leben im Tab und sonst nirgends: kein Konto, kein Speicher auf
  // der Platte, kein Abruf. Wer die Seite schließt, hat sie nicht mehr
  // — das ist der Preis dafür, dass diese Werkstatt ohne Anmeldung
  // funktioniert, und er steht auch so auf der Seite.
  let varianten = [];

  function varianteNehmen() {
    return {
      stil: { ...stil },
      breite: e('breite').value,
      stufe: e('stufe').value,
      verfahren: e('verfahren').value,
      ruhezone: e('ruhezone').value,
      typ: e('typ').value,
      text: e('text').value,
      svg: letzte ? letzte.svg : '',
      note: letzte ? letzte.urteil.note : '?',
      pruefung: letzte ? letzte.pruefung : 'gut',
    };
  }

  function varianteAnwenden(v) {
    Object.assign(stil, v.stil);
    e('breite').value = v.breite;
    e('stufe').value = v.stufe;
    e('verfahren').value = v.verfahren;
    e('ruhezone').value = v.ruhezone;
    e('typ').value = v.typ;
    e('text').value = v.text;
    e('typ').dispatchEvent(new Event('change'));
    e('vordergrund-hex').value = stil.vordergrund;
    e('hintergrund-hex').value = stil.hintergrund;
    for (const [id, feld] of [['modulform', 'modulform'], ['augenrahmen', 'augenrahmen'],
                              ['augenkern', 'augenkern'], ['vordergrund', 'vordergrund']]) {
      e(id).querySelectorAll('[data-wert]').forEach((a) =>
        a.classList.toggle('wahl-aktiv', a.dataset.wert === stil[feld]));
    }
    zeichnen();
  }

  function streifenZeichnen() {
    e('streifen-leer').hidden = varianten.length > 0;
    e('streifen').innerHTML = varianten
      .map((v, i) =>
        '<div class="variante" data-nr="' + i + '">' +
          '<div class="variante-bild">' + v.svg + '</div>' +
          '<div class="variante-fuss">' +
            '<span class="variante-note u-' + v.pruefung + '">' + v.note + '</span>' +
            '<button type="button" class="variante-weg" data-weg="' + i + '" ' +
              'aria-label="Variante entfernen">&times;</button>' +
          '</div>' +
        '</div>')
      .join('');
  }

  e('variante-neu').addEventListener('click', () => {
    if (!letzte) return;
    // Acht reichen. Mehr passen nicht nebeneinander, und wer mehr
    // braucht, vergleicht nicht mehr, sondern sammelt.
    if (varianten.length >= 8) varianten.shift();
    varianten.push(varianteNehmen());
    streifenZeichnen();
  });

  e('streifen').addEventListener('click', (ev) => {
    const weg = ev.target.closest('[data-weg]');
    if (weg) {
      varianten.splice(Number(weg.dataset.weg), 1);
      streifenZeichnen();
      return;
    }
    const v = ev.target.closest('[data-nr]');
    if (v) varianteAnwenden(varianten[Number(v.dataset.nr)]);
  });

  e('abstand').dispatchEvent(new Event('input'));
  kernLaden();
</script>

