---
import Seite from '../layouts/Seite.astro';
import Icon from '../components/Icon.astro';

const faecher = ['Alle', 'Gastro', 'Handel', 'Events', 'Verpackung'];

// Die Zahlen aus dem Entwurf („31 % bestellen") stehen hier nicht.
// Sie waren nie gemessen — sie standen als Beispielwerte im Layout, und
// eine Werbeaussage mit einer erfundenen Zahl ist nach § 5 UWG
// irrefuehrend, ganz abgesehen davon, dass sie einem Kunden eine
// Erwartung setzt, fuer die niemand geradesteht.
//
// Stattdessen steht da, was die Vorlage enthaelt und ob es sie gibt.
// „stand: 'gebaut'" heisst: im System vorhanden. Alles andere ist als
// solches gekennzeichnet — eine Vorlagenseite, die sechs Vorlagen
// verspricht und drei liefert, ist derselbe Fehler noch einmal.
const vorlagen = [
  {
    name: 'Karte kompakt', fach: 'Gastro', ton: 'terra', stand: 'gebaut',
    text: 'Speisekarte oder Preisliste: Abschnitte, Zeile und Preis, ein Knopf zur ganzen Karte.',
    bild: 'Speisekarte mobil',
    teile: ['Abschnitte mit Überschrift', 'Zeile, Preis und Anmerkung', 'Ein Knopf, gemessen'],
  },
  {
    name: 'Event-Programm', fach: 'Events', ton: 'terra', stand: 'gebaut',
    text: 'Ablauf mit Uhrzeiten in fester Spalte, darunter ein Knopf zum Lageplan.',
    bild: 'Programm mobil',
    teile: ['Uhrzeit links, feste Breite', 'Anmerkung je Punkt', 'Ein Knopf, gemessen'],
  },
  {
    name: 'Produktpass', fach: 'Verpackung', ton: 'salbei', stand: 'gebaut',
    text: 'Herkunft, Charge, Stoffe, Nutzung und Ende — die Angaben, die die ESPR verlangt.',
    bild: 'Produktpass',
    teile: ['An der GTIN, nicht am Code', 'Öffentlich und beschränkt getrennt', 'Als Seite und als JSON'],
  },
  {
    name: 'Wegweiser', fach: 'Alle', ton: 'salbei', stand: 'gebaut',
    text: 'Eine Liste von Zielen zur Auswahl: Karte, Reservierung, Anruf.',
    bild: 'Wegweiser',
    teile: ['Jede Zeile ein Weg', 'Auch mailto und tel', 'Kein fremdes Schema'],
  },
  {
    name: 'Kurz erklärt', fach: 'Alle', ton: 'salbei', stand: 'gebaut',
    text: 'Ein paar Absätze und ein Knopf. Für alles, was eine Erklärung braucht und keine Liste.',
    bild: 'Info mobil',
    teile: ['Absätze statt Zeilen', 'Ein Knopf, gemessen', 'Nichts wird nachgeladen'],
  },
  {
    name: 'Angebot gegen E-Mail', fach: 'Alle', ton: 'terra', stand: 'geplant',
    text: 'Ein Feld, ein Gutschein. Noch nicht gebaut — und der Grund steht daneben.',
    bild: 'Angebot mobil',
    teile: ['Braucht Doppelbestätigung', 'Die braucht eine E-Mail', 'pnkt verschickt bewusst keine'],
  },
];

// Was nicht gebaut ist, steht als Frage und nicht als Versprechen.
const offen = [
  {
    name: 'Angebot gegen E-Mail und Newsletter',
    grund: 'Eine Anmeldung ohne Doppelbestätigung ist in Deutschland angreifbar, und ' +
      'die Doppelbestätigung braucht eine E-Mail. pnkt verschickt keine — aus demselben ' +
      'Grund gibt es keine Einladung per Post, sondern nur „die Person legt sich selbst ' +
      'ein Konto an". Das zu ändern ist eine Grundentscheidung, keine Vorlage.',
  },
  {
    name: 'Terminbuchung',
    grund: 'Sie braucht einen Kalender mit freien Zeiten, Absagen und Erinnerungen. ' +
      'Der gehört keinem QR-System, sondern dem, das die Termine führt. Was pnkt ' +
      'dafür tun kann, ist der Wegweiser: ein Knopf, der dorthin führt — und gezählt wird.',
  },
];

const teamZahlen = [
  { wert: '12', text: 'Vorlagen im Haus' },
  { wert: '6', text: 'Rollen & Rechte' },
  { wert: '∞', text: 'Filialen je Vorlage' },
  { wert: '2', text: 'gesperrte Bereiche' },
  { wert: 'SSO', text: 'im Team-Tarif' },
  { wert: 'API', text: 'für eigene Systeme' },
];
---

<Seite
  titel="Vorlagen"
  beschreibung="Fertige Ziele, die schon funktionieren — Speisekarte, Angebot, Produktpass, Event-Programm, Terminbuchung, Newsletter."
  aktiv="vorlagen"
>
  <section class="spur kopfreihe">
    <div>
      <span class="tag tag-accent">
        <Icon name="bogen" groesse={16} />
        Vorlagen
      </span>
      <h1 class="titel-liste" style="margin:14px 0 14px">Fertige Ziele, die schon funktionieren</h1>
      <p class="fliess" style="font-size:17px">
        Jede Vorlage ist eine kleine mobile Seite, die aus dem Server kommt: nichts wird
        nachgeladen, nichts zählt eine Person mit. Nimm sie wie sie ist oder bau sie um.
      </p>
    </div>

    <!-- Die Filter sind auf der Marketingseite Anker, keine Schalter: sie
         führen in die Liste. Was wirklich filtert, ist die Werkstatt. -->
    <nav class="filter" aria-label="Nach Fach">
      {faecher.map((f, i) => (
        <a
          href={i === 0 ? '#liste' : `#liste-${f.toLowerCase()}`}
          class:list={['filter-pille', { 'filter-aktiv': i === 0 }]}
        >{f}</a>
      ))}
    </nav>
  </section>

  <section class="spur" id="liste">
    <div class="vorlagen-raster">
      {vorlagen.map((v) => (
        <article class="vorlage hebt" id={`liste-${v.fach.toLowerCase()}`}>
          <div class="vorschau">
            <span class="schirm" aria-hidden="true"></span>
            <span class="vorschau-name">{v.bild}</span>
          </div>
          <span class:list={['fach', v.ton === 'salbei' ? 'fach-salbei' : 'fach-terra']}>{v.fach}</span>
          <div class="vorlage-titel">{v.name}</div>
          <p class="vorlage-text">{v.text}</p>
          <ul class="teile">
            {v.teile.map((t) => (
              <li>
                <span class="teil-haken"><Icon name="geprueft" groesse={11} /></span>
                {t}
              </li>
            ))}
          </ul>
          <div class="vorlage-fuss">
            {v.stand === 'gebaut'
              ? <a href="/preise" class="btn btn-primary">Verwenden</a>
              : <span class="btn btn-geist">noch nicht gebaut</span>}
            <span class:list={['vorlage-stand', { 'stand-offen': v.stand !== 'gebaut' }]}>
              {v.stand === 'gebaut' ? 'im System' : 'geplant'}
            </span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="spur">
    <div class="offen-tafel">
      <h2 class="titel-panel" style="color:var(--color-text)">Was nicht da ist, und warum</h2>
      <p class="fliess" style="margin:8px 0 18px">
        Zwei Vorlagen aus dem Entwurf fehlen. Sie fehlen nicht aus Zeitmangel.
      </p>
      <div class="offen-raster">
        {offen.map((o) => (
          <article class="offen-karte">
            <div class="vorlage-titel" style="margin-top:0">{o.name}</div>
            <p class="vorlage-text" style="margin-bottom:0">{o.grund}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="spur">
    <div class="panel-dunkel team">
      <div>
        <h2 class="titel-panel">Einmal bauen, im Team teilen</h2>
        <p style="font-size:15.5px;line-height:1.6;color:rgba(245,234,216,.75);margin:0;max-width:420px">
          Eine Vorlage im Haus, alle Filialen hängen daran. Wer was ändern darf,
          steht in der Rolle — und im Verlauf steht, wer es getan hat.
        </p>
        <div class="knopfreihe">
          <a href="/preise" class="btn btn-primary knopf-gross">
            <Icon name="team" groesse={20} />
            Team-Tarif ansehen
          </a>
        </div>
      </div>
      <div class="team-raster">
        {teamZahlen.map((z) => (
          <div class="team-kachel">
            <div class="team-wert">{z.wert}</div>
            <div class="team-text">{z.text}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Seite>

<style>
  .kopfreihe { display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: end; }

  .filter { display: flex; gap: 8px; flex-wrap: wrap; }
  .filter-pille {
    padding: 9px 17px; border-radius: 999px;
    font-size: 13.5px; font-weight: 600; text-decoration: none;
    background: var(--color-surface); color: rgba(32, 30, 29, 0.7);
  }
  .filter-pille:hover { background: var(--color-accent-200); color: var(--color-accent-800); }
  .filter-aktiv { background: var(--color-accent); color: var(--color-bg); }
  .filter-aktiv:hover { background: var(--color-accent-600); color: var(--color-bg); }

  .vorlagen-raster { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .vorlage {
    background: var(--color-surface); border-radius: 36px; padding: 22px;
    display: flex; flex-direction: column;
    scroll-margin-top: 90px;
  }

  /* Platzhalter für die Bildschirmfotos, die noch fehlen. Gestreift und
     beschriftet — damit niemand sie für das fertige Bild hält. */
  .vorschau {
    position: relative;
    height: 120px; border-radius: 24px;
    background: var(--color-bg);
    display: grid; place-items: center;
    overflow: hidden;
    margin-bottom: 14px;
  }
  .schirm {
    width: 92px; height: 150px; border-radius: 14px;
    background: repeating-linear-gradient(135deg,
      var(--color-surface) 0 7px, rgba(32, 30, 29, 0.07) 7px 14px);
  }
  .vorschau-name {
    position: absolute; bottom: 8px;
    font-size: 11px; color: rgba(32, 30, 29, 0.45);
  }

  .fach {
    align-self: flex-start;
    font-size: 11.5px; font-weight: 600;
    padding: 5px 11px; border-radius: 999px;
  }
  .fach-terra { background: var(--color-accent-200); color: var(--color-accent-800); }
  .fach-salbei { background: var(--color-accent-2-200); color: var(--color-accent-2-800); }

  .vorlage-titel { font-family: var(--font-heading); font-size: 22px; margin: 10px 0 6px; }

  .offen-tafel {
    background: var(--color-surface); border-radius: 44px; padding: 34px 38px;
  }
  .offen-raster { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .offen-karte { background: var(--color-bg); border-radius: 28px; padding: 22px; }
  @media (max-width: 720px) { .offen-raster { grid-template-columns: 1fr; } }
  .vorlage-text { font-size: 13px; line-height: 1.55; color: rgba(32, 30, 29, 0.7); margin: 0 0 14px; }

  .teile { list-style: none; margin: 0 0 18px; padding: 0; display: grid; gap: 7px; }
  .teile li { display: flex; gap: 9px; align-items: center; font-size: 12.5px; }
  .teil-haken {
    width: 18px; height: 18px; border-radius: 999px; flex: none;
    display: grid; place-items: center;
    background: var(--color-bg); color: var(--color-accent-2);
  }

  .vorlage-fuss {
    margin-top: auto;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
  }
  .vorlage-stand { font-size: 12.5px; color: rgba(32, 30, 29, 0.6); }
  .stand-offen { color: var(--color-accent-800); }
  .btn-geist {
    background: transparent; color: rgba(32, 30, 29, 0.55);
    border: 1px solid rgba(32, 30, 29, 0.18); cursor: default;
  }

  .team { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
  .team-raster { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .team-kachel { background: rgba(245, 234, 216, 0.08); border-radius: 24px; padding: 18px 16px; }
  .team-wert { font-family: var(--font-heading); font-size: 26px; }
  .team-text { font-size: 12px; color: rgba(245, 234, 216, 0.7); margin-top: 3px; }

  @media (max-width: 1000px) { .vorlagen-raster { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 900px) {
    .kopfreihe { grid-template-columns: 1fr; align-items: start; gap: 20px; }
    .team { grid-template-columns: 1fr; gap: 28px; }
  }
  @media (max-width: 620px) {
    .vorlagen-raster { grid-template-columns: 1fr; }
    .team-raster { grid-template-columns: repeat(2, 1fr); }
  }
</style>
