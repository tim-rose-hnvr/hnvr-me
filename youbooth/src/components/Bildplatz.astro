---
/**
 * Ersetzt das <image-slot> der Entwuerfe.
 *
 * Liegt ein Bild vor, wird es gezeigt — sonst der beschriftete Platzhalter.
 * Das Attribut `motiv` ist das Shooting-Briefing und bleibt bewusst im Code
 * stehen, bis das echte Foto da ist.
 */
interface Props {
  motiv: string;
  src?: string;
  alt?: string;
  format?: string;
  radius?: number;
  /* `cover` gab es hier als Wahlmoeglichkeit. BUILD_SPEC 3.9 und
     Abnahmekriterium 9 lassen keine: Ein angeschnittener Screenshot zeigt die
     Oberflaeche falsch, und genau die soll er zeigen. Die Eigenschaft bleibt
     nur, damit die Seiten nicht auf einen Schlag umgeschrieben werden
     muessen — sie wirkt nicht mehr. */
  fit?: 'contain' | 'cover';
  laden?: 'eager' | 'lazy';
}

const {
  motiv,
  src,
  alt,
  format = '16 / 9',
  radius = 12,
  fit: _fitEgal = 'contain',
  laden = 'lazy',
} = Astro.props;
---

<div
  class:list={['platz', { leer: !src }]}
  style={`--format:${format};--radius:${radius}px;--fit:contain`}
>
  {
    src ? (
      <img src={src} alt={alt ?? ''} loading={laden} decoding="async" />
    ) : (
      <span class="hinweis">
        <span class="mono">Bild fehlt</span>
        <span class="motiv">{motiv}</span>
      </span>
    )
  }
</div>

<style>
  .platz {
    aspect-ratio: var(--format);
    border-radius: var(--radius);
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .platz img {
    width: 100%;
    height: 100%;
    object-fit: var(--fit);
    display: block;
  }

  /* Platzhalter: erkennbar unfertig, aber nicht laut. */
  .leer {
    background: repeating-linear-gradient(
      135deg,
      rgba(0, 0, 0, 0.045) 0 10px,
      rgba(0, 0, 0, 0.02) 10px 20px
    );
    border: 1px dashed var(--linie-stark);
  }

  .hinweis {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    text-align: center;
    padding: 16px;
  }

  .motiv {
    font-size: 13px;
    line-height: 1.45;
    color: var(--text-still);
    max-width: 32ch;
  }
</style>
