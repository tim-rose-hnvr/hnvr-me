---
import { fusszeile } from '../daten/navigation';

const jahr = 2026;
---

<footer class="fuss">
  <div class="spalten">
    <div class="marke">
      <span class="zeile">
        <img src="/assets/youbooth-mark.svg" alt="" width="26" height="26" />
        <span class="wortmarke">youbooth</span>
      </span>
      <span class="satz">
        Fotobox-Software für Vermieter, Studios und feste Installationen. Made in Germany,
        DSGVO-konform betrieben.
      </span>
    </div>

    {
      fusszeile.map((spalte) => (
        <nav class="spalte" aria-label={spalte.titel}>
          <span class="mono mono--hell">{spalte.titel}</span>
          {spalte.verweise.map((v) => (
            <a href={v.ziel}>{v.text}</a>
          ))}
        </nav>
      ))
    }

  </div>

  <!-- Vier Spalten, nicht fünf. Die Kontaktadresse stand hier als eigene
       Spalte; nach Teil 4.2 gehört sie in die Abschlusszeile — links das
       Recht, rechts die Post. -->
  <div class="recht">
    <span class="rechtszeile">
      © {jahr} youbooth
      <a href="/impressum">Impressum</a>
      <a href="/datenschutz">Datenschutz</a>
      <a href="/agb">AGB</a>
    </span>
    <a class="post" href="mailto:hallo@youbooth.me">hallo@youbooth.me</a>
  </div>
</footer>

<style>
  .fuss {
    background: var(--ink);
    color: var(--text-hell-leise);
    padding: 72px var(--rand) 44px;
    display: flex;
    flex-direction: column;
    gap: 34px;
  }

  .spalten {
    display: flex;
    gap: 56px;
    flex-wrap: wrap;
  }

  .marke {
    flex: 1;
    min-width: 260px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .zeile {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .zeile img {
    display: block;
  }

  .wortmarke {
    font-weight: 900;
    font-size: 22px;
    letter-spacing: -0.04em;
    text-transform: lowercase;
  }

  .satz {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-hell-still);
    max-width: 300px;
  }

  .spalte {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .spalte a,
  .still {
    font-weight: 500;
    font-size: 13.5px;
    color: color-mix(in srgb, var(--text-hell) 68%, transparent);
    text-decoration: none;
    transition: color var(--t-farbe);
  }

  .spalte a:hover {
    color: var(--text-hell);
  }

  .still {
    color: var(--text-hell-still);
  }

  .recht {
    border-top: 1px solid var(--linie-dunkel);
    padding-top: 20px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-hell-fein);
  }

  .rechtszeile {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .post {
    color: var(--text-hell-leise) !important;
  }

  .post:hover {
    color: var(--text-hell) !important;
  }

  .recht a {
    color: var(--text-hell-fein);
    text-decoration: none;
  }

  .recht a:hover {
    color: var(--text-hell);
  }
</style>
