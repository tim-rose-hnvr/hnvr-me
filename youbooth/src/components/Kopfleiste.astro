---
import { hauptnavigation } from '../daten/navigation';

const pfad = Astro.url.pathname.replace(/\/$/, '') || '/';
const istAktiv = (ziel: string) => pfad === ziel || pfad.startsWith(ziel + '/');
---

<header class="kopf">
  <a class="marke" href="/">
    <img src="/assets/youbooth-mark.svg" alt="" width="28" height="28" />
    <span class="wortmarke">youbooth<em>.me</em></span>
  </a>

  <button
    class="burger"
    type="button"
    aria-expanded="false"
    aria-controls="hauptnavigation"
    aria-label="Menü öffnen"
  >
    <i></i><i></i><i></i>
  </button>

  <!-- Navigation und Knoepfe liegen in einer Huelle. Auf breiten Schirmen ist
       sie `display: contents` und damit nicht vorhanden — die Leiste ordnet
       ihre Kinder selbst. Unter 1160px wird dieselbe Huelle zum Panel unter
       der Leiste. Ohne sie muessten zwei getrennte Kaesten in der Hoehe
       aufeinander abgestimmt werden, und das ginge nur mit Messen im Skript. -->
  <div class="huelle" id="hauptnavigation">
    <nav class="links" aria-label="Hauptnavigation">
      {
        hauptnavigation.map((v) => (
          <a href={v.ziel} class={istAktiv(v.ziel) ? 'on' : ''} aria-current={istAktiv(v.ziel) ? 'page' : undefined}>
            {v.text}
          </a>
        ))
      }
    </nav>
    <div class="rechts">
      <a class="ghost" href="/anmelden">Anmelden</a>
      <a class="cta" href="/kontakt">Kostenlos testen</a>
    </div>
  </div>

</header>

<style>
  .kopf {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--ink) 86%, transparent);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    border-bottom: 1px solid var(--linie-dunkel-zart);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 0 var(--rand);
    /* Feste Hoehe, kein Umbruch: Die Leiste ist 74px hoch, Punkt. Mit
       `flex-wrap` konnte sie bei zwoelf Eintraegen in eine zweite Zeile
       rutschen und die Seite darunter verschieben — unterhalb von 1160px
       uebernimmt stattdessen der Burger. */
    height: var(--kopfhoehe);
    flex-wrap: nowrap;
    color: var(--text-hell);
    box-shadow: var(--schatten-kopf);
  }

  .marke {
    display: flex;
    align-items: center;
    gap: 11px;
    color: var(--text-hell);
    text-decoration: none;
    flex: none;
    padding: 6px 0;
  }

  .marke img {
    display: block;
    transition: transform var(--t-transform);
  }

  .marke:hover img {
    transform: rotate(-6deg) scale(1.05);
  }

  .marke:hover {
    color: var(--text-hell);
  }

  .wortmarke {
    font-weight: 900;
    font-size: 25px;
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: lowercase;
    display: inline-flex;
    align-items: baseline;
    gap: 1px;
  }

  .wortmarke em {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 12.5px;
    font-style: normal;
    letter-spacing: 0.02em;
    color: var(--amber);
    transform: translateY(-1px);
  }

  .huelle {
    display: contents;
  }

  .links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    flex: 1 1 auto;
    flex-wrap: nowrap;
    min-width: 0;
  }

  .links a {
    color: var(--text-hell-leise);
    text-decoration: none;
    font-weight: 500;
    font-size: 13.5px;
    padding: 9px 10px;
    border-radius: var(--r-pille);
    white-space: nowrap;
    transition: color var(--t-farbe), background var(--t-farbe);
  }

  .links a:hover {
    color: var(--text-hell);
    background: color-mix(in srgb, var(--text-hell) 8%, transparent);
  }

  .links a.on {
    color: var(--amber-ink);
    background: var(--amber);
  }

  /* Ganz rechts, hinter der Navigation: Anmelden und Testen sind das Ziel
     der Seite, nicht ein Menüpunkt unter vielen. Das Auge läuft die Leiste
     von links nach rechts — dort endet es. */
  .rechts {
    display: flex;
    align-items: center;
    gap: 9px;
    flex: none;
    margin-left: auto;
  }

  .ghost,
  .cta {
    height: 40px;
    border-radius: var(--r-knopf);
    display: flex;
    align-items: center;
    font-weight: 600;
    font-size: 12.5px;
    text-decoration: none;
    white-space: nowrap;
  }

  .ghost {
    padding: 0 16px;
    border: 1px solid color-mix(in srgb, var(--text-hell) 20%, transparent);
    color: var(--text-hell);
    transition: border-color var(--t-farbe), background var(--t-farbe);
  }

  .ghost:hover {
    border-color: color-mix(in srgb, var(--text-hell) 45%, transparent);
    background: color-mix(in srgb, var(--text-hell) 6%, transparent);
    color: var(--text-hell);
  }

  .cta {
    padding: 0 18px;
    background: var(--amber);
    color: var(--amber-ink);
    box-shadow: var(--schatten-cta);
    transition: transform var(--t-farbe), box-shadow var(--t-farbe);
  }

  .cta:hover {
    transform: translateY(-1px);
    box-shadow: var(--schatten-cta-hover);
    color: var(--amber-ink);
  }

  .burger {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 11px;
    border: 1px solid color-mix(in srgb, var(--text-hell) 20%, transparent);
    background: none;
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4.5px;
    margin-left: auto;
    flex: none;
    transition: border-color var(--t-farbe);
  }

  .burger:hover {
    border-color: color-mix(in srgb, var(--text-hell) 45%, transparent);
  }

  .burger i {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text-hell);
    border-radius: 2px;
    transition: transform var(--t-transform), opacity var(--t-farbe);
  }

  /* Unter 1160px: Burger statt Leiste — der Wert aus der Spec.

     Er geht auf, weil die Navigation neun Punkte hat wie der Entwurf. Mit
     den zwoelf aus der Spec-Prosa braeuchte sie 1366px; siehe die
     Begruendung in `daten/navigation.ts`.

     Das Panel haengt UNTER der Leiste, nicht in ihr. Vorher lief es ueber
     `flex-wrap` in einer zweiten Zeile mit — das hielt die Leiste nur solange
     auf 74px, wie sie zu war, und schob beim Oeffnen die Seite nach unten.
     Die Spec sagt: feste Hoehe, Panel darunter. */
  @media (max-width: 1160px) {
    .burger {
      display: flex;
    }

    .huelle {
      position: absolute;
      top: var(--kopfhoehe);
      left: 0;
      right: 0;
      display: none;
      flex-direction: column;
      padding: 10px var(--rand) 18px;
      background: color-mix(in srgb, var(--ink) 96%, transparent);
      backdrop-filter: blur(18px) saturate(140%);
      -webkit-backdrop-filter: blur(18px) saturate(140%);
      border-top: 1px solid var(--linie-dunkel-zart);
      border-bottom: 1px solid var(--linie-dunkel-zart);
      box-shadow: var(--schatten-kopf);
      max-height: calc(100dvh - var(--kopfhoehe));
      overflow-y: auto;
    }

    .kopf[data-offen] .huelle {
      display: flex;
    }

    .links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .links a {
      padding: 13px 12px;
      font-size: 16px;
      border-radius: var(--r-pille);
      border-top: 1px solid var(--linie-dunkel-zart);
    }

    .links a:first-child {
      border-top: 0;
    }

    /* Beide Knoepfe stehen im Panel und werden dort breit — vorher fiel
       „Anmelden" auf schmalen Geraeten ganz weg, und genau den Weg sucht
       jemand, der die Software schon gekauft hat. */
    .rechts {
      margin-left: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
      padding-top: 14px;
      margin-top: 4px;
      border-top: 1px solid var(--linie-dunkel-zart);
    }

    .ghost,
    .cta {
      justify-content: center;
      width: 100%;
    }

    .kopf[data-offen] .burger i:nth-child(1) {
      transform: translateY(6.5px) rotate(45deg);
    }

    .kopf[data-offen] .burger i:nth-child(2) {
      opacity: 0;
    }

    .kopf[data-offen] .burger i:nth-child(3) {
      transform: translateY(-6.5px) rotate(-45deg);
    }
  }

  @media (max-width: 640px) {
    .wortmarke {
      font-size: 22px;
    }
    .wortmarke em {
      font-size: 11px;
    }
    .cta {
      height: 38px;
      padding: 0 14px;
      font-size: 12px;
    }
  }
</style>

<script>
  /* Drei Dinge verlangt die Spec neben dem Umschalten, und alle drei sind
     Dinge, deren Fehlen man erst merkt, wenn man daran haengenbleibt:
     Escape schliesst, ein Seitenwechsel schliesst, und solange das Panel
     offen ist, scrollt die Seite darunter nicht weg. */
  const kopf = document.querySelector<HTMLElement>('.kopf');
  const burger = kopf?.querySelector<HTMLButtonElement>('.burger');

  function setze(offen: boolean): void {
    if (!kopf || !burger) return;
    kopf.toggleAttribute('data-offen', offen);
    burger.setAttribute('aria-expanded', String(offen));
    burger.setAttribute('aria-label', offen ? 'Menü schließen' : 'Menü öffnen');
    document.body.style.overflow = offen ? 'hidden' : '';
  }

  burger?.addEventListener('click', () => setze(!kopf!.hasAttribute('data-offen')));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && kopf?.hasAttribute('data-offen')) {
      setze(false);
      burger?.focus();
    }
  });

  /* Ein Klick auf einen Menüpunkt führt weiter — das Panel darf dann nicht
     über der neuen Seite stehen bleiben. */
  kopf?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setze(false)));

  /* Wird das Fenster über den Umbruchpunkt hinaus breiter, gibt es kein
     Panel mehr, das offen sein könnte — die Scroll-Sperre bliebe sonst. */
  window.addEventListener('resize', () => {
    if (window.innerWidth > 1160 && kopf?.hasAttribute('data-offen')) setze(false);
  });
</script>
