---
/**
 * Vorschau eines Druck-Layouts: Bildfeld, Textzeilen, Logo-Slot.
 * Die Variante bestimmt den Aufbau — gezeichnet in CSS, nicht als Bild.
 */
interface Props {
  variante: string;
  format: string;
  zeilen?: string[];
  dunkel?: boolean;
  seitenverhaeltnis?: string;
  /** Anzahl der Bildfelder — Streifen haben drei oder vier. */
  bilder?: number;
}

const {
  variante,
  format,
  zeilen = [],
  dunkel = false,
  seitenverhaeltnis = '3 / 4',
  bilder = 1,
} = Astro.props;

const felder = Array.from({ length: bilder }, (_, i) => i);
---

<div
  class:list={['blatt', `blatt--${variante}`, { dunkel }]}
  style={`--format:${seitenverhaeltnis}`}
  aria-hidden="true"
>
  {felder.map((i) => <span class="bildfeld">{bilder === 1 ? 'Foto' : `Foto ${i + 1}`}</span>)}
  {zeilen[0] && <span class="zeile1">{zeilen[0]}</span>}
  {zeilen[1] && <span class="zeile2">{zeilen[1]}</span>}
  {zeilen[2] && <span class="marke">{zeilen[2]}</span>}
  <span class="formatmarke">{format}</span>
</div>

<style>
  .blatt {
    aspect-ratio: var(--format);
    background: #fff;
    box-shadow: 0 5px 16px rgba(0, 0, 0, 0.14);
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: relative;
    overflow: hidden;
  }

  .blatt.dunkel {
    background: var(--ink);
    color: var(--text-hell);
  }

  .bildfeld {
    flex: 1;
    background: #dcd6cb;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.35);
  }

  .blatt.dunkel .bildfeld {
    background: #26262e;
    color: rgba(244, 242, 238, 0.4);
  }

  .zeile1 {
    text-align: center;
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: 13px;
    line-height: 1.1;
    color: var(--text);
  }

  .blatt.dunkel .zeile1 {
    color: var(--text-hell);
  }

  .zeile2,
  .formatmarke {
    text-align: center;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 7.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.42);
  }

  .blatt.dunkel .zeile2 {
    color: rgba(244, 242, 238, 0.5);
  }

  .formatmarke {
    display: none;
  }

  .marke {
    position: absolute;
    right: 10px;
    bottom: 10px;
    font-family: var(--mono);
    font-weight: 600;
    font-size: 7px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--amber);
  }

  /* --- Varianten -------------------------------------------------------- */

  /* Klassik: Serif-Zeile über Datumszeile, weiter Rand unten */
  .blatt--klassik {
    padding: 12px 12px 20px;
  }

  /* Dark Mono */
  .blatt--mono .zeile1 {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Randlos mit Banderole */
  .blatt--randlos {
    padding: 0;
    gap: 0;
  }

  .blatt--randlos .bildfeld {
    margin: 0;
  }

  .blatt--randlos .zeile1,
  .blatt--randlos .zeile2 {
    background: rgba(11, 11, 13, 0.82);
    color: var(--text-hell);
    padding: 6px 8px 0;
  }

  .blatt--randlos .zeile2 {
    padding: 2px 8px 8px;
    color: rgba(244, 242, 238, 0.6);
  }

  /* Split mit Textpanel */
  .blatt--split .bildfeld {
    flex: 1.4;
  }

  .blatt--split .zeile1 {
    background: var(--deep);
    color: #fff;
    padding: 8px 6px;
    font-size: 11px;
  }

  /* Passepartout */
  .blatt--passepartout {
    padding: 18px 18px 26px;
    background: #f6f2ea;
  }

  /* Filmkante */
  .blatt--film::before,
  .blatt--film::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 7px;
    background: repeating-linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.45) 0 6px,
      transparent 6px 13px
    );
  }

  .blatt--film::before {
    top: 0;
  }

  .blatt--film::after {
    bottom: 0;
  }

  .blatt--film {
    padding: 14px 10px;
    background: #17171c;
    color: var(--text-hell);
  }

  .blatt--film .bildfeld {
    background: #2b2b35;
  }

  .blatt--film .zeile1 {
    color: var(--amber);
    font-family: var(--mono);
    font-size: 14px;
  }

  /* Collage */
  .blatt--collage .bildfeld {
    background: linear-gradient(
        to right,
        #dcd6cb 0 32%,
        #fff 32% 34%,
        #d3ccc0 34% 66%,
        #fff 66% 68%,
        #dcd6cb 68%
      );
  }

  /* Monogramm */
  .blatt--monogramm .zeile1 {
    font-size: 22px;
    letter-spacing: -0.04em;
  }

  .blatt--monogramm {
    padding: 14px;
  }

  .blatt--monogramm .bildfeld {
    order: 2;
  }

  .blatt--monogramm .zeile1 {
    order: 0;
  }

  .blatt--monogramm .zeile2 {
    order: 1;
  }

  /* Banderole mit Akzent */
  .blatt--banderole .zeile1 {
    background: var(--amber);
    color: var(--amber-ink);
    padding: 7px 6px;
  }

  /* Postkarte */
  .blatt--postkarte .bildfeld {
    flex: 0 0 46%;
  }

  .blatt--postkarte::after {
    content: '';
    flex: 1;
    background: repeating-linear-gradient(
      transparent 0 9px,
      rgba(0, 0, 0, 0.14) 9px 10px
    );
    margin: 4px 6px 10px;
  }

  /* Datum oben, Satz unten */
  .blatt--datum .zeile2 {
    order: -1;
  }

  .blatt--datum .zeile1 {
    font-weight: 800;
    font-size: 12px;
  }

  /* Seitenleiste */
  .blatt--seitenleiste {
    flex-direction: row;
    align-items: stretch;
  }

  .blatt--seitenleiste .bildfeld {
    flex: 1;
  }

  .blatt--seitenleiste .zeile1 {
    writing-mode: vertical-rl;
    background: var(--ink-soft);
    color: var(--text-hell);
    padding: 8px 5px;
    font-size: 10px;
  }

  .blatt--seitenleiste .zeile2 {
    display: none;
  }

  /* Streifen */
  .blatt--streifen {
    padding: 6px;
    gap: 5px;
  }

  .blatt--streifen .bildfeld {
    font-size: 6.5px;
    letter-spacing: 0.1em;
  }

  .blatt--streifen .zeile1 {
    font-size: 9px;
    margin-top: auto;
  }

  .blatt--streifen .zeile2 {
    font-size: 6px;
  }
</style>
