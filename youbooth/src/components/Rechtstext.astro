---
import Marketing from '../layouts/Marketing.astro';

/**
 * Rahmen für die Rechtstexte. Die Entwürfe kennen nur die Fußzeilen-Links,
 * die Inhalte hier sind deshalb ein Gerüst mit Platzhaltern.
 *
 * Der Hinweis oben bleibt stehen, bis die Texte geprüft und freigegeben sind —
 * so kann niemand ein Platzhalter-Impressum versehentlich online stellen.
 */
interface Props {
  titel: string;
  beschreibung: string;
  abschnitte: { titel: string; zeilen: string[] }[];
  stand?: string;
}

const { titel, beschreibung, abschnitte, stand = 'Entwurf' } = Astro.props;
---

<Marketing titel={titel} beschreibung={beschreibung}>
  <section class="kopf">
    <span class="mono mono--amber">Rechtliches</span>
    <h1>{titel}</h1>
    <span class="mono mono--hell">Stand: {stand}</span>
  </section>

  <div class="warnung" role="note">
    <span class="mono">Noch nicht freigegeben</span>
    <p>
      Dieser Text ist ein Gerüst mit Platzhaltern in eckigen Klammern. Vor dem Livegang müssen die
      Angaben durch die echten Daten ersetzt und rechtlich geprüft werden.
    </p>
  </div>

  <article class="text">
    {
      abschnitte.map((a) => (
        <section class="teil">
          <h2>{a.titel}</h2>
          {a.zeilen.map((z) => (
            <p>{z}</p>
          ))}
        </section>
      ))
    }
  </article>
</Marketing>

<style>
  .kopf {
    background: var(--ink);
    color: var(--text-hell);
    padding: 56px var(--rand);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .kopf h1 {
    font-size: clamp(32px, 4vw, 54px);
  }

  .warnung {
    margin: 32px var(--rand) 0;
    background: #fff5e0;
    border: 1px solid var(--amber);
    border-radius: var(--r-karte);
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 820px;
  }

  .warnung .mono {
    color: #8a6512;
  }

  .warnung p {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.68);
  }

  .text {
    padding: 32px var(--rand) 72px;
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: calc(var(--spalte-text) + 2 * 56px);
  }

  .teil {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .teil h2 {
    font-size: clamp(20px, 2vw, 26px);
  }

  .teil p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-leise);
  }
</style>
