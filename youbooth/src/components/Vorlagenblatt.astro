---
import type { Vorlage } from '../daten/vorlagen';

/**
 * Vorschau eines Druck-Layouts: Blatt plus Streifen auf einer Ablage.
 * Die Gestaltung entsteht aus dem Rezept — zwei Dekoflaechen je Vorlage,
 * als ::before und ::after in CSS gezeichnet, ohne Bilddatei.
 */
interface Props {
  vorlage: Vorlage;
}

const { vorlage: v } = Astro.props;

/** Auf dunklen Blaettern und ueber Flaechen steht der Titel hell. */
const dunkel = ['#0b0b0d', '#101015', '#101014'].includes(v.blatt);
const titelHell = dunkel || v.rezept === 'bleed' || v.rezept === 'split';

/** Bei diesen Rezepten fuellt die Deko die Bildflaeche. */
const ohneBildflaeche = ['bleed', 'xxl', 'marmor'].includes(v.rezept);
---

<div class="ablage" style={`--ablage:${v.ablage};--blatt:${v.blatt};--akzent:${v.akzent}`}>
  <div class:list={['blatt', `rezept--${v.rezept}`]}>
    <span class:list={['bildflaeche', { leer: ohneBildflaeche }]} aria-hidden="true"></span>
    <span class:list={['titel', { hell: titelHell, xxl: v.rezept === 'xxl' }]}>{v.titel}</span>
    <span class:list={['unterzeile', { hell: titelHell }]}>{v.unterzeile}</span>
  </div>

  <div class:list={['streifen', { dunkel }]} aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
</div>

<style>
  .ablage {
    background: var(--ablage);
    padding: 22px;
    display: flex;
    gap: 12px;
    align-items: stretch;
    min-height: 196px;
  }

  .blatt {
    flex: 1;
    background: var(--blatt);
    box-shadow: 0 5px 16px rgba(0, 0, 0, 0.16);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    padding: 14px;
    gap: 10px;
  }

  .blatt::before,
  .blatt::after {
    content: '';
    display: block;
    position: absolute;
  }

  .bildflaeche {
    flex: 1;
    position: relative;
    z-index: 1;
    background: #dcd6cb;
    display: block;
  }

  .bildflaeche.leer {
    background: transparent;
  }

  .titel,
  .unterzeile {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .titel {
    font-weight: 700;
    font-size: 14px;
    letter-spacing: -0.02em;
    color: var(--akzent);
  }

  .titel.xxl {
    font-weight: 900;
    font-size: 30px;
  }

  .titel.hell {
    color: var(--text-hell);
  }

  .unterzeile {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 7.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.45);
  }

  .unterzeile.hell {
    color: rgba(244, 242, 238, 0.62);
  }

  .streifen {
    width: 48px;
    flex: none;
    background: var(--blatt);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.14);
    padding: 5px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .streifen span {
    flex: 1;
    background: #dcd6cb;
    display: block;
  }

  .streifen.dunkel span {
    background: #26262e;
  }

  /* --- Rezepte ---------------------------------------------------------- */

  .rezept--rahmen::before {
    inset: 8px;
    border: 1px solid var(--akzent);
  }
  .rezept--rahmen::after {
    inset: 11px;
    border: 3px double var(--akzent);
    opacity: 0.5;
  }

  .rezept--bleed::before {
    inset: 0;
    background: radial-gradient(circle at 0 0, rgba(185, 155, 88, 0.85), transparent 70%);
  }
  .rezept--bleed::after {
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.65), transparent 55%);
  }

  .rezept--kranz::before {
    top: -18px;
    left: -18px;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    border: 10px solid rgba(90, 124, 92, 0.35);
  }
  .rezept--kranz::after {
    bottom: -22px;
    right: -22px;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    border: 8px solid rgba(90, 124, 92, 0.25);
  }

  .rezept--split::before {
    left: 0;
    right: 0;
    bottom: 0;
    height: 38%;
    background: var(--akzent);
  }
  .rezept--split::after {
    left: 0;
    right: 0;
    bottom: 38%;
    height: 3px;
    background: rgba(255, 255, 255, 0.6);
  }

  .rezept--deco::before {
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: repeating-linear-gradient(90deg, var(--akzent) 0 3px, transparent 3px 7px);
  }
  .rezept--deco::after {
    top: 14px;
    left: 14px;
    width: 24px;
    height: 24px;
    border-top: 2px solid var(--akzent);
    border-left: 2px solid var(--akzent);
  }

  .rezept--kirmes::before {
    top: 0;
    bottom: 0;
    left: 0;
    width: 7px;
    background: repeating-linear-gradient(var(--akzent) 0 8px, transparent 8px 16px);
  }
  .rezept--kirmes::after {
    top: 0;
    bottom: 0;
    right: 0;
    width: 7px;
    background: repeating-linear-gradient(var(--akzent) 0 8px, transparent 8px 16px);
  }

  .rezept--neon::before {
    inset: 0;
    background: radial-gradient(circle at 15% 20%, rgba(193, 71, 233, 0.35), transparent 38%);
  }
  .rezept--neon::after {
    inset: 0;
    background: radial-gradient(circle at 85% 78%, rgba(62, 123, 242, 0.3), transparent 40%);
  }

  .rezept--girlande::before {
    top: 0;
    left: 0;
    right: 0;
    height: 22px;
    background: repeating-linear-gradient(
      135deg,
      #f2b23e 0 8px,
      #e0483c 8px 16px,
      #17b187 16px 24px
    );
  }
  .rezept--girlande::after {
    top: 26px;
    left: 12px;
    right: 12px;
    height: 7px;
    background: repeating-linear-gradient(90deg, var(--akzent) 0 7px, transparent 7px 16px);
  }

  .rezept--ringe::before {
    top: 16%;
    left: 14%;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 2px solid var(--akzent);
  }
  .rezept--ringe::after {
    top: 30%;
    right: 16%;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.7);
  }

  .rezept--winter::before {
    inset: 0;
    background: radial-gradient(circle at 20% 12%, rgba(160, 190, 205, 0.5), transparent 40%);
  }
  .rezept--winter::after {
    top: 9px;
    left: 12px;
    right: 12px;
    height: 7px;
    background: repeating-linear-gradient(90deg, #a7bfcb 0 6px, transparent 6px 18px);
  }

  .rezept--karo::before {
    inset: 0;
    background: repeating-conic-gradient(
      from 0deg at 50% 50%,
      rgba(0, 0, 0, 0.05) 0deg 90deg,
      transparent 90deg 180deg
    );
    background-size: 20px 20px;
  }
  .rezept--karo::after {
    display: none;
  }

  .rezept--film::before {
    top: 8px;
    left: 10px;
    right: 10px;
    height: 5px;
    background: repeating-linear-gradient(
      90deg,
      rgba(244, 242, 238, 0.45) 0 7px,
      transparent 7px 15px
    );
  }
  .rezept--film::after {
    bottom: 8px;
    left: 10px;
    right: 10px;
    height: 5px;
    background: repeating-linear-gradient(
      90deg,
      rgba(244, 242, 238, 0.45) 0 7px,
      transparent 7px 15px
    );
  }

  .rezept--xxl::before {
    inset: 10px;
    background: #dcd6cb;
  }
  .rezept--xxl::after {
    display: none;
  }

  .rezept--marmor::before {
    inset: 0;
    background: linear-gradient(
      115deg,
      #e9e5df 0 32%,
      #d9d3cb 32% 34%,
      #efece6 34% 68%,
      #dad4cc 68% 70%,
      #eeeae4 70%
    );
  }
  .rezept--marmor::after {
    display: none;
  }

  .rezept--ticket::before {
    left: 0;
    right: 0;
    bottom: 44px;
    height: 20px;
    background: radial-gradient(circle at 8px 10px, transparent 7px, #fff 7px);
    background-size: 16px 20px;
  }
  .rezept--ticket::after {
    display: none;
  }

  .rezept--bogen::before {
    top: 0;
    left: 0;
    right: 0;
    height: 52%;
    border-radius: 0 0 999px 999px;
    background: linear-gradient(#f2b23e, var(--akzent));
  }
  .rezept--bogen::after {
    display: none;
  }
</style>
