---
import Marketing from '../../layouts/Marketing.astro';
import { Bildflaeche } from '../../bausteine';
import Standmarke from '../../components/Standmarke.astro';
import { standNachTitel } from '../../daten/stand';
import Bildplatz from '../../components/Bildplatz.astro';
import HeroDeko from '../../components/HeroDeko.astro';
import { anlaesse, preishinweis } from '../../daten/anlaesse';

/**
 * Eine Vorlage fuer alle sechs Anlass-Landingpages. Was sich unterscheidet —
 * Farbwelt, Hero-Deko, Texte — steht in src/daten/anlaesse.ts.
 */
export function getStaticPaths() {
  return anlaesse.map((a) => ({ params: { anlass: a.id }, props: { anlass: a } }));
}

const { anlass } = Astro.props;
const andere = anlaesse.filter((a) => a.id !== anlass.id);

const farbwelt = [
  `--grund:${anlass.grund}`,
  `--text-eigen:${anlass.text}`,
  `--akzent-eigen:${anlass.akzent}`,
  `--streifen-a:${anlass.streifen[0]}`,
  `--streifen-b:${anlass.streifen[1]}`,
  `--cta-grund:${anlass.ctaGrund}`,
  `--cta-text:${anlass.ctaText}`,
].join(';');
---

<Marketing titel={anlass.titel} beschreibung={anlass.sub}>
  <section class="buehne" style={farbwelt}>
    <div class="buehne__grund" aria-hidden="true"></div>
    <HeroDeko art={anlass.deko} akzent={anlass.akzent} text={anlass.text} />

    <div class="buehne__text">
      <span class="kicker">{anlass.kicker}</span>
      <h1>{anlass.h1}</h1>
      <p class="sub">{anlass.sub}</p>
      <div class="reihe knopfreihe">
        <a class="eigenerknopf" href="/kontakt">Termin anfragen</a>
        <a class="rahmenknopf" href="/rechner">Preis überschlagen</a>
      </div>
      <span class="zitat">{anlass.zitat}</span>
    </div>

    <div class="buehne__bild">
      <Bildflaeche format="16 / 11" motiv={anlass.bild} />
    </div>
  </section>

  <section class="abschnitt zweispalter">
    <div class="spalte">
      <h2>Was im Paket steckt</h2>
      <div class="karte paketkarte">
        {
          anlass.paket.map((p, i) => (
            <span class="haken" style={`--verzug:${i * 0.1}s`}>
              <span class="haken__kreis" aria-hidden="true">
                ✓
              </span>
              {p}
            </span>
          ))
        }
      </div>
      <span class="mono">{preishinweis}</span>
    </div>

    <div class="spalte">
      <h2>Passende Module</h2>
      <div class="modulraster">
        {
          anlass.module.map(([titel, zeile]) => (
            <article class="karte modulkarte">
              <span class="modulkarte__titel">
                {titel}
                {standNachTitel(titel) && <Standmarke stand={standNachTitel(titel)!.stand} />}
              </span>
              <span class="modulkarte__zeile">{zeile}</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <h2>Häufige Fragen</h2>
    <div class="raster raster--breit">
      {
        anlass.faq.map(([frage, antwort]) => (
          <article class="karte">
            <span class="frage">{frage}</span>
            <span class="antwort">{antwort}</span>
          </article>
        ))
      }
    </div>
  </section>

  <section class="abschnitt abschnitt--dunkel">
    <h2>Andere Anlässe</h2>
    <div class="raster raster--schmal">
      {
        andere.map((a) => (
          <a class="andere" href={`/anlaesse/${a.id}`}>
            <span class="display display--klein">{a.titel}</span>
            <span class="andere__zeile">{a.kachelzeile}</span>
            <span class="mono mono--amber">Ansehen →</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="abschnitt abschnitt--tief schluss">
    <div class="schluss__text">
      <span class="display">{anlass.schluss}</span>
      <span class="beiwort">Verfügbarkeit steht im Kalender, Angebot kommt am selben Tag.</span>
    </div>
    <div class="reihe knopfreihe">
      <a class="knopf knopf--amber knopf--gross" href="/kontakt">Anfragen</a>
      <a class="knopf knopf--rahmen-hell knopf--gross" href="/fuer-vermieter">Für Vermieter</a>
    </div>
  </section>
</Marketing>

<style>
  .modulkarte__titel {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
  }

  .buehne {
    background: var(--grund);
    color: var(--text-eigen);
    padding: 60px var(--rand) 66px;
    display: flex;
    gap: 44px;
    flex-wrap: wrap;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .buehne__grund {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      135deg,
      var(--streifen-a) 0 14px,
      var(--streifen-b) 14px 28px
    );
    opacity: 0.5;
  }

  .buehne__text {
    position: relative;
    flex: 1 1 460px;
    min-width: min(430px, 100%);
    display: flex;
    flex-direction: column;
    gap: 20px;
    z-index: 5;
  }

  .buehne__bild {
    position: relative;
    flex: 1 1 420px;
    min-width: min(400px, 100%);
    z-index: 5;
  }

  .kicker {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--akzent-eigen);
  }

  .buehne h1 {
    font-size: clamp(34px, 4.2vw, 56px);
    color: var(--text-eigen);
  }

  .sub {
    font-size: 16.5px;
    line-height: 1.65;
    color: color-mix(in srgb, var(--text-eigen) 65%, transparent);
    max-width: 540px;
  }

  .knopfreihe {
    gap: 12px;
  }

  .eigenerknopf,
  .rahmenknopf {
    height: 56px;
    padding: 0 26px;
    border-radius: 11px;
    display: inline-flex;
    align-items: center;
    font-family: var(--schrift);
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
  }

  .eigenerknopf {
    background: var(--cta-grund);
    color: var(--cta-text);
    animation: pochen 3s ease-in-out infinite;
  }

  .eigenerknopf:hover {
    color: var(--cta-text);
    filter: brightness(1.08);
  }

  .rahmenknopf {
    border: 1px solid color-mix(in srgb, var(--text-eigen) 55%, transparent);
    color: var(--text-eigen);
    font-weight: 600;
    font-size: 15px;
    padding: 0 24px;
  }

  .rahmenknopf:hover {
    color: var(--text-eigen);
    background: color-mix(in srgb, var(--text-eigen) 8%, transparent);
  }

  .zitat {
    font-weight: 800;
    letter-spacing: -0.025em;
    font-size: clamp(20px, 2.4vw, 30px);
    line-height: 1.1;
    color: var(--text-eigen);
    opacity: 0.85;
    animation: schweben 5s ease-in-out infinite;
  }

  @keyframes pochen {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(242, 178, 62, 0.4);
    }
    55% {
      transform: scale(1.04);
      box-shadow: 0 0 0 24px rgba(242, 178, 62, 0);
    }
  }

  @keyframes schweben {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eigenerknopf,
    .zitat {
      animation: none;
    }
  }

  /* Paket und Module */
  .zweispalter {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 26px;
    padding-block: 56px 0;
  }

  .spalte {
    flex: 1 1 400px;
    min-width: min(380px, 100%);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .paketkarte {
    gap: 13px;
  }

  .haken {
    display: flex;
    gap: 11px;
    align-items: flex-start;
    font-size: 14.5px;
    line-height: 1.5;
    color: rgba(0, 0, 0, 0.68);
    animation: einblenden 0.7s ease-out both var(--verzug);
  }

  .haken__kreis {
    width: 18px;
    height: 18px;
    border-radius: var(--r-kreis);
    background: var(--ok);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 10px;
    flex: none;
    margin-top: 1px;
  }

  @keyframes einblenden {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .haken {
      animation: none;
    }
  }

  .modulraster {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .modulkarte {
    padding: 18px;
    gap: 8px;
  }

  .modulkarte__titel {
    font-weight: 600;
    font-size: 14.5px;
    color: var(--text);
  }

  .modulkarte__zeile {
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-leise);
  }

  /* Fragen */
  .raster--breit {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .frage {
    font-weight: 600;
    font-size: 15px;
    color: var(--text);
  }

  .antwort {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-leise);
  }

  /* Andere Anlässe */
  .raster--schmal {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .andere {
    background: var(--ink-soft);
    border: 1px solid rgba(244, 242, 238, 0.12);
    border-radius: var(--r-karte);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    color: var(--text-hell);
    transition: border-color var(--t-farbe), transform var(--t-transform);
  }

  .andere:hover {
    border-color: var(--amber);
    transform: translateY(-2px);
    color: var(--text-hell);
  }

  .andere .display {
    font-size: 24px;
  }

  .andere__zeile {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--text-hell-leise);
  }

  .schluss {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    flex-wrap: wrap;
  }

  .schluss__text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .schluss .display {
    font-size: clamp(26px, 2.8vw, 34px);
    line-height: 1.05;
  }

  .beiwort {
    font-size: 15px;
    color: var(--text-hell-leise);
  }

  @media (max-width: 640px) {
    .modulraster {
      grid-template-columns: 1fr;
    }
  }
</style>
