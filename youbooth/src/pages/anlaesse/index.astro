---
import Marketing from '../../layouts/Marketing.astro';
import { anlaesse } from '../../daten/anlaesse';

/**
 * Uebersicht der sechs Anlaesse. Der Entwurf zeigt hier nur die Kacheln —
 * Kopfzeile und Fusszeile kommen aus dem Layout, damit die Seite nicht als
 * einzige ohne Rahmen dasteht.
 */
---

<Marketing
  titel="Anlässe"
  beschreibung="Hochzeit, Firmenevent, Geburtstag, Abiball, Weihnachtsfeier, Silvester — was der jeweilige Abend braucht."
>
  {/* Ergänzung: der Entwurf zeigt hier nur Kacheln, ohne Überschrift. */}
  <section class="kopf">
    <span class="mono mono--amber">Anlässe</span>
    <h1>Sechs Abende, sechs Anforderungen</h1>
    <p class="fliess">
      Was eine Hochzeit braucht, stört auf der Messe — und umgekehrt. Hier steht je Anlass, welches
      Paket passt, welche Module sich lohnen und was Gäste erwarten.
    </p>
  </section>

  <section class="kacheln">
    {
      anlaesse.map((a) => (
        <a
          class="kachel"
          href={`/anlaesse/${a.id}`}
          style={`--grund:${a.grund};--text-eigen:${a.text};--akzent-eigen:${a.akzent}`}
        >
          <span class="kicker">{a.kicker}</span>
          <span class="titel">{a.titel}</span>
          <span class="zeile">{a.kachelzeile}</span>
          <span class="mehr">Ansehen →</span>
        </a>
      ))
    }
  </section>
</Marketing>

<style>
  .kopf {
    background: var(--ink);
    color: var(--text-hell);
    padding: 52px var(--rand) 56px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .kopf h1 {
    font-size: clamp(32px, 4vw, 54px);
    color: var(--text-hell);
  }

  .kopf .fliess {
    color: var(--text-hell-leise);
    max-width: 620px;
  }

  .kacheln {
    padding: 48px var(--rand) 64px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
  }

  .kachel {
    background: var(--grund);
    color: var(--text-eigen);
    border-radius: 16px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 200px;
    box-shadow: 0 3px 14px rgba(0, 0, 0, 0.1);
    transition: transform var(--t-transform), box-shadow var(--t-transform);
  }

  .kachel:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px -18px rgba(0, 0, 0, 0.55);
    color: var(--text-eigen);
  }

  .kicker {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--akzent-eigen);
  }

  .titel {
    font-weight: 800;
    letter-spacing: -0.025em;
    font-size: 30px;
    line-height: 1.05;
  }

  .zeile {
    font-size: 14px;
    line-height: 1.55;
    color: color-mix(in srgb, var(--text-eigen) 62%, transparent);
    flex: 1;
  }

  .mehr {
    font-weight: 600;
    font-size: 12.5px;
    color: var(--akzent-eigen);
  }
</style>
