---
import '../styles/global.css';

/**
 * Anmeldung zum Konto.
 *
 * Hier stand kurzzeitig eine Anmeldung über Wix mit Google-Knopf. Sie ist
 * wieder heraus: Der Weg braucht eine freigeschaltete Rücksprungadresse in
 * den Headless-Einstellungen, und eine Anmeldung, die beim ersten Klick in
 * eine Fehlermeldung läuft, ist schlimmer als eine, die es nicht gibt.
 *
 * Was bleibt, ist die Wahrheit: Ein Konto über mehrere Boxen hinweg gibt es
 * noch nicht. Die Box wird am Gerät selbst eingerichtet und hat ihre eigene
 * Anmeldung — die läuft, und sie läuft ohne Internet.
 */
---


<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Anmelden · youbooth</title>
    <meta name="description" content="Anmeldung zum youbooth-Cockpit: Boxen, Moderation, Druck-Queue, Buchungen." />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/favicon-180.png" />
    <meta name="theme-color" content="#0b0b0d" />
  </head>
  <body class="anmeldeseite">
    <main class="teilung">
      <section class="einordnung">
        <a class="marke" href="/">
          <img src="/assets/youbooth-mark.svg" alt="" width="30" height="30" />
          <span class="wortmarke">youbooth</span>
        </a>

        <div class="einordnung__text">
          <span class="mono mono--amber">Konto</span>
          <h1>Ein Konto für Lizenz, Download und Support</h1>
          <p class="fliess">
            Angemeldet wird über euer Google-Konto oder eure E-Mail — ein weiteres Kennwort
            braucht niemand.
          </p>
          <p class="fliess">
            Die Box im Saal hat davon nichts: Sie läuft ohne Internet und hat ihre eigene
            Anmeldung. Eine, die erst Google fragen muss, sperrt genau dann aus, wenn das WLAN
            der Scheune aussteigt.
          </p>
        </div>

        <span class="hinweis">
          <span class="mono mono--hell">Noch kein Konto?</span>
          <a class="knopf knopf--amber knopf--flach" href="/kontakt">Kostenlos testen</a>
        </span>
      </section>

      <section class="formularseite">
        <div class="anmeldung">
          <h2 class="frei">Es gibt noch kein Konto</h2>

          <p class="kleingedruckt">
            Ein Konto über mehrere Boxen hinweg — Lizenzen, Cloud-Galerie, Puls aller Boxen —
            entsteht mit dem Dienst dazwischen. Solange es ihn nicht gibt, wäre eine Anmeldung
            hier eine Tür ohne Raum dahinter.
          </p>

          <span class="trenner" aria-hidden="true"></span>

          <span class="mono">Was heute schon geht</span>
          <p class="kleingedruckt">
            Die Box richtet ihr am Gerät selbst ein: Sie fragt beim ersten Start nach Zugang,
            Firmendaten und Logo, und danach kommt niemand mehr ohne Anmeldung an Cockpit und
            Portal. Diese Anmeldung braucht kein Internet — eine, die erst Google fragen müsste,
            sperrte genau dann aus, wenn das WLAN der Scheune aussteigt.
          </p>

          <div class="kontowege">
            <a class="knopf knopf--amber knopf--flach" href="/download">Software laden</a>
            <a class="knopf knopf--rahmen knopf--flach" href="/support">Support</a>
            <a class="knopf knopf--rahmen knopf--flach" href="/kontakt">Kontakt</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="rechtszeile">
      <span>© 2026 youbooth</span>
      <span class="rechtszeile__links">
        <a href="/support">Support</a>
        <a href="/">Zur Website</a>
        <a href="/datenschutz">Datenschutz</a>
      </span>
    </footer>

    <style>
      .anmeldeseite {
        background: var(--ink);
      }

      .teilung {
        min-height: 100vh;
        display: flex;
        flex-wrap: wrap;
      }

      .einordnung {
        flex: 1;
        min-width: min(520px, 100%);
        background: var(--ink);
        color: var(--text-hell);
        padding: 44px var(--rand);
        display: flex;
        flex-direction: column;
        gap: 36px;
      }

      .marke {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--text-hell);
        text-decoration: none;
      }

      .marke img {
        display: block;
      }

      .wortmarke {
        font-weight: 900;
        font-size: 24px;
        letter-spacing: -0.04em;
        text-transform: lowercase;
      }

      .einordnung__text {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 24px;
        max-width: 520px;
      }

      .einordnung h1 {
        font-size: clamp(34px, 4vw, 54px);
        line-height: 1.02;
        color: var(--text-hell);
      }

      .einordnung .fliess {
        color: var(--text-hell-leise);
      }

      .zahlen {
        gap: 14px;
      }

      .zahlkachel {
        background: var(--ink-soft);
        border-radius: var(--r-chip);
        padding: 16px 20px;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .zahlkachel b {
        font-weight: 800;
        font-size: 28px;
        letter-spacing: -0.025em;
        line-height: 1;
      }

      .zahlkachel .mono {
        font-size: 10px;
        letter-spacing: 0.1em;
        color: var(--text-hell-still);
      }

      .hinweis {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
      }

      /* Formularseite */
      .formularseite {
        flex: 1;
        min-width: min(520px, 100%);
        background: var(--paper);
        padding: 44px var(--rand);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .anmeldung {
        width: 100%;
        max-width: 440px;
        background: var(--weiss);
        border: 1px solid var(--linie);
        border-radius: 16px;
        padding: 34px;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .frei {
        text-transform: none;
        font-size: 32px;
      }

      fieldset {
        border: none;
        margin: 0;
        padding: 0;
      }

      .wahl {
        display: flex;
        gap: 10px;
      }

      .wahl input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }

      .segment {
        flex: 1;
        height: 46px;
        border-radius: var(--r-pille);
        background: var(--paper-tief);
        color: var(--text-leise);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 13.5px;
        cursor: pointer;
        transition: background var(--t-farbe), color var(--t-farbe);
      }

      .wahl input:checked + .segment {
        background: var(--ink-soft);
        color: var(--weiss);
      }

      .wahl input:focus-visible + .segment {
        outline: 2px solid var(--amber);
        outline-offset: 3px;
      }

      .feld {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .eingabe {
        height: 52px;
        border-radius: var(--r-knopf);
        border: 1px solid rgba(0, 0, 0, 0.14);
        padding: 0 16px;
        font-family: var(--schrift);
        font-size: 14px;
        color: var(--text);
        background: var(--weiss);
        width: 100%;
      }

      .eingabe:focus {
        outline: none;
        border-color: var(--amber);
        box-shadow: 0 0 0 3px rgba(242, 178, 62, 0.18);
      }

      .eingabe[aria-invalid='true'] {
        border-color: var(--warn);
      }

      .passwortfeld {
        position: relative;
      }

      .zeigen {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        font-family: var(--mono);
        font-weight: 500;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-still);
      }

      .zeigen:hover {
        color: var(--text);
      }

      .zeile {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        font-size: 13px;
        color: rgba(0, 0, 0, 0.55);
      }

      .merken {
        display: flex;
        gap: 9px;
        align-items: center;
        cursor: pointer;
      }

      .merken input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }

      .kasten {
        width: 17px;
        height: 17px;
        border-radius: 4px;
        border: 1px solid rgba(0, 0, 0, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 700;
        color: transparent;
      }

      .merken input:checked + .kasten {
        background: var(--amber);
        border-color: var(--amber);
        color: var(--amber-ink);
      }

      .vergessen {
        font-weight: 500;
      }

      .ins-cockpit {
        height: 54px;
        font-size: 15.5px;
        width: 100%;
      }

      .meldung {
        font-size: 12.5px;
        line-height: 1.5;
        color: var(--warn-text);
      }

      .trenner {
        height: 1px;
        background: rgba(0, 0, 0, 0.08);
        display: block;
        margin: 4px 0;
      }

      .kopplung {
        display: flex;
        gap: 10px;
        align-items: center;
      }

      .eingabe--code {
        font-family: var(--mono);
        font-weight: 500;
        font-size: 16px;
        letter-spacing: 0.24em;
      }

      .knopf--flach {
        height: 52px;
        font-size: 13.5px;
        flex: none;
      }

      .fussnote {
        font-size: 12.5px;
        line-height: 1.55;
        color: rgba(0, 0, 0, 0.5);
      }

      /* Rechtszeile */
      .rechtszeile {
        background: var(--ink);
        color: var(--text-hell-fein);
        padding: 34px var(--rand);
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        border-top: 1px solid var(--linie-dunkel-zart);
        font-family: var(--mono);
        font-weight: 500;
        font-size: 10.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .rechtszeile__links {
        display: flex;
        gap: 20px;
      }

      .rechtszeile a {
        color: rgba(244, 242, 238, 0.55);
      }

      .rechtszeile a:hover {
        color: var(--text-hell);
      }
    </style>

  </body>
</html>
