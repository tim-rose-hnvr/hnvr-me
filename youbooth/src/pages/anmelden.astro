---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import '../styles/global.css';

/**
 * Anmeldung zum Konto.
 *
 * Angemeldet wird über Wix — die Website ist ein Wix-Headless-Projekt, und
 * damit führt Wix den Weg selbst: Google, Facebook oder E-Mail. Wir bauen
 * weder Kennwortprüfung noch Nutzerverwaltung.
 *
 * Das ist ausdrücklich NICHT die Anmeldung an der Box. Die hat ihre eigene,
 * mit eigenem Kennwort, weil sie in einer Scheune ohne Netz laufen muss.
 */

/* Die Kennung des Headless-Kunden steht in `wix.config.json` — gelesen statt
   getippt, damit sie nicht auseinanderläuft, wenn das Projekt wechselt. */
const kennung: string = JSON.parse(
  readFileSync(join(process.cwd(), 'wix.config.json'), 'utf8')
).appId;
---

---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Anmelden · youbooth</title>
    <meta name="description" content="Anmeldung zum youbooth-Cockpit: Boxen, Moderation, Druck-Queue, Buchungen." />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/favicon-180.png" />
    <meta name="theme-color" content="#0b0b0d" />
  </head>
  <body class="anmeldeseite">
    <main class="teilung">
      <section class="einordnung">
        <a class="marke" href="/">
          <img src="/assets/youbooth-mark.svg" alt="" width="30" height="30" />
          <span class="wortmarke">youbooth</span>
        </a>

        <div class="einordnung__text">
          <span class="mono mono--amber">Konto</span>
          <h1>Ein Konto für Lizenz, Download und Support</h1>
          <p class="fliess">
            Angemeldet wird über euer Google-Konto oder eure E-Mail — ein weiteres Kennwort
            braucht niemand.
          </p>
          <p class="fliess">
            Die Box im Saal hat davon nichts: Sie läuft ohne Internet und hat ihre eigene
            Anmeldung. Eine, die erst Google fragen muss, sperrt genau dann aus, wenn das WLAN
            der Scheune aussteigt.
          </p>
        </div>

        <span class="hinweis">
          <span class="mono mono--hell">Noch kein Konto?</span>
          <a class="knopf knopf--amber knopf--flach" href="/kontakt">14 Tage testen</a>
        </span>
      </section>

      <section class="formularseite">
        <div class="anmeldung" data-anmeldung>
          <h2 class="frei" data-feld="titel">Anmelden</h2>

          <div data-feld="wege">
            <button class="knopf knopf--amber knopf--breit" type="button" data-tue="google">
              Mit Google anmelden
            </button>
            <button class="knopf knopf--rahmen knopf--breit" type="button" data-tue="wix">
              Mit E-Mail anmelden
            </button>
            <span class="mono mono--hell">
              Noch kein Konto? Beim ersten Anmelden entsteht es.
            </span>
          </div>

          <div data-feld="konto" hidden>
            <span class="mono mono--hell">Angemeldet als</span>
            <b class="kontoname" data-feld="name"></b>
            <span class="mono" data-feld="mail"></span>
            <div class="kontowege">
              <a class="knopf knopf--rahmen knopf--flach" href="/download">Software laden</a>
              <a class="knopf knopf--rahmen knopf--flach" href="/support">Support</a>
              <button class="knopf knopf--rahmen knopf--flach" type="button" data-tue="raus">
                Abmelden
              </button>
            </div>
          </div>

          <span class="meldung" data-feld="meldung" role="status" hidden></span>

          <span class="trenner" aria-hidden="true"></span>

          <span class="mono">Box am Eventort einrichten</span>
          <p class="kleingedruckt">
            Die Box richtet ihr am Gerät selbst ein — sie fragt beim ersten Start nach Zugang,
            Firmendaten und Logo. Dieses Konto hier braucht sie dafür nicht.
          </p>
        </div>
      </section>
    </main>

    <footer class="rechtszeile">
      <span>© 2026 youbooth</span>
      <span class="rechtszeile__links">
        <a href="/support">Support</a>
        <a href="/">Zur Website</a>
        <a href="/datenschutz">Datenschutz</a>
      </span>
    </footer>

    <script define:vars={{ kennung }}>
      window.__youboothWix = kennung;
    </script>

    <script>
      import { abmelden, angemeldet, melde } from '../lib/wix';

      const wurzel = document.querySelector('[data-anmeldung]');
      const kennung = window.__youboothWix;

      if (wurzel && kennung) {
        const wege = wurzel.querySelector('[data-feld="wege"]');
        const konto = wurzel.querySelector('[data-feld="konto"]');
        const titel = wurzel.querySelector('[data-feld="titel"]');
        const meldung = wurzel.querySelector('[data-feld="meldung"]');

        const sage = (text) => {
          meldung.textContent = text;
          meldung.hidden = !text;
        };

        /* Erst nachsehen, ob schon jemand angemeldet ist — sonst zeigt die
           Seite Anmeldeknöpfe an jemanden, der längst drin ist. */
        angemeldet(kennung).then((wer) => {
          if (!wer) return;
          wege.hidden = true;
          konto.hidden = false;
          titel.textContent = 'Willkommen zurück';
          wurzel.querySelector('[data-feld="name"]').textContent = wer.name;
          wurzel.querySelector('[data-feld="mail"]').textContent = wer.email;
        });

        wurzel.addEventListener('click', async (e) => {
          const knopf = e.target.closest('[data-tue]');
          if (!knopf) return;

          if (knopf.dataset.tue === 'raus') return abmelden();

          knopf.disabled = true;
          sage('Einen Moment …');
          const { fehler } = await melde(kennung, knopf.dataset.tue === 'google' ? 'google' : undefined);
          if (fehler) {
            knopf.disabled = false;
            sage(fehler);
          }
        });
      }
    </script>

    <style>
      .anmeldeseite {
        background: var(--ink);
      }

      .teilung {
        min-height: 100vh;
        display: flex;
        flex-wrap: wrap;
      }

      .einordnung {
        flex: 1;
        min-width: min(520px, 100%);
        background: var(--ink);
        color: var(--text-hell);
        padding: 44px var(--rand);
        display: flex;
        flex-direction: column;
        gap: 36px;
      }

      .marke {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--text-hell);
        text-decoration: none;
      }

      .marke img {
        display: block;
      }

      .wortmarke {
        font-weight: 900;
        font-size: 24px;
        letter-spacing: -0.04em;
        text-transform: lowercase;
      }

      .einordnung__text {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 24px;
        max-width: 520px;
      }

      .einordnung h1 {
        font-size: clamp(34px, 4vw, 54px);
        line-height: 1.02;
        color: var(--text-hell);
      }

      .einordnung .fliess {
        color: var(--text-hell-leise);
      }

      .zahlen {
        gap: 14px;
      }

      .zahlkachel {
        background: var(--ink-soft);
        border-radius: var(--r-chip);
        padding: 16px 20px;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .zahlkachel b {
        font-weight: 800;
        font-size: 28px;
        letter-spacing: -0.025em;
        line-height: 1;
      }

      .zahlkachel .mono {
        font-size: 10px;
        letter-spacing: 0.1em;
        color: var(--text-hell-still);
      }

      .hinweis {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
      }

      /* Formularseite */
      .formularseite {
        flex: 1;
        min-width: min(520px, 100%);
        background: var(--paper);
        padding: 44px var(--rand);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .anmeldung {
        width: 100%;
        max-width: 440px;
        background: var(--weiss);
        border: 1px solid var(--linie);
        border-radius: 16px;
        padding: 34px;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .frei {
        text-transform: none;
        font-size: 32px;
      }

      fieldset {
        border: none;
        margin: 0;
        padding: 0;
      }

      .wahl {
        display: flex;
        gap: 10px;
      }

      .wahl input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }

      .segment {
        flex: 1;
        height: 46px;
        border-radius: var(--r-pille);
        background: #f2efe9;
        color: var(--text-leise);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 13.5px;
        cursor: pointer;
        transition: background var(--t-farbe), color var(--t-farbe);
      }

      .wahl input:checked + .segment {
        background: var(--ink-soft);
        color: var(--weiss);
      }

      .wahl input:focus-visible + .segment {
        outline: 2px solid var(--amber);
        outline-offset: 3px;
      }

      .feld {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .eingabe {
        height: 52px;
        border-radius: var(--r-knopf);
        border: 1px solid rgba(0, 0, 0, 0.14);
        padding: 0 16px;
        font-family: var(--schrift);
        font-size: 14px;
        color: var(--text);
        background: var(--weiss);
        width: 100%;
      }

      .eingabe:focus {
        outline: none;
        border-color: var(--amber);
        box-shadow: 0 0 0 3px rgba(242, 178, 62, 0.18);
      }

      .eingabe[aria-invalid='true'] {
        border-color: var(--warn);
      }

      .passwortfeld {
        position: relative;
      }

      .zeigen {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        font-family: var(--mono);
        font-weight: 500;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-still);
      }

      .zeigen:hover {
        color: var(--text);
      }

      .zeile {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        font-size: 13px;
        color: rgba(0, 0, 0, 0.55);
      }

      .merken {
        display: flex;
        gap: 9px;
        align-items: center;
        cursor: pointer;
      }

      .merken input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }

      .kasten {
        width: 17px;
        height: 17px;
        border-radius: 4px;
        border: 1px solid rgba(0, 0, 0, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 700;
        color: transparent;
      }

      .merken input:checked + .kasten {
        background: var(--amber);
        border-color: var(--amber);
        color: var(--amber-ink);
      }

      .vergessen {
        font-weight: 500;
      }

      .ins-cockpit {
        height: 54px;
        font-size: 15.5px;
        width: 100%;
      }

      .meldung {
        font-size: 12.5px;
        line-height: 1.5;
        color: #a5291f;
      }

      .trenner {
        height: 1px;
        background: rgba(0, 0, 0, 0.08);
        display: block;
        margin: 4px 0;
      }

      .kopplung {
        display: flex;
        gap: 10px;
        align-items: center;
      }

      .eingabe--code {
        font-family: var(--mono);
        font-weight: 500;
        font-size: 16px;
        letter-spacing: 0.24em;
      }

      .knopf--flach {
        height: 52px;
        font-size: 13.5px;
        flex: none;
      }

      .fussnote {
        font-size: 12.5px;
        line-height: 1.55;
        color: rgba(0, 0, 0, 0.5);
      }

      /* Rechtszeile */
      .rechtszeile {
        background: var(--ink);
        color: var(--text-hell-fein);
        padding: 34px var(--rand);
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        border-top: 1px solid var(--linie-dunkel-zart);
        font-family: var(--mono);
        font-weight: 500;
        font-size: 10.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .rechtszeile__links {
        display: flex;
        gap: 20px;
      }

      .rechtszeile a {
        color: rgba(244, 242, 238, 0.55);
      }

      .rechtszeile a:hover {
        color: var(--text-hell);
      }
    </style>

    <script>
      const formular = document.querySelector<HTMLFormElement>('.anmeldung');

      if (formular) {
        const passwort = formular.querySelector<HTMLInputElement>('#passwort')!;
        const email = formular.querySelector<HTMLInputElement>('#email')!;
        const zeigen = formular.querySelector<HTMLButtonElement>('[data-feld="zeigen"]')!;
        const meldung = formular.querySelector<HTMLElement>('[data-feld="meldung"]')!;
        const koppeln = formular.querySelector<HTMLButtonElement>('[data-feld="koppeln"]')!;
        const code = formular.querySelector<HTMLInputElement>('#code')!;

        zeigen.addEventListener('click', () => {
          const sichtbar = passwort.type === 'text';
          passwort.type = sichtbar ? 'password' : 'text';
          zeigen.textContent = sichtbar ? 'Anzeigen' : 'Verbergen';
        });

        function sage(text: string) {
          meldung.textContent = text;
          meldung.hidden = text === '';
        }

        formular.addEventListener('submit', (e) => {
          // Solange kein Anmeldedienst existiert, wird hier abgefangen.
          e.preventDefault();
          const mailOk = /^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(email.value.trim());
          const passOk = passwort.value.length >= 6;

          email.setAttribute('aria-invalid', String(!mailOk));
          passwort.setAttribute('aria-invalid', String(!passOk));

          if (!mailOk) return sage('Bitte eine vollständige E-Mail-Adresse angeben.');
          if (!passOk) return sage('Das Passwort ist zu kurz.');
          sage('Das Cockpit ist noch nicht angebunden — die Anmeldung folgt mit dem Dienst.');
        });

        koppeln.addEventListener('click', () => {
          const sauber = code.value.replace(/\D/g, '');
          if (sauber.length !== 6) {
            code.setAttribute('aria-invalid', 'true');
            return sage('Der Kopplungscode hat sechs Ziffern.');
          }
          code.removeAttribute('aria-invalid');
          sage(`Code ${sauber} vorgemerkt — die Kopplung folgt mit dem Dienst.`);
        });
      }
    </script>
  </body>
</html>
