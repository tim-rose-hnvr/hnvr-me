---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Marketing from '../layouts/Marketing.astro';
import Icon from '../components/Icon.astro';

/**
 * Download-Portal.
 *
 * Die Fassungsnummer wird nicht getippt, sondern gelesen — aus derselben
 * `booth/package.json`, aus der auch die Box ihre Fassung nimmt und mit der
 * `electron-builder` den Installer benennt. Stand sie hier von Hand, zeigte
 * die Seite irgendwann auf eine Datei, die es nicht gibt.
 */
const version: string = JSON.parse(
  readFileSync(join(process.cwd(), '..', 'booth', 'package.json'), 'utf8')
).version;

/* Die Release ist zugleich die Quelle der Selbstaktualisierung: Die
   installierte App fragt dieselbe Liste ab. Eine zweite Ablage für Installer
   gäbe es damit nicht — zwei Listen laufen auseinander. */
const releases = 'https://github.com/tim-rose-hnvr/hnvr-me/releases';
const datei = (name: string) => `${releases}/download/booth-v${version}/${name}`;

const plattformen = [
  {
    id: 'windows',
    name: 'Windows',
    marke: 'Installer',
    text: 'Windows 10 oder 11, 64 Bit. Bringt die Box mit — Aufnahmen, Cockpit, Portal und Druck laufen ohne weitere Installation.',
    zeilen: [`V${version} · EXE`, 'Systemdruck · Vollbild · aktualisiert sich selbst'],
    knopf: 'Für Windows laden',
    ziel: datei(`youbooth-Setup-${version}.exe`),
    bereit: true,
  },
  {
    id: 'macos',
    name: 'macOS',
    marke: 'Kommt',
    text: 'Gebaut wird dasselbe Paket, nur noch nicht veröffentlicht: Ohne Apple-Konto zum Signieren und Notarisieren blockt Gatekeeper den Start.',
    zeilen: ['Apple Silicon und Intel', 'CUPS-Druck · Vollbild'],
    knopf: 'Alle Fassungen ansehen',
    ziel: releases,
    bereit: false,
  },
  {
    id: 'linux',
    name: 'Linux',
    marke: 'Kommt',
    text: 'AppImage aus demselben Bau. Wird veröffentlicht, sobald wir es auf einer echten Box durchgemessen haben.',
    zeilen: ['AppImage · x64', 'CUPS-Druck'],
    knopf: 'Alle Fassungen ansehen',
    ziel: releases,
    bereit: false,
  },
  {
    id: 'browser',
    name: 'Ohne Installation',
    marke: 'Im Netz der Box',
    text: 'Läuft die Box, erreicht jedes Gerät im WLAN dieselben Oberflächen: Foto-Wall am Beamer, Galerie am Handy, Cockpit am Laptop. Nur Vollbild und Selbstaktualisierung fehlen.',
    zeilen: ['Chrome · Safari · Edge', 'Keine Installation nötig'],
    knopf: 'Oberflächen ansehen',
    ziel: '/oberflaechen/fotobox-system',
    bereit: true,
  },
];

const neuerungen = [
  'Betreiber-Portal: Buchungen, Kalender, Pakete, Event-Seiten und Tickets an einer Stelle',
  'Öffentliche Buchungsseite — belegte Tage sind gar nicht erst anklickbar',
  'Event-Seiten für Kunden, mit Kennwort und Ablaufdatum',
  'Foto-Wall, Galerie und Cockpit zeigen denselben Stand, auf jedem Gerät im WLAN',
  '55 Druckvorlagen auf sieben Papierformaten, im Editor umbaubar',
];

/* Ältere Fassungen stehen an einer Stelle, und die ist die Release-Liste
   selbst. Sie hier abzuschreiben hieße, sie zweimal zu pflegen. */

const dateien = [
  {
    kennung: 'Vorlagen',
    titel: '55 Layouts',
    text: 'Liegen im Installationspaket. Der Editor auf der Box baut daraus eigene — nichts nachzuladen.',
    knopf: 'Galerie ansehen',
    ziel: '/vorlagen',
  },
  {
    kennung: 'Screen-Sets',
    titel: 'Animationen',
    text: 'Wartebildschirme, Countdowns und Cheese-Momente je Anlass, pro Event zuweisbar.',
    knopf: 'Sets ansehen',
    ziel: '/oberflaechen/booth-animationen',
  },
  {
    kennung: 'Marke',
    titel: 'Logo & Icons',
    text: 'Signet, Wortmarke, 26 Icons und Favicons als SVG und PNG.',
    knopf: 'Design-System',
    ziel: '/design-system',
  },
  {
    kennung: 'Papier',
    titel: 'Checklisten',
    text: 'Aufbau, Übergabe und Packliste als PDF, zum Ausdrucken für Aushilfen.',
    knopf: 'PDF laden · 2 Seiten',
    ziel: '/support',
  },
];
---

<Marketing
  titel="Download"
  beschreibung={`youbooth ${version} für Windows herunterladen — ein Paket, das die ganze Box mitbringt.`}
>
  <section class="hero">
    <div class="hero__text">
      <span class="mono mono--amber">Download · v{version}</span>
      <h1>Herunterladen, installieren, läuft</h1>
      <p class="fliess">
        Ein Paket, und die Box ist vollständig: Booth, Cockpit, Portal, Druck und die 55 Vorlagen.
        Kein Konto nötig, kein Internet im Saal — und neue Fassungen holt sie sich selbst.
      </p>
      <div class="zahlenzeile">
        <span class="mono mono--hell">Aktualisiert sich selbst</span>
        <span class="mono mono--hell">Läuft ohne Internet</span>
        <span class="mono mono--hell">Quelltext offen</span>
      </div>
    </div>

    {/* Was hier steht, ersetzt das Skript unten durch das erkannte System.
        Ohne JavaScript bleibt Windows stehen — das häufigste System und
        das einzige, für das es heute ein Paket gibt. */}
    <div class="holen" data-holen>
      <span class="mono mono--hell" data-feld="erkannt">Für euer System</span>
      <a
        class="knopf knopf--amber knopf--mittel holen__knopf"
        data-feld="knopf"
        href={datei(`youbooth-Setup-${version}.exe`)}
        download
      >
        Für Windows laden
      </a>
      <span class="holen__zeile mono" data-feld="zeile">V{version} · EXE · 64 Bit</span>
      <a class="pfeil pfeil--klein" href={releases}>Alle Fassungen und Systeme →</a>
    </div>
  </section>

  <section class="abschnitt">
    <h2>Plattformen</h2>
    <div class="raster raster--breit">
      {
        plattformen.map((p) => (
          <article class:list={['karte', 'plattform']} data-system={p.id}>
            <div class="plattform__kopf">
              <span class="plattform__zeichen">
                <Icon name="box" groesse={24} />
              </span>
              <span class="mono">{p.marke}</span>
            </div>
            <span class="display display--klein">{p.name}</span>
            <span class="karte__text">{p.text}</span>
            <div class="plattform__daten">
              {p.zeilen.map((z) => (
                <span class="mono">{z}</span>
              ))}
            </div>
            <a
              class:list={['knopf', 'knopf--flach', 'plattform__knopf', p.bereit ? 'knopf--dunkel' : 'knopf--rahmen']}
              href={p.ziel}
            >
              {p.knopf}
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="abschnitt zweispalter">
    <div class="spalte">
      <h2>Was in V{version} steckt</h2>
      <article class="karte">
        <div class="versionskopf">
          <span class="mono">V{version}</span>
          <span class="marke marke--aktuell">Aktuell</span>
        </div>
        <ul class="punkte">
          {neuerungen.map((n) => <li>{n}</li>)}
        </ul>
      </article>
      <a class="pfeil pfeil--klein" href={releases}>Alle Fassungen mit Änderungen →</a>
    </div>

    <div class="spalte spalte--schmal">
      <h2>Wie sich die Box aktualisiert</h2>
      <article class="karte">
        <span class="mono">Von selbst, aber nicht mittendrin</span>
        <span class="display display--klein">Beim Beenden</span>
        <span class="karte__text">
          Die installierte App sieht täglich nach, ob es eine neue Fassung gibt, und lädt sie
          im Hintergrund. Eingespielt wird sie beim nächsten Beenden — ein Neustart mitten in
          einer Feier ist der teuerste Fehler, den eine Selbstaktualisierung machen kann.
          Wer nicht warten will, bekommt einen Knopf dafür.
        </span>
        <a class="pfeil pfeil--klein" href="/hilfe">Ablauf nachlesen →</a>
      </article>
    </div>
  </section>

</Marketing>

<script>
  /* Welches System sitzt davor?
     `userAgentData.platform` ist die neue, ehrliche Auskunft; sie fehlt in
     Safari und Firefox, deshalb daneben der alte `userAgent`. Geraten wird
     nur, was der Browser hergibt — und wenn nichts passt, bleibt Windows
     stehen: das häufigste System und das einzige mit fertigem Paket. */
  type Erkannt = { id: string; name: string; knopf: string; zeile: string; bereit: boolean };

  const daten = document.querySelector<HTMLElement>('[data-holen]');

  if (daten) {
    const knopf = daten.querySelector<HTMLAnchorElement>('[data-feld="knopf"]')!;
    const erkanntFeld = daten.querySelector<HTMLElement>('[data-feld="erkannt"]')!;
    const zeileFeld = daten.querySelector<HTMLElement>('[data-feld="zeile"]')!;
    const windowsZiel = knopf.href;
    const alle = knopf.parentElement!.querySelector<HTMLAnchorElement>('.pfeil')!.href;

    const roh = (
      (navigator as any).userAgentData?.platform ||
      navigator.platform ||
      navigator.userAgent ||
      ''
    ).toLowerCase();

    const istHandy = /android|iphone|ipad|ipod/.test(navigator.userAgent.toLowerCase());

    const systeme: Erkannt[] = [
      { id: 'windows', name: 'Windows', knopf: 'Für Windows laden', zeile: 'EXE · 64 Bit', bereit: true },
      { id: 'macos', name: 'macOS', knopf: 'Alle Fassungen ansehen', zeile: 'Paket noch nicht veröffentlicht — es fehlt die Signatur von Apple', bereit: false },
      { id: 'linux', name: 'Linux', knopf: 'Alle Fassungen ansehen', zeile: 'AppImage folgt', bereit: false },
      { id: 'handy', name: 'Handy oder Tablet', knopf: 'Oberflächen ansehen', zeile: 'Die Box läuft auf einem Rechner — vom Handy erreicht ihr sie im WLAN', bereit: false },
    ];

    const gewaehlt = istHandy
      ? systeme[3]
      : /mac/.test(roh)
        ? systeme[1]
        : /linux|x11|ubuntu|fedora/.test(roh)
          ? systeme[2]
          : systeme[0];

    erkanntFeld.textContent = `Erkannt: ${gewaehlt.name}`;
    knopf.textContent = gewaehlt.knopf;
    zeileFeld.textContent = gewaehlt.bereit
      ? zeileFeld.textContent!.replace('EXE · 64 Bit', gewaehlt.zeile)
      : gewaehlt.zeile;

    if (gewaehlt.bereit) {
      knopf.href = windowsZiel;
      knopf.setAttribute('download', '');
    } else {
      knopf.href = gewaehlt.id === 'handy' ? '/oberflaechen/fotobox-system' : alle;
      knopf.removeAttribute('download');
    }

    // Und die passende Karte weiter unten hervorheben.
    const karte = document.querySelector<HTMLElement>(`[data-system="${gewaehlt.id}"]`);
    karte?.classList.add('hervor');
  }
</script>

<style>
  .hero {
    background: var(--ink);
    color: var(--text-hell);
    padding: 56px var(--rand) 60px;
    display: flex;
    gap: 44px;
    flex-wrap: wrap;
    align-items: flex-end;
  }

  .hero__text {
    flex: 1 1 460px;
    min-width: min(430px, 100%);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .hero h1 {
    font-size: clamp(34px, 4vw, 56px);
  }

  .hero .fliess {
    color: var(--text-hell-leise);
    max-width: 560px;
  }

  .zahlenzeile {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .zahlenzeile .mono {
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: rgba(244, 242, 238, 0.45);
  }

  .lizenz {
    flex: 1 1 320px;
    min-width: min(300px, 100%);
    background: var(--ink-soft);
    border-radius: 16px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .lizenz .mono--hell {
    color: var(--text-hell-still);
  }

  .lizenz__feld {
    height: 48px;
    border-radius: var(--r-knopf);
    border: 1px solid rgba(244, 242, 238, 0.18);
    background: transparent;
    padding: 0 14px;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 15px;
    letter-spacing: 0.22em;
    color: var(--text-hell);
    width: 100%;
  }

  .lizenz__feld::placeholder {
    color: rgba(244, 242, 238, 0.4);
  }

  .lizenz__feld:focus {
    outline: none;
    border-color: var(--amber);
    box-shadow: 0 0 0 3px rgba(242, 178, 62, 0.2);
  }

  .knopf--flach {
    height: 46px;
    font-size: 14px;
    width: 100%;
  }

  .lizenz__hinweis {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--text-hell-still);
  }

  /* Plattformen */
  .raster--breit {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }

  .plattform {
    gap: 12px;
  }

  .plattform.hervor {
    border-color: var(--ink-soft);
    border-width: 2px;
  }

  .plattform__kopf {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .plattform__zeichen {
    width: 44px;
    height: 44px;
    border-radius: var(--r-knopf);
    background: #f2efe9;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
  }

  .plattform__zeichen.dunkel {
    background: var(--ink-soft);
    color: var(--text-hell);
    animation: atmen 4s ease-in-out infinite;
  }

  .plattform__daten {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .plattform__daten .mono {
    font-size: 11px;
    letter-spacing: 0.06em;
    color: rgba(0, 0, 0, 0.5);
  }

  .plattform__knopf {
    margin-top: auto;
  }

  @keyframes atmen {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plattform__zeichen.dunkel {
      animation: none;
    }
  }

  /* Versionen */
  .zweispalter {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 26px;
    align-items: flex-start;
  }

  .spalte {
    flex: 1 1 420px;
    min-width: min(400px, 100%);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .spalte--schmal {
    flex: 1 1 320px;
    min-width: min(300px, 100%);
  }

  .versionskopf {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .marke--aktuell {
    font-family: var(--mono);
    font-weight: 600;
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--amber);
    color: var(--amber-ink);
    padding: 4px 9px;
    border-radius: 5px;
  }

  .aeltere {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .aeltere__zeile {
    font-size: 13.5px;
    color: var(--text-leise);
  }

  .aeltere__zeile b {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 12px;
    color: var(--text);
  }

  /* Boxenliste */
  .boxen {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .boxzeile {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
  }

  .lampe {
    width: 9px;
    height: 9px;
    border-radius: var(--r-kreis);
    flex: none;
    display: block;
  }

  .lampe--ok {
    background: var(--ok);
  }

  .lampe--warten {
    background: var(--amber);
  }

  .lampe--weg {
    background: var(--warn);
  }

  .boxzeile__name {
    font-weight: 600;
    color: var(--text);
  }

  .boxzeile__stand {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--text-still);
  }

  /* Schluss */
  .schluss {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    flex-wrap: wrap;
    padding-block: 52px;
  }

  .schluss__text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 640px;
  }

  .schluss .display {
    font-size: clamp(26px, 2.6vw, 32px);
    line-height: 1.05;
  }

  .beiwort {
    font-size: 15px;
    color: var(--text-hell-leise);
  }

  .knopfreihe {
    gap: 12px;
  }

  .pfeil--klein {
    font-size: 13px;
  }

  .holen {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 28px;
    border-radius: var(--r-karte-gross);
    border: 1px solid var(--linie-dunkel);
    background: rgba(244, 242, 238, 0.04);
  }

  .holen__knopf { width: 100%; justify-content: center; }

  .holen__zeile { color: var(--text-hell-still); }
</style>
