---
import Marketing from '../../layouts/Marketing.astro';
import {
  vorlagen,
  anlaesseDerVorlagen,
  formateDerVorlagen,
  formatname,
  bibliothek,
} from '../../daten/vorlagen';

/**
 * Vorlagen-Galerie. Jedes Blatt hier ist ein echter Abzug aus dem Katalog,
 * gezeichnet vom selben Renderer, der auch druckt — kein Nachbau. Anlass und
 * Format kombinieren sich mit UND, gefiltert wird im Browser.
 */

const kennzahlen = [
  `${bibliothek.gesamt} Vorlagen mitgeliefert`,
  `${bibliothek.streifen} Streifen · ${bibliothek.einzelbild} Einzelbild`,
  `${bibliothek.formate} Papierformate belegt, 7 möglich`,
  'Eigene Layouts auf Zuruf',
];
---

<Marketing
  titel="Vorlagen-Galerie"
  beschreibung="Kein Store, keine Einzelkäufe: jedes Design gehört zur Lizenz und kommt als Set — Fotoformat, Streifen, 4er-Raster und Screen-Variante."
>
  <section class="hero">
    <span class="mono mono--amber">Vorlagen-Galerie · alles inklusive</span>
    <h1>Alle {bibliothek.gesamt} Vorlagen, ohne Aufpreis</h1>
    <p class="fliess">
      Kein Store, keine Einzelkäufe: Was hier steht, liegt auf jeder Box. Und es sind echte
      Abzüge — gezeichnet von demselben Renderer, der auf das Papier druckt. Filter unten
      klicken, Kombination sofort sehen.
    </p>
    <div class="zahlenzeile">
      {kennzahlen.map((k) => <span class="mono mono--hell">{k}</span>)}
    </div>
  </section>

  <div class="galerie">
    <div class="filter">
      <button class="chip on" type="button" data-anlass="alle" aria-pressed="true">
        Alle Anlässe
      </button>
      {
        anlaesseDerVorlagen.map((a) => (
          <button class="chip" type="button" data-anlass={a.name} aria-pressed="false">
            {a.name} <span class="chip__zahl">{a.zahl}</span>
          </button>
        ))
      }

      <span class="trenner" aria-hidden="true"></span>

      <button class="chip on" type="button" data-format="alle" aria-pressed="true">
        Alle Formate
      </button>
      {
        formateDerVorlagen.map((f) => (
          <button class="chip" type="button" data-format={f.schluessel} aria-pressed="false">
            {f.name} <span class="chip__zahl">{f.zahl}</span>
          </button>
        ))
      }

      <span class="filter__rechts">
        <span class="mono" data-feld="treffer" role="status">
          {vorlagen.length} von {vorlagen.length} Vorlagen
        </span>
        <button class="knopf knopf--rahmen knopf--klein" type="button" data-feld="zuruecksetzen">Zurücksetzen</button>
      </span>
    </div>

    <div class="inhalt">
      <article class="leerkarte" data-feld="leer" hidden>
        <span class="mono">Kein Treffer</span>
        <h2 class="frei">Nichts in dieser Kombination</h2>
        <span class="leerkarte__text">
          Wir bauen Layouts auch auf Zuruf — schickt Farben, Schrift und Logo, das Blatt kommt
          in jedem der sieben Formate zurück.
        </span>
        <a class="pfeil pfeil--klein" href="/kontakt">Layout anfragen →</a>
      </article>

      <div class="raster">
        {
          vorlagen.map((v, i) => (
            <article
              class="vorlage"
              data-vorlage
              data-anlass-wert={v.anlass}
              data-format-wert={v.format}
              style={`--verzug:${(Math.min(i, 12) * 0.04).toFixed(2)}s`}
            >
              <div class="vorlage__blatt">
                <img
                  src={v.bild}
                  width={v.breite}
                  height={v.hoehe}
                  alt={`Vorlage ${v.name}, ${formatname(v.format)}`}
                  loading={i < 6 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
              <div class="vorlage__fuss">
                <span class="vorlage__name">{v.name}</span>
                <span class="mono">
                  {v.anlass} · {v.art === 'streifen' ? `${v.aufnahmen} Aufnahmen` : 'Einzelbild'}
                </span>
                <div class="marken">
                  <span class="marke marke--inklusive">Inklusive</span>
                  <span class="marke">{formatname(v.format)}</span>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <p class="platzhalterhinweis">
        Die Personen auf den Blättern sind Platzhalter, keine Aufnahmen. Alles andere — Ränder,
        Schriftmischung, Datumszeile, Beschnitt — ist das, was der Drucker ausgibt.
      </p>

    </div>
  </div>

  <section class="abschnitt abschnitt--dunkel">
    <h2>Sammlungen nach Anlass</h2>
    <p class="fliess">
      Die Zahlen sind gezählt, nicht geschätzt: So viele Blätter liegen zu jedem Anlass auf der
      Box. Was fehlt, bauen wir dazu.
    </p>
    <div class="raster raster--schmal">
      {
        anlaesseDerVorlagen.map((a) => (
          <article class="sammlung">
            <span class="sammlung__titel">
              {a.name} · {a.zahl}
            </span>
            <span class="sammlung__text">
              {vorlagen
                .filter((v) => v.anlass === a.name)
                .map((v) => formatname(v.format))
                .filter((f, i, alle) => alle.indexOf(f) === i)
                .join(' · ')}
            </span>
          </article>
        ))
      }
      <article class="sammlung sammlung--wunsch">
        <span class="mono mono--amber">Auf Wunsch</span>
        <span class="sammlung__titel">Euer eigenes Layout</span>
        <span class="sammlung__text">Ebenfalls ohne Aufpreis, Lieferung in zwei Werktagen.</span>
        <a class="knopf knopf--rahmen-hell knopf--flach" href="/kontakt">Anfragen</a>
      </article>
    </div>
  </section>
</Marketing>

<style>
  .hero {
    background: var(--ink);
    color: var(--text-hell);
    padding: 52px var(--rand) 56px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hero h1 {
    font-size: clamp(32px, 4.2vw, 56px);
  }

  .hero .fliess {
    color: var(--text-hell-leise);
    max-width: 640px;
  }

  .zahlenzeile {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .zahlenzeile .mono {
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--text-hell) 45%, transparent);
  }

  .filter {
    padding: 24px var(--rand) 20px;
    display: flex;
    gap: 9px;
    flex-wrap: wrap;
    align-items: center;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .trenner {
    width: 1px;
    height: 24px;
    background: rgba(0, 0, 0, 0.12);
    display: block;
    margin: 0 5px;
  }

  .filter__rechts {
    margin-left: auto;
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .inhalt {
    padding: 30px var(--rand) 56px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .leerkarte {
    background: var(--weiss);
    border: 1px dashed rgba(0, 0, 0, 0.2);
    border-radius: var(--r-karte);
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    align-items: flex-start;
  }

  .frei {
    font-size: 22px;
    letter-spacing: -0.02em;
  }

  .leerkarte__text {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--text-leise);
  }

  .raster {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 24px;
  }

  .vorlage {
    background: var(--weiss);
    border: 1px solid var(--linie);
    border-radius: var(--r-karte);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    animation: einfliegen 0.45s ease-out both var(--verzug);
  }

  /* Die Blätter haben sieben verschiedene Seitenverhältnisse — vom Streifen
     1:3 bis zum Quadrat. Sie in eine gemeinsame Kachelhöhe zu zwingen, hieße
     strecken oder beschneiden; beides zeigt etwas, das so nie gedruckt wird.
     Also feste Bühnenhöhe, Blatt zentriert, Rest bleibt Fläche. */
  .vorlage__blatt {
    background: var(--paper-tief);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px;
    min-height: 260px;
  }

  .vorlage__blatt img {
    max-width: 100%;
    max-height: 240px;
    width: auto;
    height: auto;
    border-radius: 3px;
    box-shadow: var(--schatten-hoch);
  }

  .chip__zahl {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 10px;
    opacity: 0.55;
    margin-left: 4px;
  }

  .platzhalterhinweis {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-still);
    max-width: 640px;
    margin: 0;
  }

  .vorlage__fuss {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .vorlage__name {
    font-weight: 700;
    font-size: 15px;
    color: var(--text);
  }

  .vorlage__fuss .mono {
    font-size: 9.5px;
    letter-spacing: 0.09em;
  }

  .marken {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 6px;
  }

  .marke {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 8px;
    border-radius: 5px;
    background: var(--paper-tief);
    color: var(--text-leise);
  }

  .marke--inklusive {
    background: var(--amber);
    color: var(--amber-ink);
  }

  @keyframes einfliegen {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vorlage {
      animation: none;
    }
  }

  /* Sammlungen */
  .raster--schmal {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .sammlung {
    background: var(--ink-soft);
    border: 1px solid color-mix(in srgb, var(--text-hell) 12%, transparent);
    border-radius: var(--r-karte);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .sammlung--wunsch {
    background: color-mix(in srgb, var(--amber) 10%, transparent);
    border-color: var(--amber);
  }

  .sammlung__titel {
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .sammlung__text {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--text-hell-leise);
  }

  .knopf--flach {
    height: 42px;
    font-size: 13px;
    border-radius: var(--r-pille);
  }
</style>

<script>
  const galerie = document.querySelector<HTMLElement>('.galerie');

  if (galerie) {
    const zustand = { anlass: 'alle', format: 'alle' };
    const gesamt = galerie.querySelectorAll('[data-vorlage]').length;

    function zeichne() {
      let treffer = 0;

      galerie!.querySelectorAll<HTMLElement>('[data-vorlage]').forEach((karte) => {
        const anlassPasst =
          zustand.anlass === 'alle' || karte.dataset.anlassWert === zustand.anlass;
        const formatPasst =
          zustand.format === 'alle' || karte.dataset.formatWert === zustand.format;
        const passt = anlassPasst && formatPasst;
        karte.hidden = !passt;
        if (passt) treffer++;
      });

      const leer = galerie!.querySelector<HTMLElement>('[data-feld="leer"]');
      if (leer) leer.hidden = treffer > 0;

      const trefferfeld = galerie!.querySelector<HTMLElement>('[data-feld="treffer"]');
      if (trefferfeld) {
        trefferfeld.textContent = `${treffer} von ${gesamt} Vorlagen`;
      }

      (['anlass', 'format'] as const).forEach((art) => {
        galerie!
          .querySelectorAll<HTMLButtonElement>(`[data-${art}]`)
          .forEach((b) => {
            const an = b.dataset[art] === zustand[art];
            b.classList.toggle('on', an);
            b.setAttribute('aria-pressed', String(an));
          });
      });
    }

    galerie.addEventListener('click', (e) => {
      const knopf = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!knopf) return;

      if (knopf.dataset.anlass) zustand.anlass = knopf.dataset.anlass;
      else if (knopf.dataset.format) zustand.format = knopf.dataset.format;
      else if (knopf.dataset.feld === 'zuruecksetzen') {
        zustand.anlass = 'alle';
        zustand.format = 'alle';
      } else return;

      zeichne();
    });

    zeichne();
  }
</script>
