---
import { vorlagenzahlen } from '../../daten/vorlagenzahlen';
import Marketing from '../../layouts/Marketing.astro';
import { vorlagen, anlaesseDerVorlagen, formatname, bibliothek } from '../../daten/vorlagen';

/**
 * Das Vorlagen-Prinzip: woraus ein Layout besteht und welche Grundformen
 * mitgeliefert werden. Die Beispiele sind CSS-Zeichnungen, keine Bilder.
 */

/* Beispiele aus dem Katalog, nicht nachgebaut: dieselben Bilddateien wie in
   der Galerie. Wer hier ein Blatt sieht und es auf der Box sucht, findet es
   unter demselben Namen. */
const einzelbilder = vorlagen.filter((v) => v.art === 'foto');

/* Sechs Streifen mit möglichst verschiedener Bilderzahl — eine Reihe, in der
   dreimal dasselbe Raster steht, zeigt nichts. */
const streifen = (() => {
  const gesehen = new Set<number>();
  const erste = vorlagen.filter((v) => {
    if (v.art !== 'streifen' || gesehen.has(v.aufnahmen)) return false;
    gesehen.add(v.aufnahmen);
    return true;
  });
  const rest = vorlagen.filter((v) => v.art === 'streifen' && !erste.includes(v));
  return [...erste, ...rest].slice(0, 6);
})();

const weitereStreifen = bibliothek.streifen - streifen.length;

const bausteine = [
  {
    titel: 'Bildfelder',
    text: 'Ein großes oder mehrere kleine, frei positionierbar, mit oder ohne Rand.',
  },
  {
    titel: 'Textfelder',
    text: 'Namen, Datum, Ort — Serif für Namen, Mono für Daten, das hält alles ruhig.',
  },
  {
    titel: 'Logo-Slot',
    text: 'Eure Marke oder die des Kunden, als Ecke, Banderole oder Seitenleiste.',
  },
  {
    titel: 'Druckregeln',
    text: 'Format, Doppelstreifen, Schnittlinie und Beschnitt gehören zur Vorlage, nicht zum Zufall.',
  },
];

/* Gezählt, nicht behauptet: Die Zeile unter dem Titel ist dieselbe Zahl, die
   die Galerie filtert. */
const sammlungen = [
  { text: `Einzelbild · ${bibliothek.einzelbild}` },
  { text: `Streifen · ${bibliothek.streifen}` },
  ...anlaesseDerVorlagen.map((a) => ({ text: `${a.name} · ${a.zahl}` })),
];
---

<Marketing
  titel="Vorlagen-Prinzip"
  beschreibung={`${vorlagenzahlen.gesamt} Druckvorlagen: fertig gesetzt mit Schriftmischung, Rändern, Datumszeile und Logo-Slot — Bildflächen sind markiert.`}
>
  <section class="hero">
    <div class="hero__text">
      <span class="mono mono--amber">{vorlagenzahlen.gesamt} Druckvorlagen</span>
      <h1>Einzelbild zuerst. Streifen, wenn's Streifen sein soll.</h1>
      <p class="fliess">
        Sieben ausgearbeitete Layouts fürs Einzelbild, dazu 48 für Streifenserien. Alle Vorlagen
        sind fertig gesetzt: Schriftmischung, Ränder, Datumszeile, Logo-Slot. Bildflächen sind
        markiert — dort landet die Aufnahme.
      </p>
      <div class="reihe knopfreihe">
        <a class="knopf knopf--amber knopf--mittel" href="/kontakt">Vorlagen testen</a>
        <a class="knopf knopf--rahmen-hell knopf--mittel" href="/oberflaechen/booth-editor">
          Zum Designer
        </a>
      </div>
      <div class="sammlungen">
        {sammlungen.map((s) => <span class="mono mono--hell">{s.text}</span>)}
      </div>
      <span class="mono mono--hell">
        5×15 Streifen · 10×15 · 15×10 · 10×10 · 13×18 · 6×9 Magnet · 5×18 Lesezeichen
      </span>
    </div>

    <div class="hero__blatt">
      <img
        src={einzelbilder[0].bild}
        width={einzelbilder[0].breite}
        height={einzelbilder[0].hoehe}
        alt={`Vorlage ${einzelbilder[0].name}, ${formatname(einzelbilder[0].format)}`}
        loading="eager"
        decoding="async"
      />
    </div>
  </section>

  <section class="abschnitt">
    <div class="abschnitt-kopf">
      <h2>Einzelbild — {einzelbilder.length} fertige Layouts</h2>
      <span class="mono mono--still">Bildfeld markiert · Text und Logo austauschbar</span>
    </div>
    <div class="blattraster">
      {
        einzelbilder.map((f) => (
          <figure class="vorschau">
            <div class="vorschau__blatt">
              <img
                src={f.bild}
                width={f.breite}
                height={f.hoehe}
                alt={`Vorlage ${f.name}, ${formatname(f.format)}`}
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>
              <span class="vorschau__name">{f.name}</span>
              <span class="mono">{formatname(f.format)}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="abschnitt abschnitt--dunkel">
    <div class="abschnitt-kopf">
      <h2>Streifen — der Klassiker</h2>
      <span class="mono mono--hell">
        {bibliothek.streifen} Layouts · Doppelstreifen mit Schnittlinie
      </span>
    </div>
    <div class="streifenraster">
      {
        streifen.map((s) => (
          <figure class="vorschau">
            <div class="vorschau__blatt vorschau__blatt--dunkel">
              <img
                src={s.bild}
                width={s.breite}
                height={s.hoehe}
                alt={`Vorlage ${s.name}, ${formatname(s.format)}`}
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>
              <span class="vorschau__name vorschau__name--hell">{s.name}</span>
              <span class="mono mono--hell">{s.aufnahmen} Aufnahmen</span>
            </figcaption>
          </figure>
        ))
      }
      <figure class="vorschau weitere">
        <span class="weitere__zahl">{weitereStreifen}</span>
        <span class="mono mono--hell">weitere Streifen</span>
        <span class="weitere__text">
          Zwei-, drei- und vierteilig, hell und dunkel, mit und ohne Rand — alle auf jeder Box.
        </span>
      </figure>
    </div>
  </section>

  <section class="abschnitt">
    <h2>Woraus jede Vorlage besteht</h2>
    <div class="raster raster--4">
      {
        bausteine.map((b) => (
          <article class="karte">
            <span class="display display--klein">{b.titel}</span>
            <span class="karte__text">{b.text}</span>
          </article>
        ))
      }
    </div>
  </section>

  <section class="abschnitt designer">
    <div class="designer__text">
      <h2>Jede Vorlage ist nur ein Anfang</h2>
      <p class="fliess">
        Im Druck-Designer verschiebt ihr Bildfelder, tauscht Schriften, legt Logo-Slots und
        Textfelder an. Der Bildschirm-Designer nutzt dasselbe Layout-Modell, damit Screen und Druck
        zusammenpassen. Gespeicherte Layouts gelten pro Event oder als Haus-Standard.
      </p>
      <div class="reihe knopfreihe">
        <a class="knopf knopf--dunkel knopf--mittel" href="/oberflaechen/booth-editor">
          Designer ansehen
        </a>
        <a class="knopf knopf--rahmen knopf--mittel" href="/oberflaechen/fotobox-system">
          Oberflächen im Detail
        </a>
      </div>
    </div>

    <div class="designerfeld">
      <span class="mono">Im Designer</span>
      <div class="werte">
        <span class="wert">
          <span>Format</span>
          <b>{formatname(einzelbilder[1].format)}</b>
        </span>
        <span class="wert"><span>Bildfelder</span><b>{einzelbilder[1].aufnahmen}</b></span>
        <span class="wert"><span>Papierformate</span><b>7</b></span>
        <span class="wert"><span>Logo-Slot</span><b>optional</b></span>
      </div>
      <div class="designerfeld__blatt">
        <img
          src={einzelbilder[1].bild}
          width={einzelbilder[1].breite}
          height={einzelbilder[1].hoehe}
          alt={`Vorlage ${einzelbilder[1].name} im Designer`}
          loading="lazy"
          decoding="async"
        />
      </div>
      <span class="mono">Als Haus-Standard speichern</span>
    </div>
  </section>

  <section class="abschnitt abschnitt--tief schluss">
    <div class="schluss__text">
      <span class="display">Eigenes Layout, das wir für euch aufbauen?</span>
      <span class="beiwort">
        Farben, Schrift und Logo schicken — das Blatt kommt in jedem der sieben Formate zurück,
        in zwei Werktagen, ohne Aufpreis.
      </span>
    </div>
    <div class="reihe knopfreihe">
      <a class="knopf knopf--amber knopf--mittel" href="/kontakt">Layout anfragen</a>
      <a class="knopf knopf--rahmen-hell knopf--mittel" href="/preise">Preise</a>
    </div>
  </section>
</Marketing>

<style>
  .hero {
    background: var(--ink);
    color: var(--text-hell);
    padding: 56px var(--rand) 60px;
    display: flex;
    gap: 44px;
    flex-wrap: wrap;
    align-items: center;
  }

  .hero__text {
    flex: 1 1 460px;
    min-width: min(440px, 100%);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hero h1 {
    font-size: clamp(30px, 3.6vw, 50px);
  }

  .hero .fliess {
    color: var(--text-hell-leise);
    max-width: 580px;
  }

  .hero__blatt {
    flex: 0 1 260px;
    min-width: 220px;
  }

  .knopfreihe {
    gap: 12px;
  }

  .sammlungen {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 6px;
  }

  .sammlungen .mono,
  .hero .mono--hell {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--text-hell) 45%, transparent);
  }

  /* Blattraster */
  .blattraster {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 24px;
  }

  .vorschau__blatt {
    background: var(--paper-tief);
    border-radius: var(--r-karte);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    min-height: 230px;
  }

  .vorschau__blatt--dunkel {
    background: color-mix(in srgb, var(--text-hell) 6%, transparent);
  }

  /* Sieben Papierformate, sieben Seitenverhältnisse. Auf eine gemeinsame
     Kachelhöhe gezwungen wäre jedes zweite Blatt gestreckt — und gestreckt
     druckt es nie. Also Höhe begrenzen, Breite folgen lassen. */
  .vorschau__blatt img {
    max-width: 100%;
    max-height: 210px;
    width: auto;
    height: auto;
    border-radius: 3px;
    box-shadow: var(--schatten-hoch);
  }

  .hero__blatt img,
  .designerfeld__blatt img {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    box-shadow: var(--schatten-hoch);
  }

  .vorschau {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .vorschau figcaption {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .vorschau__name {
    font-weight: 600;
    font-size: 14px;
    color: var(--text);
  }

  .vorschau__name--hell {
    color: var(--text-hell);
  }

  .streifenraster {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 24px;
  }

  .weitere {
    background: var(--ink-soft);
    border: 1px solid var(--linie-dunkel);
    border-radius: var(--r-karte);
    padding: 22px;
    justify-content: center;
    gap: 8px;
  }

  .weitere__zahl {
    font-weight: 800;
    font-size: 38px;
    letter-spacing: -0.025em;
    line-height: 1;
    color: var(--amber);
  }

  .weitere__text {
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-hell-leise);
  }

  /* Designer */
  .designer {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 44px;
    align-items: center;
  }

  .designer__text {
    flex: 1 1 420px;
    min-width: min(400px, 100%);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .designerfeld {
    flex: 1 1 340px;
    min-width: min(320px, 100%);
    background: var(--weiss);
    border: 1px solid var(--linie);
    border-radius: var(--r-karte-gross);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: var(--schatten-karte);
  }

  .werte {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .wert {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 13.5px;
    color: var(--text-leise);
  }

  .wert b {
    font-weight: 600;
    color: var(--text);
  }

  .designerfeld__blatt {
    border: 1px dashed var(--linie-stark);
    padding: 12px;
    border-radius: var(--r-chip);
  }

  .schluss {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    flex-wrap: wrap;
    padding-block: 52px;
  }

  .schluss__text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 640px;
  }

  .schluss .display {
    font-size: clamp(26px, 2.6vw, 32px);
    line-height: 1.05;
  }

  .beiwort {
    font-size: 15px;
    color: var(--text-hell-leise);
  }
</style>
